+#include <stdlib.h>
+#include <string.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "stringop.h"
+
+/**
+ * floating_snap_assist <program [args]>|none
+ *
+ * The program to run after a floating window snaps (see snap_notify in
+ * tree/snap.c); none, the default, runs nothing.
+ */
+struct cmd_results *cmd_floating_snap_assist(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "floating_snap_assist", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+
+	free(config->floating_snap_assist);
+	config->floating_snap_assist = NULL;
+	if (argc > 1 || strcmp(argv[0], "none") != 0) {
+		config->floating_snap_assist = join_args(argv, argc);
+	}
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
diff --git a/sway/commands/snap.c b/sway/commands/snap.c
new file mode 100644
index 0000000..302cb3c
--- /dev/null
+++ b/sway/commands/snap.c
@@ -0,0 +1,98 @@
+#include <string.h>
+#include "sway/commands.h"
+#include "sway/output.h"
+#include "sway/tree/container.h"
+#include "sway/tree/root.h"
+#include "sway/tree/snap.h"
+#include "sway/input/seat.h"
+
+#define SNAP_USAGE "Expected 'snap left|right|up|down|next-output|prev-output|" \
+	"restore|max|left-half|right-half|top-left|top-right|bottom-left|" \
+	"bottom-right|left-third|center-third|right-third|left-two-thirds|" \
+	"right-two-thirds'"
+
+// The enabled output STEP places after (1) or before (-1) OUTPUT, wrapping
+// around, in sway's own output order; OUTPUT itself when it is the only one
+static struct sway_output *output_step(struct sway_output *output, int step) {
+	int n = root->outputs->length;
+	int i = list_find(root->outputs, output);
+	if (i < 0 || n < 2) {
+		return output;
+	}
+	return root->outputs->items[((i + step) % n + n) % n];
+}
+
+/**
+ * snap left|right|up|down              step like Win+Arrow (see snap.c)
+ * snap next-output|prev-output         the same zone on the next screen
+ * snap restore                         back to the box from before
+ * snap max|left-half|right-half|top-left|top-right|bottom-left|
+ *      bottom-right|left-third|center-third|right-third|
+ *      left-two-thirds|right-two-thirds
+ *                                      straight to that zone
+ *
+ * Works on the focused floating window, like dragging it to an edge or
+ * corner does. Left and right were absolute halves before the arrow keys
+ * learned to step; the first press from an unsnapped window still is one.
+ */
+struct cmd_results *cmd_snap(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "snap", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct sway_container *con = config->handler_context.container;
+	if (!con || !con->view || !container_is_floating(con) ||
+			con->pending.fullscreen_mode) {
+		return cmd_results_new(CMD_FAILURE,
+			"Only a floating window can be snapped");
+	}
+	struct sway_workspace *ws = con->pending.workspace;
+	if (!ws) {
+		return cmd_results_new(CMD_FAILURE,
+			"Only a window on a workspace can be snapped");
+	}
+
+	const char *arg = argv[0];
+	if (strcmp(arg, "next-output") == 0 || strcmp(arg, "prev-output") == 0) {
+		struct sway_output *output = output_step(ws->output,
+			arg[0] == 'n' ? 1 : -1);
+		if (output && output != ws->output) {
+			snap_move_to_output(con, output);
+			// The window keeps the focus, so the next key press acts on
+			// it again, on its new screen
+			seat_set_focus_container(config->handler_context.seat, con);
+			enum snap_zone zone = snap_current_zone(con);
+			if (zone != SNAP_NONE) {
+				snap_notify(con, zone);
+			}
+		}
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+
+	enum snap_zone from = snap_current_zone(con);
+	enum snap_zone zone;
+	if (strcmp(arg, "restore") == 0) {
+		zone = SNAP_NONE;
+	} else if (strcmp(arg, "left") == 0 || strcmp(arg, "right") == 0 ||
+			strcmp(arg, "up") == 0 || strcmp(arg, "down") == 0) {
+		zone = snap_zone_step(from, arg);
+		if (zone == from) {
+			return cmd_results_new(CMD_SUCCESS, NULL);
+		}
+	} else {
+		zone = snap_zone_from_name(arg);
+		if (zone == SNAP_NONE) {
+			return cmd_results_new(CMD_INVALID, SNAP_USAGE);
+		}
+	}
+
+	if (zone == SNAP_NONE) {
+		if (snap_restore(con)) {
+			snap_notify(con, SNAP_NONE);
+		}
+	} else {
+		snap_container(con, ws, zone);
+		snap_notify(con, zone);
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
