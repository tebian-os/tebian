diff --git a/sway/input/seatop_move_floating.c b/sway/input/seatop_move_floating.c
index 37b7aad..1ea9fea 100644
--- a/sway/input/seatop_move_floating.c
+++ b/sway/input/seatop_move_floating.c
@@ -1,23 +1,87 @@
+#include <math.h>
 #include <wlr/types/wlr_cursor.h>
+#include "sway/config.h"
 #include "sway/desktop/transaction.h"
 #include "sway/input/cursor.h"
 #include "sway/input/seat.h"
+#include "sway/tree/snap.h"
+#include "sway/tree/view.h"
+
+// How far (px) a snapped window must be dragged before it lets go and
+// returns to its old size, so a click on its title bar doesn't unsnap it
+#define UNSNAP_THRESHOLD 20
 
 struct seatop_move_floating_event {
 	struct sway_container *con;
 	double dx, dy; // cursor offset in container
+	double ref_lx, ref_ly; // cursor position when the drag began
+	bool unsnap_pending; // snapped window, not yet dragged far enough
+	struct wlr_scene_rect *indicator_rect; // snap preview, NULL if disabled
+	struct wlr_scene_blur *indicator_blur; // frosted backdrop under it
+	enum snap_zone zone;
+	struct sway_workspace *zone_ws;
 };
 
+static void update_indicator(struct seatop_move_floating_event *e,
+		struct wlr_cursor *cursor) {
+	struct sway_workspace *ws = NULL;
+	enum snap_zone zone = snap_zone_at(cursor->x, cursor->y, &ws);
+	if (zone == e->zone && ws == e->zone_ws) {
+		return;
+	}
+	e->zone = zone;
+	e->zone_ws = ws;
+	if (zone == SNAP_NONE) {
+		wlr_scene_node_set_enabled(&e->indicator_rect->node, false);
+		wlr_scene_node_set_enabled(&e->indicator_blur->node, false);
+		return;
+	}
+	struct wlr_box box = snap_zone_box(ws, zone);
+	wlr_scene_node_set_position(&e->indicator_rect->node, box.x, box.y);
+	wlr_scene_rect_set_size(e->indicator_rect, box.width, box.height);
+	wlr_scene_node_set_position(&e->indicator_blur->node, box.x, box.y);
+	wlr_scene_blur_set_size(e->indicator_blur, box.width, box.height);
+	// Rounded like the window that will land there
+	int radius = e->con->corner_radius;
+	radius = radius < box.width / 2 ? radius : box.width / 2;
+	radius = radius < box.height / 2 ? radius : box.height / 2;
+	wlr_scene_rect_set_corner_radii(e->indicator_rect, corner_radii_all(radius));
+	wlr_scene_blur_set_corner_radii(e->indicator_blur, corner_radii_all(radius));
+	wlr_scene_node_set_enabled(&e->indicator_rect->node, true);
+	wlr_scene_node_set_enabled(&e->indicator_blur->node, true);
+}
+
+// Back to the size it had before it was snapped, keeping the cursor at the
+// same relative spot across the title bar so the window stays under it
+static void unsnap(struct seatop_move_floating_event *e,
+		struct wlr_cursor *cursor) {
+	struct sway_container *con = e->con;
+	double old_width = con->pending.width;
+	struct wlr_box box = {
+		.width = con->snap_restore.width,
+		.height = con->snap_restore.height,
+	};
+	e->dx = old_width > 0 ? e->dx * box.width / old_width : 0;
+	e->dy = fmin(e->dy, box.height / 2.0);
+	box.x = round(cursor->x - e->dx);
+	box.y = round(cursor->y - e->dy);
+	snap_forget(con);
+	snap_set_box(con, &box);
+}
+
 static void finalize_move(struct sway_seat *seat) {
 	struct seatop_move_floating_event *e = seat->seatop_data;
+	e->con->animation_state.seat_is_moving_float = false;
 
