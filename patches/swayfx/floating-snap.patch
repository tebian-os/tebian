new file mode 100644
index 0000000..225cee4
--- /dev/null
+++ b/sway/tree/snap.c
@@ -0,0 +1,411 @@
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/types/wlr_output_layout.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/output.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/root.h"
+#include "sway/tree/snap.h"
+#include "sway/tree/view.h"
+#include "log.h"
+
+// How close (px) the cursor must be to a screen edge to snap there
+#define SNAP_EDGE_RANGE 8
+// Corners: this fraction of the edge, measured from the corner, snaps to a
+// quarter instead of a half
+#define SNAP_CORNER_FRACTION 0.25
+
+static const struct {
+	const char *name;
+	enum snap_zone zone;
+} zone_names[] = {
+	{ "max", SNAP_MAXIMIZE },
+	{ "left-half", SNAP_LEFT },
+	{ "right-half", SNAP_RIGHT },
+	{ "top-left", SNAP_TOP_LEFT },
+	{ "top-right", SNAP_TOP_RIGHT },
+	{ "bottom-left", SNAP_BOTTOM_LEFT },
+	{ "bottom-right", SNAP_BOTTOM_RIGHT },
+	{ "left-third", SNAP_LEFT_THIRD },
+	{ "center-third", SNAP_CENTER_THIRD },
+	{ "right-third", SNAP_RIGHT_THIRD },
+	{ "left-two-thirds", SNAP_LEFT_TWO_THIRDS },
+	{ "right-two-thirds", SNAP_RIGHT_TWO_THIRDS },
+};
+
+enum snap_zone snap_zone_from_name(const char *name) {
+	for (size_t i = 0; i < sizeof(zone_names) / sizeof(zone_names[0]); i++) {
+		if (strcmp(name, zone_names[i].name) == 0) {
+			return zone_names[i].zone;
+		}
+	}
+	return SNAP_NONE;
+}
+
+const char *snap_zone_name(enum snap_zone zone) {
+	for (size_t i = 0; i < sizeof(zone_names) / sizeof(zone_names[0]); i++) {
+		if (zone_names[i].zone == zone) {
+			return zone_names[i].name;
+		}
+	}
+	return "none";
+}
+
+enum snap_zone snap_zone_at(double lx, double ly, struct sway_workspace **ws_out) {
+	struct wlr_output *wlr_output =
+		wlr_output_layout_output_at(root->output_layout, lx, ly);
+	struct sway_output *output =
+		wlr_output ? output_from_wlr_output(wlr_output) : NULL;
+	struct sway_workspace *ws =
+		output ? output_get_active_workspace(output) : NULL;
+	if (!ws) {
+		return SNAP_NONE;
+	}
+	*ws_out = ws;
+
+	// Against the usable area, so the cursor touching a bar at the top
+	// still counts as the top edge
+	double x = lx - output->lx - output->usable_area.x;
+	double y = ly - output->ly - output->usable_area.y;
+	double w = output->usable_area.width;
+	double h = output->usable_area.height;
+
+	bool left = x <= SNAP_EDGE_RANGE;
+	bool right = x >= w - SNAP_EDGE_RANGE;
+	bool top = y <= SNAP_EDGE_RANGE;
+	bool bottom = y >= h - SNAP_EDGE_RANGE;
+	bool near_top = y <= h * SNAP_CORNER_FRACTION;
+	bool near_bottom = y >= h * (1 - SNAP_CORNER_FRACTION);
+	bool near_left = x <= w * SNAP_CORNER_FRACTION;
+	bool near_right = x >= w * (1 - SNAP_CORNER_FRACTION);
+
+	if ((left && near_top) || (top && near_left)) {
+		return SNAP_TOP_LEFT;
+	} else if ((right && near_top) || (top && near_right)) {
+		return SNAP_TOP_RIGHT;
+	} else if ((left && near_bottom) || (bottom && near_left)) {
+		return SNAP_BOTTOM_LEFT;
+	} else if ((right && near_bottom) || (bottom && near_right)) {
+		return SNAP_BOTTOM_RIGHT;
+	} else if (left) {
+		return SNAP_LEFT;
+	} else if (right) {
+		return SNAP_RIGHT;
+	} else if (top) {
+		return SNAP_MAXIMIZE;
+	}
+	return SNAP_NONE;
+}
+
+// The workspace box already excludes bars and outer gaps; inner gaps
+// separate the halves, quarters and thirds. A third and the two thirds
+// beside it fill the workspace exactly, like two halves do.
+struct wlr_box snap_zone_box(struct sway_workspace *ws, enum snap_zone zone) {
+	int gap = ws->gaps_inner;
+	int half_w = (ws->width - gap) / 2;
+	int half_h = (ws->height - gap) / 2;
+	int right_x = ws->x + ws->width - half_w;
+	int bottom_y = ws->y + ws->height - half_h;
+	int third_w = (ws->width - 2 * gap) / 3;
+	int two_thirds_w = ws->width - third_w - gap;
+	switch (zone) {
+	case SNAP_LEFT:
+		return (struct wlr_box){ ws->x, ws->y, half_w, ws->height };
+	case SNAP_RIGHT:
+		return (struct wlr_box){ right_x, ws->y, half_w, ws->height };
+	case SNAP_TOP_LEFT:
+		return (struct wlr_box){ ws->x, ws->y, half_w, half_h };
+	case SNAP_TOP_RIGHT:
+		return (struct wlr_box){ right_x, ws->y, half_w, half_h };
+	case SNAP_BOTTOM_LEFT:
+		return (struct wlr_box){ ws->x, bottom_y, half_w, half_h };
+	case SNAP_BOTTOM_RIGHT:
+		return (struct wlr_box){ right_x, bottom_y, half_w, half_h };
+	case SNAP_LEFT_THIRD:
+		return (struct wlr_box){ ws->x, ws->y, third_w, ws->height };
+	case SNAP_CENTER_THIRD:
+		return (struct wlr_box){ ws->x + third_w + gap, ws->y,
+			ws->width - 2 * (third_w + gap), ws->height };
+	case SNAP_RIGHT_THIRD:
+		return (struct wlr_box){ ws->x + ws->width - third_w, ws->y,
+			third_w, ws->height };
+	case SNAP_LEFT_TWO_THIRDS:
+		return (struct wlr_box){ ws->x, ws->y, two_thirds_w, ws->height };
+	case SNAP_RIGHT_TWO_THIRDS:
+		return (struct wlr_box){ ws->x + third_w + gap, ws->y,
+			two_thirds_w, ws->height };
+	case SNAP_MAXIMIZE:
+	case SNAP_NONE:
+		break;
+	}
+	return (struct wlr_box){ ws->x, ws->y, ws->width, ws->height };
+}
+
+/**
+ * The arrow keys, Win+Arrow style. Left and right move a window one step
+ * toward that side: a half, a quarter in the same row, or the middle
+ * (restored) from the other side; pressed again on its own side, a window
+ * cycles half -> third -> two thirds -> half. Thirds step a column at a
+ * time. Up and down move within a side: half -> top or bottom quarter ->
+ * back to the half; up from anywhere else maximizes, down from maximized
+ * restores. Nothing is ever minimized (sway has no minimize), so down on a
+ * bottom quarter or an unsnapped window does nothing.
+ *
+ *   from           left             right             up         down
+ *   (unsnapped)    left-half        right-half        max        -
+ *   max            left-half        right-half        -          restore
+ *   left-half      left-third       restore           top-left   bottom-left
+ *   left-third     left-two-thirds  center-third      top-left   bottom-left
+ *   left-2/3       left-half        restore           top-left   bottom-left
+ *   center-third   left-third       right-third       max        restore
+ *   top-left       left-half        top-right         max        left-half
+ *   bottom-left    left-half        bottom-right      left-half  -
+ *   (the right-hand zones mirror the left-hand ones)
+ */
+enum snap_zone snap_zone_step(enum snap_zone from, const char *direction) {
+	bool left = strcmp(direction, "left") == 0;
+	bool right = strcmp(direction, "right") == 0;
+	bool up = strcmp(direction, "up") == 0;
+	switch (from) {
+	case SNAP_NONE:
+	case SNAP_MAXIMIZE:
+		return left ? SNAP_LEFT : right ? SNAP_RIGHT : up ? SNAP_MAXIMIZE :
+			from == SNAP_MAXIMIZE ? SNAP_NONE : from;
+	case SNAP_LEFT:
+		return left ? SNAP_LEFT_THIRD : right ? SNAP_NONE :
+			up ? SNAP_TOP_LEFT : SNAP_BOTTOM_LEFT;
+	case SNAP_RIGHT:
+		return right ? SNAP_RIGHT_THIRD : left ? SNAP_NONE :
+			up ? SNAP_TOP_RIGHT : SNAP_BOTTOM_RIGHT;
+	case SNAP_LEFT_THIRD:
+		return left ? SNAP_LEFT_TWO_THIRDS : right ? SNAP_CENTER_THIRD :
+			up ? SNAP_TOP_LEFT : SNAP_BOTTOM_LEFT;
+	case SNAP_RIGHT_THIRD:
+		return right ? SNAP_RIGHT_TWO_THIRDS : left ? SNAP_CENTER_THIRD :
+			up ? SNAP_TOP_RIGHT : SNAP_BOTTOM_RIGHT;
+	case SNAP_LEFT_TWO_THIRDS:
+		return left ? SNAP_LEFT : right ? SNAP_NONE :
+			up ? SNAP_TOP_LEFT : SNAP_BOTTOM_LEFT;
+	case SNAP_RIGHT_TWO_THIRDS:
+		return right ? SNAP_RIGHT : left ? SNAP_NONE :
+			up ? SNAP_TOP_RIGHT : SNAP_BOTTOM_RIGHT;
+	case SNAP_CENTER_THIRD:
+		return left ? SNAP_LEFT_THIRD : right ? SNAP_RIGHT_THIRD :
+			up ? SNAP_MAXIMIZE : SNAP_NONE;
+	case SNAP_TOP_LEFT:
+		return left ? SNAP_LEFT : right ? SNAP_TOP_RIGHT :
+			up ? SNAP_MAXIMIZE : SNAP_LEFT;
+	case SNAP_TOP_RIGHT:
+		return right ? SNAP_RIGHT : left ? SNAP_TOP_LEFT :
+			up ? SNAP_MAXIMIZE : SNAP_RIGHT;
+	case SNAP_BOTTOM_LEFT:
+		return left ? SNAP_LEFT : right ? SNAP_BOTTOM_RIGHT :
+			up ? SNAP_LEFT : SNAP_BOTTOM_LEFT;
+	case SNAP_BOTTOM_RIGHT:
+		return right ? SNAP_RIGHT : left ? SNAP_BOTTOM_LEFT :
+			up ? SNAP_RIGHT : SNAP_BOTTOM_RIGHT;
+	}
+	return from;
+}
+
+void snap_set_box(struct sway_container *con, struct wlr_box *box) {
+	size_t border_width = 0;
+	size_t top = 0;
+	if (con->pending.border != B_CSD && !con->pending.fullscreen_mode) {
+		border_width = con->pending.border_thickness *
+			(con->pending.border != B_NONE);
+		top = con->pending.border == B_NORMAL ?
+			container_titlebar_height() : border_width;
+	}
+	con->pending.content_x = box->x + border_width;
+	con->pending.content_y = box->y + top;
+	con->pending.content_width = box->width - border_width * 2;
+	con->pending.content_height = box->height - top - border_width;
+	container_set_geometry_from_content(con);
+	// Moves it to the workspace of the output it now sits on
+	container_floating_move_to(con, con->pending.x, con->pending.y);
+	arrange_container(con);
+}
+
+void snap_container(struct sway_container *con, struct sway_workspace *ws,
+		enum snap_zone zone) {
+	if (!snap_is_current(con)) {
+		con->snap_restore = (struct wlr_box){
+			.x = con->pending.x,
+			.y = con->pending.y,
+			.width = con->pending.width,
+			.height = con->pending.height,
+		};
+	}
+	struct wlr_box box = snap_zone_box(ws, zone);
+	snap_set_box(con, &box);
+	con->snapped = true;
+	con->snap_zone = zone;
+	con->snap_box = (struct wlr_box){
+		.x = con->pending.x,
+		.y = con->pending.y,
+		.width = con->pending.width,
+		.height = con->pending.height,
+	};
+	// Tells the app it's snapped, so it drops its shadows and rounded
+	// corners and fits the edges, as it does when tiled
+	if (con->view) {
+		view_set_tiled(con->view, true);
+	}
+}
+
+bool snap_is_current(struct sway_container *con) {
+	if (!con->snapped) {
+		return false;
+	}
+	struct wlr_box *box = &con->snap_box;
+	if (con->pending.x != box->x || con->pending.y != box->y ||
+			con->pending.width != box->width ||
+			con->pending.height != box->height) {
+		snap_forget(con);
+		return false;
+	}
+	return true;
+}
+
+enum snap_zone snap_current_zone(struct sway_container *con) {
+	return snap_is_current(con) ? con->snap_zone : SNAP_NONE;
+}
+
+bool snap_restore(struct sway_container *con) {
+	if (!snap_is_current(con)) {
+		return false;
+	}
+	struct wlr_box box = con->snap_restore;
+	snap_forget(con);
+	snap_set_box(con, &box);
+	return true;
+}
+
+// BOX, a box on FROM, at the same relative spot on TO: its centre keeps its
+// place in proportion, its size stays unless TO is too small for it
+static struct wlr_box box_to_workspace(struct wlr_box box,
+		struct sway_workspace *from, struct sway_workspace *to) {
+	double cx = from->width > 0 ?
+		(box.x + box.width / 2.0 - from->x) / from->width : 0.5;
+	double cy = from->height > 0 ?
+		(box.y + box.height / 2.0 - from->y) / from->height : 0.5;
+	box.width = box.width < to->width ? box.width : to->width;
+	box.height = box.height < to->height ? box.height : to->height;
+	box.x = round(to->x + cx * to->width - box.width / 2.0);
+	box.y = round(to->y + cy * to->height - box.height / 2.0);
+	if (box.x < to->x) {
+		box.x = to->x;
+	} else if (box.x + box.width > to->x + to->width) {
+		box.x = to->x + to->width - box.width;
+	}
+	if (box.y < to->y) {
+		box.y = to->y;
+	} else if (box.y + box.height > to->y + to->height) {
+		box.y = to->y + to->height - box.height;
+	}
+	return box;
+}
+
+void snap_move_to_output(struct sway_container *con, struct sway_output *output) {
+	struct sway_workspace *from = con->pending.workspace;
+	struct sway_workspace *to = output_get_active_workspace(output);
+	if (!from || !to || from == to) {
+		return;
+	}
+	enum snap_zone zone = snap_current_zone(con);
+	// Its box from before goes along, so restoring it there doesn't send
+	// it back to the other screen
+	con->snap_restore = box_to_workspace(con->snap_restore, from, to);
+	if (zone != SNAP_NONE) {
+		snap_container(con, to, zone);
+		return;
+	}
+	struct wlr_box box = box_to_workspace((struct wlr_box){
+		.x = con->pending.x,
+		.y = con->pending.y,
+		.width = con->pending.width,
+		.height = con->pending.height,
+	}, from, to);
+	snap_set_box(con, &box);
+}
+
+void snap_forget(struct sway_container *con) {
+	if (!con->snapped) {
+		return;
+	}
+	con->snapped = false;
+	if (con->view && container_is_floating(con)) {
+		view_set_tiled(con->view, false);
+	}
+}
+
+// The half beside a left or right half, if no other snapped window is in it
+static enum snap_zone free_other_half(struct sway_container *con,
+		enum snap_zone zone) {
+	struct sway_workspace *ws = con->pending.workspace;
+	enum snap_zone other = zone == SNAP_LEFT ? SNAP_RIGHT :
+		zone == SNAP_RIGHT ? SNAP_LEFT : SNAP_NONE;
+	if (other == SNAP_NONE) {
+		return SNAP_NONE;
+	}
+	struct wlr_box other_box = snap_zone_box(ws, other);
+	for (int i = 0; i < ws->floating->length; i++) {
+		struct sway_container *c = ws->floating->items[i];
+		struct wlr_box overlap;
+		if (c != con && snap_is_current(c) &&
+				wlr_box_intersection(&overlap, &c->snap_box, &other_box)) {
+			return SNAP_NONE;
+		}
+	}
+	return other;
+}
+
+/**
+ * floating_snap_assist names a program to run after a window snaps (by key
+ * or by drag) or is restored, so that something outside the compositor can
+ * offer to fill the rest of the screen. It runs as
+ *
+ *   <program> <con_id> <zone> [<free zone>]
+ *
+ * with the zone's name ("restore" when restored). The free zone is there
+ * only when the window went to a left or right half and no other snapped
+ * window is in the other half: that is the moment to offer the other
+ * windows. Without it, a picker the program left open is out of date and
+ * should close. Nothing runs when the window has no other floating window
+ * on its workspace, so a lone window costs nothing. The program snaps its
+ * pick with an absolute zone (left-half, right-half); that half is then
+ * taken, so the run that follows doesn't offer again.
+ */
+void snap_notify(struct sway_container *con, enum snap_zone zone) {
+	struct sway_workspace *ws = con->pending.workspace;
+	if (!config->floating_snap_assist || !con->view || !ws) {
+		return;
+	}
+	bool others = false;
+	for (int i = 0; i < ws->floating->length && !others; i++) {
+		struct sway_container *c = ws->floating->items[i];
+		others = c != con && c->view && !c->pending.fullscreen_mode;
+	}
+	if (!others) {
+		return;
+	}
+	enum snap_zone other = free_other_half(con, zone);
+	char *cmd = format_str("%s %zu %s%s%s", config->floating_snap_assist,
+		con->node.id, zone == SNAP_NONE ? "restore" : snap_zone_name(zone),
+		other == SNAP_NONE ? "" : " ",
+		other == SNAP_NONE ? "" : snap_zone_name(other));
+	if (!cmd) {
+		return;
+	}
+	char *argv[] = { "--no-startup-id", cmd };
+	struct cmd_results *res = cmd_exec_process(2, argv);
+	if (res && res->status != CMD_SUCCESS) {
+		sway_log(SWAY_ERROR, "floating_snap_assist: %s", res->error);
+	}
+	free_cmd_results(res);
+	free(cmd);
+}
