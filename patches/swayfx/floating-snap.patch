+	// With a grab margin, the stretch of border near a corner counts as the
+	// corner, so diagonal resizing isn't a hunt for a 2x2 px target
+	if (edge && config->floating_grab_margin > 0 && container_is_floating(cont)) {
+		edge |= corner_edges(cont, cursor->cursor->x, cursor->cursor->y, edge);
+	}
+
 	return edge;
 }
 
+/**
+ * Floating windows get an invisible band of floating_grab_margin px around
+ * them that starts a resize, like other desktops: their visible border is
+ * only border_thickness px, and corners only that squared.
+ *
+ * Returns the floating window whose band the cursor is in, and the edges to
+ * resize in EDGE, or NULL. NODE and SURFACE are what's under the cursor; the
+ * band only takes the click from the desktop, a tiled window or a floating
+ * window lower in the stack, never from anything on top of it (bars, popups,
+ * menus) or from a fullscreen view.
+ */
+static struct sway_container *floating_grab_margin_at(struct sway_seat *seat,
+		struct sway_node *node, struct wlr_surface *surface,
+		enum wlr_edges *edge) {
+	int margin = config->floating_grab_margin;
+	if (margin <= 0) {
+		return NULL;
+	}
+	double x = seat->cursor->cursor->x;
+	double y = seat->cursor->cursor->y;
+
+	// What's under the cursor: only a workspace, or a window's own main
+	// surface or decorations (not its popups or subsurfaces)
+	struct sway_container *under = NULL;
+	if (!node) {
+		return NULL;
+	} else if (node->type == N_CONTAINER) {
+		under = node->sway_container;
+		if (surface && (!under->view || surface != under->view->surface)) {
+			return NULL;
+		}
+	} else if (node->type != N_WORKSPACE) {
+		return NULL;
+	}
+
+	struct wlr_output *wlr_output =
+		wlr_output_layout_output_at(root->output_layout, x, y);
+	struct sway_output *output =
+		wlr_output ? output_from_wlr_output(wlr_output) : NULL;
+	struct sway_workspace *ws =
+		output ? output_get_active_workspace(output) : NULL;
+	if (!ws || ws->fullscreen || root->fullscreen_global) {
+		return NULL;
+	}
+
+	struct sway_container *under_floater = under && container_is_floating_or_child(under) ?
+		container_toplevel_ancestor(under) : NULL;
+	int under_index = under_floater ?
+		list_find(ws->floating, under_floater) : -1;
+
+	// Top of the stack first
+	for (int i = ws->floating->length - 1; i > under_index; i--) {
+		struct sway_container *con = ws->floating->items[i];
+		if (!con->view || con->pending.fullscreen_mode ||
+				con->pending.border == B_CSD) {
+			continue;
+		}
+		double cx = con->pending.x, cy = con->pending.y;
+		double cw = con->pending.width, ch = con->pending.height;
+		if (x < cx - margin || x >= cx + cw + margin ||
+				y < cy - margin || y >= cy + ch + margin) {
+			continue;
+		}
+		if (x >= cx && x < cx + cw && y >= cy && y < cy + ch) {
+			// On the window itself, which covers anything lower in the
+			// stack: its own border handling applies, not the band
+			return NULL;
+		}
+		enum wlr_edges e = WLR_EDGE_NONE;
+		if (x < cx) {
+			e |= WLR_EDGE_LEFT;
+		} else if (x >= cx + cw) {
+			e |= WLR_EDGE_RIGHT;
+		}
+		if (y < cy) {
+			e |= WLR_EDGE_TOP;
+		} else if (y >= cy + ch) {
+			e |= WLR_EDGE_BOTTOM;
+		}
+		*edge = e | corner_edges(con, x, y, e);
+		return con;
+	}
+	return NULL;
+}
