diff --git a/sway/commands/snap.c b/sway/commands/snap.c
new file mode 100644
index 0000000..566c11b
--- /dev/null
+++ b/sway/commands/snap.c
@@ -0,0 +1,40 @@
+#include <string.h>
+#include "sway/commands.h"
+#include "sway/tree/container.h"
+#include "sway/tree/snap.h"
+
+/**
+ * snap left|right|max|top-left|top-right|bottom-left|bottom-right|restore
+ *
+ * Snaps the focused floating window like dragging it to that edge or
+ * corner does; restore gives a snapped window back its box from before.
+ */
+struct cmd_results *cmd_snap(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "snap", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct sway_container *con = config->handler_context.container;
+	if (!con || !con->view || !container_is_floating(con) ||
+			con->pending.fullscreen_mode) {
+		return cmd_results_new(CMD_FAILURE,
+			"Only a floating window can be snapped");
+	}
+
+	if (strcmp(argv[0], "restore") == 0) {
+		if (snap_is_current(con)) {
+			struct wlr_box box = con->snap_restore;
+			snap_forget(con);
+			snap_set_box(con, &box);
+		}
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+
+	enum snap_zone zone = snap_zone_from_name(argv[0]);
+	if (zone == SNAP_NONE) {
+		return cmd_results_new(CMD_INVALID, "Expected 'snap left|right|max|"
+			"top-left|top-right|bottom-left|bottom-right|restore'");
+	}
+	snap_container(con, con->pending.workspace, zone);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
