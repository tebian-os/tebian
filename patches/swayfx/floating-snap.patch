diff --git a/sway/commands/floating_grab_margin.c b/sway/commands/floating_grab_margin.c
new file mode 100644
index 0000000..e91bcd1
--- /dev/null
+++ b/sway/commands/floating_grab_margin.c
@@ -0,0 +1,20 @@
+#include <stdlib.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+
+struct cmd_results *cmd_floating_grab_margin(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "floating_grab_margin", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+
+	char *end;
+	long margin = strtol(argv[0], &end, 10);
+	if (*end || margin < 0 || margin > 64) {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'floating_grab_margin <px>' with px from 0 to 64");
+	}
+	config->floating_grab_margin = margin;
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
