diff --git a/include/sway/tree/snap.h b/include/sway/tree/snap.h
new file mode 100644
index 0000000..ce92656
--- /dev/null
+++ b/include/sway/tree/snap.h
@@ -0,0 +1,81 @@
+#ifndef _SWAY_SNAP_H
+#define _SWAY_SNAP_H
+#include <stdbool.h>
+#include <wlr/util/box.h>
+#include "sway/output.h"
+#include "sway/tree/container.h"
+#include "sway/tree/workspace.h"
+
+/**
+ * Windows-style snapping for floating windows: a half, a quarter, a third,
+ * two thirds or the whole workspace, chosen by dragging to a screen edge or
+ * corner (seatop_move_floating.c) or with the `snap` command. A snapped
+ * window remembers its box from before, and gets it back when dragged away
+ * or snapped to "restore".
+ */
+enum snap_zone {
+	SNAP_NONE,
+	SNAP_MAXIMIZE,
+	SNAP_LEFT,
+	SNAP_RIGHT,
+	SNAP_TOP_LEFT,
+	SNAP_TOP_RIGHT,
+	SNAP_BOTTOM_LEFT,
+	SNAP_BOTTOM_RIGHT,
+	SNAP_LEFT_THIRD,
+	SNAP_CENTER_THIRD,
+	SNAP_RIGHT_THIRD,
+	SNAP_LEFT_TWO_THIRDS,
+	SNAP_RIGHT_TWO_THIRDS,
+};
+
+// The zone named NAME (left-half, right-half, max, top-left, top-right,
+// bottom-left, bottom-right, left-third, center-third, right-third,
+// left-two-thirds, right-two-thirds), or SNAP_NONE
+enum snap_zone snap_zone_from_name(const char *name);
+
+// The name snap_zone_from_name takes for ZONE ("none" for SNAP_NONE)
+const char *snap_zone_name(enum snap_zone zone);
+
+// The zone the cursor at LX,LY is in, judged against the usable area (screen
+// minus layer-shell bars) of the output under it; WS gets that output's
+// workspace
+enum snap_zone snap_zone_at(double lx, double ly, struct sway_workspace **ws);
+
+// The outer box (layout coordinates, borders included) of ZONE on WS
+struct wlr_box snap_zone_box(struct sway_workspace *ws, enum snap_zone zone);
+
+// Where `snap left|right|up|down` takes a window that is in zone FROM
+// (SNAP_NONE: not snapped). SNAP_NONE means restore it; FROM itself means
+// leave it. The table is in snap.c.
+enum snap_zone snap_zone_step(enum snap_zone from, const char *direction);
+
+// Give floating CON the outer box BOX
+void snap_set_box(struct sway_container *con, struct wlr_box *box);
+
+// Snap floating CON to ZONE on WS
+void snap_container(struct sway_container *con, struct sway_workspace *ws,
+		enum snap_zone zone);
+
+// Whether CON is snapped and still exactly where it was snapped to; a window
+// resized or moved by other means since counts as no longer snapped
+bool snap_is_current(struct sway_container *con);
+
+// The zone CON is snapped to, or SNAP_NONE
+enum snap_zone snap_current_zone(struct sway_container *con);
+
+// Give a snapped CON back its box from before; false if it wasn't snapped
+bool snap_restore(struct sway_container *con);
+
+// Move floating CON to OUTPUT's workspace, snapped to the same zone there,
+// or at the same relative spot if it isn't snapped
+void snap_move_to_output(struct sway_container *con, struct sway_output *output);
+
+// Forget that CON was snapped (it keeps its current box)
+void snap_forget(struct sway_container *con);
+
+// Tell the floating_snap_assist program that CON was snapped to ZONE (or
+// restored: SNAP_NONE). See snap.c for when it runs and what it is told.
+void snap_notify(struct sway_container *con, enum snap_zone zone);
+
+#endif
