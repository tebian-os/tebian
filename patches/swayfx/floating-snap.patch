diff --git a/sway/input/seatop_default.c b/sway/input/seatop_default.c
index df8232a..593ef38 100644
--- a/sway/input/seatop_default.c
+++ b/sway/input/seatop_default.c
@@ -1,6 +1,7 @@
 #include <float.h>
 #include <libevdev/libevdev.h>
 #include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_output_layout.h>
 #include <wlr/types/wlr_subcompositor.h>
 #include <wlr/types/wlr_tablet_v2.h>
 #include <wlr/types/wlr_xcursor_manager.h>
@@ -74,6 +75,34 @@ static bool edge_is_external(struct sway_container *cont, enum wlr_edges edge) {
 	return true;
 }
 
+// How far (px) along an edge from a corner still counts as the corner
+#define GRAB_CORNER_RANGE 16
+
+// The perpendicular edge to add when the cursor, on edge EDGE of CON, is
+// within GRAB_CORNER_RANGE of a corner
+static enum wlr_edges corner_edges(struct sway_container *con,
+		double x, double y, enum wlr_edges edge) {
+	enum wlr_edges extra = WLR_EDGE_NONE;
+	double range = GRAB_CORNER_RANGE;
+	if ((edge & (WLR_EDGE_LEFT | WLR_EDGE_RIGHT)) &&
+			!(edge & (WLR_EDGE_TOP | WLR_EDGE_BOTTOM))) {
+		if (y < con->pending.y + range) {
+			extra |= WLR_EDGE_TOP;
+		} else if (y >= con->pending.y + con->pending.height - range) {
+			extra |= WLR_EDGE_BOTTOM;
+		}
+	}
+	if ((edge & (WLR_EDGE_TOP | WLR_EDGE_BOTTOM)) &&
+			!(edge & (WLR_EDGE_LEFT | WLR_EDGE_RIGHT))) {
+		if (x < con->pending.x + range) {
+			extra |= WLR_EDGE_LEFT;
+		} else if (x >= con->pending.x + con->pending.width - range) {
+			extra |= WLR_EDGE_RIGHT;
+		}
+	}
+	return extra;
+}
+
 static enum wlr_edges find_edge(struct sway_container *cont,
 		struct wlr_surface *surface, struct sway_cursor *cursor) {
 	if (!cont->view || (surface && cont->view->surface != surface)) {
@@ -101,9 +130,100 @@ static enum wlr_edges find_edge(struct sway_container *cont,
 		edge |= WLR_EDGE_BOTTOM;
 	}
 
+	// With a grab margin, the stretch of border near a corner counts as the
+	// corner, so diagonal resizing isn't a hunt for a 2x2 px target
+	if (edge && config->floating_grab_margin > 0 && container_is_floating(cont)) {
+		edge |= corner_edges(cont, cursor->cursor->x, cursor->cursor->y, edge);
+	}
+
 	return edge;
 }
 
+/**
+ * Floating windows get an invisible band of floating_grab_margin px around
+ * them that starts a resize, like other desktops: their visible border is
+ * only border_thickness px, and corners only that squared.
+ *
+ * Returns the floating window whose band the cursor is in, and the edges to
+ * resize in EDGE, or NULL. NODE and SURFACE are what's under the cursor; the
+ * band only takes the click from the desktop, a tiled window or a floating
+ * window lower in the stack, never from anything on top of it (bars, popups,
+ * menus) or from a fullscreen view.
+ */
+static struct sway_container *floating_grab_margin_at(struct sway_seat *seat,
+		struct sway_node *node, struct wlr_surface *surface,
+		enum wlr_edges *edge) {
+	int margin = config->floating_grab_margin;
+	if (margin <= 0) {
+		return NULL;
+	}
+	double x = seat->cursor->cursor->x;
+	double y = seat->cursor->cursor->y;
+
+	// What's under the cursor: only a workspace, or a window's own main
+	// surface or decorations (not its popups or subsurfaces)
+	struct sway_container *under = NULL;
+	if (!node) {
+		return NULL;
+	} else if (node->type == N_CONTAINER) {
+		under = node->sway_container;
