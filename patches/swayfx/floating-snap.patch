+// How far (px) along an edge from a corner still counts as the corner
+#define GRAB_CORNER_RANGE 16
+
+// The perpendicular edge to add when the cursor, on edge EDGE of CON, is
+// within GRAB_CORNER_RANGE of a corner
+static enum wlr_edges corner_edges(struct sway_container *con,
+		double x, double y, enum wlr_edges edge) {
+	enum wlr_edges extra = WLR_EDGE_NONE;
+	double range = GRAB_CORNER_RANGE;
+	if ((edge & (WLR_EDGE_LEFT | WLR_EDGE_RIGHT)) &&
+			!(edge & (WLR_EDGE_TOP | WLR_EDGE_BOTTOM))) {
+		if (y < con->pending.y + range) {
+			extra |= WLR_EDGE_TOP;
+		} else if (y >= con->pending.y + con->pending.height - range) {
+			extra |= WLR_EDGE_BOTTOM;
+		}
+	}
+	if ((edge & (WLR_EDGE_TOP | WLR_EDGE_BOTTOM)) &&
+			!(edge & (WLR_EDGE_LEFT | WLR_EDGE_RIGHT))) {
+		if (x < con->pending.x + range) {
+			extra |= WLR_EDGE_LEFT;
+		} else if (x >= con->pending.x + con->pending.width - range) {
+			extra |= WLR_EDGE_RIGHT;
+		}
+	}
+	return extra;
+}
