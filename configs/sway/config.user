# Power button opens Tebian power menu
bindsym XF86PowerOff exec tebian-settings --power

# Workspace manager (Mod+W)
bindsym $mod+w exec tebian-workspace

# ==============================================================================
# USER CUSTOMIZATIONS - Add your own below
# ==============================================================================

# --- Example: Custom Keybindings ---
# bindsym $mod+b exec firefox
# bindsym $mod+Shift+s exec ~/.local/bin/screenshot.sh

# --- Example: Window Rules ---
# for_window [app_id="pavucontrol"] floating enable
# for_window [title="File Transfer*"] floating enable
# for_window [app_id="zenity"] floating enable

# --- Example: Startup Apps ---
# exec discord
# exec thunderbird
# exec nextcloud

# --- Example: Workspace Names ---
# set $ws1 "1: Term"
# set $ws2 "2: Web"
# set $ws3 "3: Code"
# bindsym $mod+1 workspace $ws1
# bindsym $mod+2 workspace $ws2
# bindsym $mod+3 workspace $ws3

# --- Example: Assign Apps to Workspaces ---
# assign [app_id="firefox"] $ws2
# assign [app_id="code"] $ws3

# --- Example: External Monitor Setup ---
# output HDMI-A-1 pos 1920 0 res 1920x1080
# output HDMI-A-1 scale 1.25

# --- Example: Change Wallpaper ---
# exec swaybg -i ~/Pictures/my-wallpaper.jpg -m fill

# Workspace navigation. Mod+Alt rather than bare Ctrl+Left/Right: plain
# Ctrl+arrows is word-jump in every terminal, editor and text field.
workspace_auto_back_and_forth yes
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Alt+Left workspace prev
bindsym $mod+Alt+Right workspace next
bindsym $mod+l exec gtklock -d

# Lines between "# tebian:NAME {" and "# tebian:NAME }" are managed by
# Settings (Mod+S) and rewritten when you change the matching option — put
# your own lines outside these blocks.
# tebian:floating-mode {
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
bindsym $mod+Ctrl+Left snap left
bindsym $mod+Ctrl+Right snap right
bindsym $mod+Ctrl+Up snap max
bindsym $mod+Ctrl+Down snap restore
# tebian:floating-mode }
# tebian:titlebars {
default_border normal 2
default_floating_border normal 2
# tebian:titlebars }
