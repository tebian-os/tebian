#!/bin/bash
# ==============================================================================
# TEBIAN COMMON LIBRARY (V2.0)
# Shared functions for error handling, logging, and utilities
# ==============================================================================

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Logging
log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }
log_debug() { [ "${TEBIAN_DEBUG:-0}" != "1" ] || echo -e "${BLUE}[DEBUG]${NC} $1"; }

# Error handling
tebian_error() {
    local exit_code=$?
    log_error "Script failed at line $1 (exit code: $exit_code)"
    if [ "${TEBIAN_DEBUG:-0}" = "1" ] && [ -f "${BASH_SOURCE[1]:-}" ]; then
        log_error "Command: $(sed -n "${1}p" "${BASH_SOURCE[1]}")"
    fi
    exit $exit_code
}

# Error handling (Optional - Call explicitly)
trap_error() {
    set -e
    trap 'tebian_error $LINENO' ERR
}

# Check if running in Wayland
is_wayland() {
    [ -n "$WAYLAND_DISPLAY" ]
}

# Check if running in X11
is_x11() {
    [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]
}

# Check if command exists
has_cmd() {
    command -v "$1" &> /dev/null
}

# Require command or exit
require_cmd() {
    if ! has_cmd "$1"; then
        log_error "Required command not found: $1"
        log_info "Install with: sudo apt install $2"
        exit 1
    fi
}

# Require root/sudo
require_root() {
    if [ "$EUID" -ne 0 ]; then
        log_error "This command requires root. Run with sudo."
        exit 1
    fi
}

# Check Tebian installation
check_tebian() {
    local tebian_dir="${TEBIAN_DIR:-$HOME/Tebian}"
    if [ ! -d "$tebian_dir" ]; then
        log_error "Tebian not found at $tebian_dir"
        log_info "Set TEBIAN_DIR environment variable if installed elsewhere"
        exit 1
    fi
    export TEBIAN_DIR="$tebian_dir"
}

# Confirm action
confirm() {
    local prompt="${1:-Continue?}"
    local default="${2:-n}"
    
    if [ "$default" = "y" ]; then
        read -p "$prompt [Y/n] " choice
        [[ -z "$choice" || "$choice" =~ ^[Yy] ]]
    else
        read -p "$prompt [y/N] " choice
        [[ "$choice" =~ ^[Yy] ]]
    fi
}

# Escape closes the menus; the Back entry goes up one level.
# An empty answer from tfuzzel means Escape (or Enter on an empty prompt):
# tfuzzel never returns a separator line. What Escape does depends on where
# it is pressed, and each call site says which:
#
#   A menu (a list of settings or of other menus, with a Back entry):
#       [ -n "$CHOICE" ] || menu_close      # Escape: close every menu
#       is_back "$CHOICE" && return         # Back: one level up
#
#   A step inside an operation (typed text, a yes/no, a second picker that
#   needs what the first one chose, an action on one picked item):
#       [ -n "$X" ] || return               # Escape: cancel this step only
#   Closing there would drop the operation halfway; the user lands back on
#   the menu it started from.
#
# Back matches icon mode ("󰌍 Back...") and Text Mode, where tfuzzel strips
# the glyph so the entry comes back as "Back...". "Back " prefix (not bare
# "Back*") so labels like "Backup Configs" don't match.
is_back() {
    local c="$1"
    [[ "$c" == *"󰌍 Back"* || "$c" == "Back" || "$c" == "Back "* ]]
}

# Escape in a menu: leave the script, which takes its EXIT trap (Settings'
# lock) with it. exit inside $(...) or a pipe would only end that subshell
# and leave the caller carrying on with an empty answer; menus run in the
# main shell, but if one ever doesn't, the main shell is asked to stop too.
menu_close() {
    [ "$BASHPID" = "$$" ] || kill -TERM "$$" 2>/dev/null
    exit 0
}

# Add an apt repo whose key must match a pinned fingerprint. A repo key is
# root-level trust in whoever holds it, so the download is held to a fingerprint
# the publisher documents, not believed because it arrived over HTTPS. If a
# publisher rotates its key this fails closed; update the pin after checking
# their announcement. Needs gpg and curl. Args: key-url fingerprint keyring
# list-file deb-line. A keyring named .asc stays armored, as its publisher's
# docs show; anything else is dearmored.
tebian_apt_repo_add() {
    local key_url="$1" expected="$2" keyring="$3" list="$4" deb_line="$5" work rc=0
    work=$(mktemp -d) || return 1
    # Every step checks itself: bash ignores set -e inside "( ... ) || x"
    (
        umask 022
        echo "Fetching the signing key..."
        curl --proto '=https' --proto-redir '=https' --tlsv1.2 -fsSL "$key_url" -o "$work/key.asc" || exit 1
        mkdir -m 700 "$work/gnupg" || exit 1
        colons=$(gpg --homedir "$work/gnupg" --batch --show-keys --with-colons --with-fingerprint "$work/key.asc" 2>/dev/null) || exit 1
        # Exactly one primary key: a second one in the file would be trusted by
        # apt as well, even though the first matched the fingerprint
        primaries=$(grep -c '^pub:' <<< "$colons" || true)
        fpr=$(awk -F: '$1 == "pub" { p = 1; next } p && $1 == "fpr" { print $10; exit }' <<< "$colons")
        if [ "$primaries" != 1 ] || [ "$fpr" != "$expected" ]; then
            log_error "The signing key does not match the expected fingerprint."
            log_error "  expected $expected"
            log_error "  got      ${fpr:-none} ($primaries primary keys)"
            log_error "Nothing was added to your system. This is worth checking before retrying."
            exit 1
        fi
        echo "  Key verified: $fpr"
        if [[ "$keyring" == *.asc ]]; then
            cp "$work/key.asc" "$work/keyring" || exit 1
        else
            gpg --homedir "$work/gnupg" --batch --yes --dearmor -o "$work/keyring" "$work/key.asc" || exit 1
        fi
        echo "$deb_line" > "$work/repo.list" || exit 1
        sudo install -d -m 755 "$(dirname "$keyring")" || exit 1
        sudo install -m 644 -o root -g root "$work/keyring" "$keyring" || exit 1
        sudo install -m 644 -o root -g root "$work/repo.list" "$list" || exit 1
    ) || rc=$?
    rm -rf "$work"
    return "$rc"
}

# The pinned apps (Mod+D, the dock): one desktop-id per line. The defaults
# are written the first time anything asks, whichever comes first: Mod+D,
# the drawer, the dock or an installer pinning its app. A menu that made an
# empty file instead would leave the user with no pins at all.
TEBIAN_PIN_FILE="$HOME/.config/tebian/pinned-apps.conf"
tebian_pins_init() {
    [ -f "$TEBIAN_PIN_FILE" ] && return 0
    mkdir -p "${TEBIAN_PIN_FILE%/*}"
    cat > "$TEBIAN_PIN_FILE" << 'EOF'
helium.desktop
app.zen_browser.zen.desktop
t3code.desktop
hermes.desktop
firefox-esr.desktop
firefox.desktop
chromium.desktop
org.mozilla.firefox.desktop
kitty.desktop
thunar.desktop
code.desktop
EOF
}

# Add an app to the pins; anything installed after the defaults were written
# has to add itself or stays off the menu
tebian_pin_app() {
    local desktop="$1" pins="$TEBIAN_PIN_FILE"
    tebian_pins_init || return 1
    grep -qxF "$desktop" "$pins" && return 0
    # An unterminated last line would otherwise merge with ours
    [ -z "$(tail -c1 "$pins")" ] || echo >> "$pins"
    echo "$desktop" >> "$pins"
}

# ==============================================================================
# APP INDEX
# One reader of .desktop files for every menu (Mod+D, the drawer, Settings).
#   tebian_apps_list        id<TAB>name<TAB>icon<TAB>terminal, sorted by name
#   tebian_app_name ID      the Name, or return 1 if ID isn't launchable
#   tebian_app_launch ID    start it through sway; return 1 if unknown
# ID is the file name ("kitty.desktop"). Names are not unique (Firefox from
# Debian and from Flatpak), so menus show names but launch by ID.
# ==============================================================================

# Application dirs, most important first: the first file with a given ID
# hides the rest, which is how a user copy with NoDisplay=true hides an app.
# Flatpak's export dirs are listed explicitly too, because sway (and so
# Mod+D) is often started without them in XDG_DATA_DIRS.
_tebian_app_dirs() {
    local d seen=:
    local IFS=:
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}" "$HOME/.local/share/flatpak/exports/share" \
             ${XDG_DATA_DIRS:-/usr/local/share:/usr/share} /var/lib/flatpak/exports/share; do
        [ -n "$d" ] || continue
        [[ "$seen" == *":$d:"* ]] && continue
        seen+="$d:"
        [ -d "$d/applications" ] && printf '%s\n' "$d/applications"
    done
}

# One awk pass over all the files, given in precedence order. Prints
# id name icon terminal tryexec exec path, separated by \037, for each
# application meant to be shown in this session. \037 rather than a tab:
# `read` collapses runs of tabs (tab is IFS whitespace), so an empty icon
# would shift every later field.
# Only [Desktop Entry] counts: "Name=" under [Desktop Action new-window] is
# an action's label, and Name[de]= is a translation. Values are unescaped
# per the spec (\s \n \t \r \\), so a shell-quoted Exec reaches sh as its
# author wrote it.
_TEBIAN_AWK_DESKTOP='
function unesc(v,   out, i, c, n) {
    if (index(v, "\\") == 0) return v
    out = ""; n = length(v)
    for (i = 1; i <= n; i++) {
        c = substr(v, i, 1)
        if (c == "\\" && i < n) {
            c = substr(v, ++i, 1)
            if (c == "s" || c == "n" || c == "t") c = " "
            else if (c == "r") c = ""
        }
        out = out c
    }
    return out
}
function clean(v) { gsub(/[\t\037]/, " ", v); return v }
function listed(v,   n, a, i) {
    n = split(v, a, ";")
    for (i = 1; i <= n; i++) if (a[i] != "" && tolower(a[i]) in desk) return 1
    return 0
}
function flush() {
    if (path == "" || skip) return
    if (type != "" && type != "Application") return
    if (name == "" || exec == "") return
    if (tolower(nodisplay) == "true" || tolower(hidden) == "true") return
    if (onlyshow != "" && !listed(onlyshow)) return
    if (notshow != "" && listed(notshow)) return
    print id S clean(name) S clean(icon) S (tolower(terminal) == "true" ? 1 : 0) \
        S clean(tryexec) S clean(exec) S path
}
BEGIN {
    S = "\037"
    n = split(tolower(ENVIRON["TEBIAN_DESKTOPS"]), d, ":")
    for (i = 1; i <= n; i++) if (d[i] != "") desk[d[i]] = 1
}
FNR == 1 {
    flush()
    path = FILENAME; id = FILENAME; sub(/.*\//, "", id)
    # The first file with an ID decides, launchable or not
    skip = (id in seen) || id ~ /[\t\037]/
    seen[id] = 1
    split("", got)
    group = type = name = icon = exec = tryexec = terminal = ""
    nodisplay = hidden = onlyshow = notshow = ""
}
skip { next }
# Translations (Name[de]=...) are most of a system file; drop them first
/^[A-Za-z0-9-]+\[/ { next }
{ sub(/[ \t\r]+$/, "") }
/^[ \t]*(#|$)/ { next }
/^\[/ {
    # Desktop Entry is the first group; what follows is actions
    if (group == "[Desktop Entry]") nextfile
    group = $0; next
}
group != "[Desktop Entry]" { next }
{
    eq = index($0, "="); if (!eq) next
    key = substr($0, 1, eq - 1); sub(/[ \t]+$/, "", key)
    val = substr($0, eq + 1); sub(/^[ \t]+/, "", val)
    # A key given twice is invalid; the first is what other launchers use
    if (key in got) next
    got[key] = 1
    if (key == "Type") type = val
    else if (key == "Name") name = unesc(val)
    else if (key == "Icon") icon = unesc(val)
    else if (key == "Exec") exec = unesc(val)
    else if (key == "TryExec") tryexec = unesc(val)
    else if (key == "Terminal") terminal = val
    else if (key == "NoDisplay") nodisplay = val
    else if (key == "Hidden") hidden = val
    else if (key == "OnlyShowIn") onlyshow = val
    else if (key == "NotShowIn") notshow = val
}
END { flush() }'

# Run the awk pass over FILES and drop entries whose TryExec isn't there.
# TryExec is checked here, by bash's own PATH lookup, rather than a
# `command -v` fork per file from awk. MODE "list" prints the four public
# fields with tabs; "full" prints the whole \037 record.
_tebian_app_scan() {
    local mode="$1"; shift
    [ $# -gt 0 ] || return 0
    local id name icon term tryexec exec path
    # OnlyShowIn/NotShowIn compare against this session's desktop names
    TEBIAN_DESKTOPS="${XDG_CURRENT_DESKTOP:-sway}" awk "$_TEBIAN_AWK_DESKTOP" "$@" |
    while IFS=$'\037' read -r id name icon term tryexec exec path; do
        [ -z "$tryexec" ] || command -v "$tryexec" >/dev/null 2>&1 || continue
        if [ "$mode" = list ]; then
            printf '%s\t%s\t%s\t%s\n' "$id" "$name" "$icon" "$term"
        else
            printf '%s\037%s\037%s\037%s\037%s\037%s\n' "$id" "$name" "$icon" "$term" "$exec" "$path"
        fi
    done
}

# Readers: icon can be empty, so split lines with parameter expansion or
# awk -F'\t', not `IFS=$'\t' read`, which merges the two tabs around it.
tebian_apps_list() {
    local d f
    local -a files=()
    while IFS= read -r d; do
        for f in "$d"/*.desktop; do
            [ -f "$f" ] && files+=("$f")
        done
    done < <(_tebian_app_dirs)
    _tebian_app_scan list "${files[@]}" | sort -t $'\t' -k2,2f -k1,1
}

# tebian_apps_list with the name column replaced by a menu label: the name,
# plus the ID where two apps share a name, so the two Firefoxes (Debian's
# and Flatpak's) can be told apart in a list
tebian_apps_labeled() {
    tebian_apps_list | awk -F'\t' -v OFS='\t' '
        { id[NR] = $1; nm[NR] = $2; ic[NR] = $3; tm[NR] = $4; n[$2]++ }
        END {
            for (i = 1; i <= NR; i++) {
                l = nm[i]
                if (n[l] > 1) { x = id[i]; sub(/\.desktop$/, "", x); l = l "  (" x ")" }
                print id[i], l, ic[i], tm[i]
            }
        }'
}

# The full \037 record for one ID (id name icon terminal exec path), or
# return 1. Only the first file with that ID is looked at, as in the list.
_tebian_app_entry() {
    local id="$1" d out
    [[ "$id" == ?*.desktop && "$id" != */* ]] || return 1
    while IFS= read -r d; do
        [ -f "$d/$id" ] || continue
        out=$(_tebian_app_scan full "$d/$id")
        [ -n "$out" ] || return 1
        printf '%s\n' "$out"
        return 0
    done < <(_tebian_app_dirs)
    return 1
}

tebian_app_name() {
    local rec
    rec=$(_tebian_app_entry "$1") || return 1
    rec="${rec#*$'\037'}"
    printf '%s\n' "${rec%%$'\037'*}"
}

# The user's terminal as a prefix that runs the command after it
# ("kitty -e"): the one picked in Settings > Software (config.user's
# "terminal" block), then the base config's $term, then the first one
# installed.
tebian_term_cmd() {
    local t c
    t=$(tebian_block_get terminal 2>/dev/null | awk '$1 == "set" && $2 == "$term" { print $3; exit }')
    command -v "$t" >/dev/null 2>&1 ||
        t=$(awk '/^set \$term[[:space:]]/ { print $3; exit }' "$HOME/.config/sway/config" 2>/dev/null)
    if ! command -v "$t" >/dev/null 2>&1; then
        t=kitty
        for c in kitty foot alacritty gnome-terminal xterm; do
            command -v "$c" >/dev/null 2>&1 && { t="$c"; break; }
        done
    fi
    case "$t" in
        gnome-terminal|kgx|ptyxis) echo "$t --" ;;
        wezterm)                   echo "wezterm start --" ;;
        *)                         echo "$t -e" ;;
    esac
}

# Quote a string for sh
_tebian_sq() {
    printf "'%s'" "${1//\'/\'\\\'\'}"
}

# Exec with its field codes resolved. A menu opens an app with no file or
# URL, so %f %F %u %U (and the deprecated ones) go; a code quoted on its own
# ("%f") goes with its quotes, or the app gets an empty argument and some
# then try to open a file named "".
_tebian_exec_expand() {
    local rest="$1" name="$2" icon="$3" file="$4" out="" c
    rest="${rest//\"%[fFuUdDnNvm]\"/}"
    while [[ "$rest" == *%* ]]; do
        out+="${rest%%\%*}"
        rest="${rest#*%}"
        c="${rest:0:1}"
        rest="${rest:1}"
        case "$c" in
            %) out+="%" ;;
            c) out+=$(_tebian_sq "$name") ;;
            k) out+=$(_tebian_sq "$file") ;;
            i) [ -z "$icon" ] || out+="--icon $(_tebian_sq "$icon")" ;;
        esac
    done
    printf '%s\n' "$out$rest"
}

# Started by sway, not by the menu: the app is not the menu's child, and
# sway knows which workspace it was launched from. The command reaches sway
# in a file, not inline, because sway parses a command before running it:
# an Exec containing ";" or "," was split into separate sway commands, and
# sway's quote handling differs from sh's. "sh FILE" gives it nothing to
# parse.
tebian_app_launch() {
    local rec id name icon term exec path cmd launch
    rec=$(_tebian_app_entry "$1") || return 1
    IFS=$'\037' read -r id name icon term exec path <<< "$rec"
    cmd=$(_tebian_exec_expand "$exec" "$name" "$icon" "$path")
    [ "$term" = 1 ] && cmd="$(tebian_term_cmd) $cmd"

    if [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
        launch=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/tebian-launch.XXXXXX") || return 1
        # It deletes itself first; exec leaves the app as sway's own child
        # shellcheck disable=SC2016
        printf 'rm -f -- "$0"\nexec %s\n' "$cmd" > "$launch"
        swaymsg exec -- "sh $launch" >/dev/null 2>&1 && return 0
        rm -f "$launch"
    fi
    # No sway to ask (a TTY, sway gone): detach so it outlives the caller
    setsid -f sh -c "exec $cmd" >/dev/null 2>&1 < /dev/null
}

# Fuzzel Wrapper (Handles Icon Toggling + Separator Filtering)
tfuzzel() {
    local RESULT
    # Opened from the Modern bar: drop down from it instead of the screen
    # centre (tebian-bar-menu sets the edge). Inherited by every submenu.
    # A drop-down is also sized to its items: themes fix fuzzel at 15
    # lines, which left short menus as a tall box hanging off the bar.
    local -a anchor=()
    # The menu is kept in a file so it can be shown again; a file, not a
    # variable: entries with their own icon carry a NUL ("name\0icon\x1fkitty"),
    # which bash variables drop — fuzzel then printed the icon spec as text.
    # In the user's own runtime dir it is named by PID: one fork fewer on
    # every menu. A name anyone can guess is not safe in a shared /tmp.
    local buf n
    local -a src
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
        buf="$XDG_RUNTIME_DIR/tfuzzel.$BASHPID"
    else
        buf=$(mktemp) || return 1
    fi
    if [ -n "${TEBIAN_MENU_ANCHOR:-}" ]; then
        cat > "$buf" || return 1
        n=$(grep -ac . "$buf")
        [ "$n" -gt 15 ] && n=15
        [ "$n" -lt 1 ] && n=1
        anchor=(--anchor "$TEBIAN_MENU_ANCHOR" --x-margin 8 --y-margin 6 --lines "$n")
        src=(cat "$buf")
    else
        # Copied on the way through, so fuzzel starts drawing at once
        src=(tee "$buf")
    fi
    while true; do
        if [ -f "$HOME/.config/tebian/no_icons" ]; then
            # Text Mode: Strip Nerd Fonts (PUA: E000-F8FF, F0000-FFFFD) and Emoji (1F300-1FAFF)
            RESULT=$("${src[@]}" | perl -CS -pe 's/[\x{E000}-\x{F8FF}\x{F0000}-\x{FFFFD}\x{1F300}-\x{1FAFF}]//g; s/^\s+//' | fuzzel "${anchor[@]}" "$@")
        else
            # Icon Mode (Default): Pass through
            RESULT=$("${src[@]}" | fuzzel "${anchor[@]}" "$@")
        fi
        # A separator or heading line ("─────", "── Desktop Apps") isn't a
        # choice: show the menu again rather than return nothing, which
        # callers read as Escape
        [[ "$RESULT" == ─* ]] || break
        src=(cat "$buf")
    done
    rm -f "$buf"
    echo "$RESULT"
}

# ==============================================================================
# HARDWARE DETECTION
# Sets: GPU_TYPE, CPU_TYPE, IS_LAPTOP, IS_HIDPI, HAS_NVIDIA, HAS_AMD_GPU, HAS_INTEL_GPU
# ==============================================================================
detect_hardware() {
    local quiet="${1:-false}"
    _hw_msg() { [ "$quiet" = "true" ] || echo "  $1"; }

    # GPU
    HAS_NVIDIA=$(lspci 2>/dev/null | grep -i nvidia | head -1)
    HAS_AMD_GPU=$(lspci 2>/dev/null | grep -i "AMD.*VGA\|AMD.*3D\|AMD.*Display" | head -1)
    HAS_INTEL_GPU=$(lspci 2>/dev/null | grep -i "Intel.*VGA\|Intel.*Display" | head -1)

    if [ -n "$HAS_NVIDIA" ]; then
        GPU_TYPE="NVIDIA"
        _hw_msg "GPU: NVIDIA detected"
    elif [ -n "$HAS_AMD_GPU" ]; then
        GPU_TYPE="AMD"
        _hw_msg "GPU: AMD detected"
    elif [ -n "$HAS_INTEL_GPU" ]; then
        GPU_TYPE="Intel"
        _hw_msg "GPU: Intel detected"
    else
        GPU_TYPE="Unknown"
        _hw_msg "GPU: Unknown/VM"
    fi

    # CPU (with lscpu fallback)
    CPU_VENDOR=$(grep -m1 "vendor_id" /proc/cpuinfo 2>/dev/null | awk '{print $3}')
    if [ -z "$CPU_VENDOR" ]; then
        CPU_VENDOR=$(lscpu 2>/dev/null | grep "Vendor ID" | awk '{print $3}')
    fi

    if [[ "$CPU_VENDOR" == "GenuineIntel" ]]; then
        CPU_TYPE="Intel"
        _hw_msg "CPU: Intel detected"
    elif [[ "$CPU_VENDOR" == "AuthenticAMD" ]]; then
        CPU_TYPE="AMD"
        _hw_msg "CPU: AMD detected"
    else
        CPU_TYPE="Unknown"
        _hw_msg "CPU: Unknown"
    fi

    # Laptop (battery check)
    HAS_BATTERY=$(ls /sys/class/power_supply/ 2>/dev/null | grep -i bat | head -1)
    if [ -n "$HAS_BATTERY" ]; then
        IS_LAPTOP=true
        _hw_msg "Device: Laptop (battery detected)"
    else
        IS_LAPTOP=false
        _hw_msg "Device: Desktop (no battery)"
    fi

    # HiDPI (Wayland-native via swaymsg)
    local detect_res
    detect_res=$(swaymsg -t get_outputs 2>/dev/null | grep -oP '"width":\s*\K[0-9]+' | head -1)
    if [[ -n "$detect_res" && "$detect_res" -ge 3000 ]] 2>/dev/null; then
        IS_HIDPI=true
        _hw_msg "Display: HiDPI detected (${detect_res} width)"
    else
        IS_HIDPI=false
        _hw_msg "Display: Standard resolution"
    fi
    return 0
}

# ==============================================================================
# SETTINGS BLOCKS IN config.user
# Settings-owned sway lines live between two marker comments:
#
#   # tebian:floating-mode {
#   for_window [app_id=".*"] floating enable
#   # tebian:floating-mode }
#
# Markers get their own lines because sway has no end-of-line comments: a
# trailing "# tebian-x" is handed to the command as extra arguments. That
# is how the old one-line markers broke — `gaps inner 4 # tebian-feel-gaps`
# failed to parse and `floating enable # tebian-floating-mode` was rejected
# ("expected 1 argument, got 3"). tebian_user_migrate converts those.
# ==============================================================================

TEBIAN_SWAY_USER="$HOME/.config/sway/config.user"

# Replace a file's contents with stdin. Rewrites in place rather than
# mv-ing a temp file over it, so a symlinked config (dotfile managers)
# stays a symlink.
_tebian_rewrite() {
    local file="$1" tmp
    tmp=$(mktemp) || return 1
    cat > "$tmp" && cat "$tmp" > "$file"
    rm -f "$tmp"
}

# Legacy marker names that belong to one block
_tebian_block_key() {
    case "$1" in
        titlebars|titlebars-on) echo titlebars ;;
        feel-gaps)              echo gaps ;;
        *)                      echo "$1" ;;
    esac
}

# True if block KEY exists
tebian_block_has() {
    grep -qxF "# tebian:$1 {" "${2:-$TEBIAN_SWAY_USER}" 2>/dev/null
}

# Print the lines inside block KEY
tebian_block_get() {
    local file="${2:-$TEBIAN_SWAY_USER}"
    [ -f "$file" ] || return 0
    K="$1" awk '
        $0 == "# tebian:" ENVIRON["K"] " {" { inb=1; next }
        $0 == "# tebian:" ENVIRON["K"] " }" { inb=0; next }
        inb' "$file"
}

# Remove block KEY
tebian_block_remove() {
    local file="${2:-$TEBIAN_SWAY_USER}"
    [ -f "$file" ] || return 0
    K="$1" awk '
        $0 == "# tebian:" ENVIRON["K"] " {" { inb=1; next }
        $0 == "# tebian:" ENVIRON["K"] " }" { inb=0; next }
        !inb' "$file" | _tebian_rewrite "$file"
}

# Replace block KEY with the given lines (none = remove). Written to the end
# of the file, where it overrides the base config and earlier user lines.
tebian_block_set() {
    tebian_block_set_in "$TEBIAN_SWAY_USER" "$@"
}

tebian_block_set_in() {
    local file="$1" key="$2" line; shift 2
    mkdir -p "$(dirname "$file")"; touch "$file"
    tebian_block_remove "$key" "$file"
    [ $# -gt 0 ] || return 0
    {
        echo "# tebian:$key {"
        for line in "$@"; do echo "$line"; done
        echo "# tebian:$key }"
    } >> "$file"
}

# Add one line to block KEY unless it's already there
tebian_block_add_line() {
    local key="$1" line="$2" file="${3:-$TEBIAN_SWAY_USER}"
    mkdir -p "$(dirname "$file")"; touch "$file"
    if tebian_block_has "$key" "$file"; then
        tebian_block_get "$key" "$file" | grep -qxF -- "$line" && return 0
        K="$key" L="$line" awk '
            $0 == "# tebian:" ENVIRON["K"] " }" { print ENVIRON["L"] }
            { print }' "$file" | _tebian_rewrite "$file"
    else
        printf '# tebian:%s {\n%s\n# tebian:%s }\n' "$key" "$line" "$key" >> "$file"
    fi
}

# Title bars on. default_border alone misses every app that draws its own
# window frame (GTK dialogs, Chromium-family browsers): sway leaves those
# to the app, so on a fresh Desktop install they had no title bar until the
# switch was turned off and on, which applies "border normal" to the open
# windows. The for_window rules do that for each window as it opens.
TEBIAN_TITLEBAR_LINES=(
    'default_border normal 2'
    'default_floating_border normal 2'
    'for_window [app_id=".*"] border normal 2'
    'for_window [class=".*"] border normal 2'
)

# Convert old one-line markers ("cmd # tebian-name") into blocks. Idempotent
# and cheap: runs at every login (tebian-session) and when Settings opens.
tebian_user_migrate() {
    local file="${1:-$TEBIAN_SWAY_USER}" key line
    [ -f "$file" ] || return 0

    # Title bars turned on before the for_window rules existed: add them,
    # so apps with their own frame get a title bar too (see above)
    if tebian_block_has titlebars "$file" &&
       ! tebian_block_get titlebars "$file" | grep -q '^for_window '; then
        tebian_block_set_in "$file" titlebars "${TEBIAN_TITLEBAR_LINES[@]}"
    fi

    # Older templates bound bare Ctrl+Left/Right to workspace switching,
    # which steals word-jump from every text field. Only the exact shipped
    # lines are rewritten — a user's own Ctrl bindings are left alone.
    if grep -qxE 'bindsym Ctrl\+(Left workspace prev|Right workspace next)' "$file"; then
        sed -e 's/^bindsym Ctrl+Left workspace prev$/bindsym $mod+Alt+Left workspace prev/' \
            -e 's/^bindsym Ctrl+Right workspace next$/bindsym $mod+Alt+Right workspace next/' \
            "$file" | _tebian_rewrite "$file"
    fi

    # Floating mode's keyboard snaps: the first ones positioned from the
    # output's corner ("move absolute position 0 0") and covered the bar,
    # the next ones ran tebian-edge-snap. Both become sway's own snap
    # command (Tebian's sway build), which fits the workspace's usable area.
    # The resize-set lines only as shipped (custom ones are left alone); any
    # tebian-edge-snap binding, since that script is gone and sway's snap
    # takes the same zone names.
    if grep -qE '^bindsym .+ (resize set|exec tebian-edge-snap snap )' "$file"; then
        sed -E \
            -e 's/^bindsym \$mod\+Ctrl\+Left resize set 50 ppt 100 ppt; move absolute position 0 0( # tebian-floating-mode)?$/bindsym $mod+Ctrl+Left snap left\1/' \
            -e 's/^bindsym \$mod\+Ctrl\+Right resize set 50 ppt 100 ppt; move absolute position 50 ppt 0( # tebian-floating-mode)?$/bindsym $mod+Ctrl+Right snap right\1/' \
            -e 's/^bindsym \$mod\+Ctrl\+Up resize set 100 ppt 100 ppt; move absolute position 0 0( # tebian-floating-mode)?$/bindsym $mod+Ctrl+Up snap max\1/' \
            -e 's/^bindsym \$mod\+Ctrl\+Down resize set 60 ppt 60 ppt; move position center( # tebian-floating-mode)?$/bindsym $mod+Ctrl+Down snap restore\1/' \
            -e 's/^(bindsym .+) exec tebian-edge-snap snap (left|right|max|top-left|top-right|bottom-left|bottom-right|restore)( # tebian-[a-z-]+)?$/\1 snap \2\3/' \
            "$file" | _tebian_rewrite "$file"
    fi

    # tebian-edge-snap, the old drag-snapping watcher, is gone: sway snaps
    # by itself now. Drop its block, and its one-line form below.
    if tebian_block_has edge-snap "$file"; then
        tebian_block_remove edge-snap "$file"
        pkill -f "^[^ ]*python3 [^ ]*tebian-edge-snap" 2>/dev/null
    fi

    # "Snapping off" is a line only Tebian's sway understands; under any
    # other sway (SwayFX not yet rebuilt, Debian's own after an update) it
    # would be a config error at every login, so it waits until it's valid
    if tebian_block_has snap-off "$file" && ! tebian_snap_supported; then
        tebian_block_remove snap-off "$file"
    fi

    # The same for Snap Assist's line, and the floating-mode keys follow
    # what this sway can do (see FLOATING MODE AND WINDOW SNAPPING below)
    tebian_snap_assist_sync "$file"
    tebian_snap_keys_sync "$file"

    grep -qE '[^[:space:]#].*[[:space:]]# tebian-[a-z0-9-]+[[:space:]]*$' "$file" || return 0

    local moved
    moved=$(awk '
        /^[[:space:]]*#/ { next }
        match($0, /[[:space:]]+# tebian-[a-z0-9-]+[[:space:]]*$/) {
            tag = substr($0, RSTART); sub(/^[[:space:]]+# tebian-/, "", tag); sub(/[[:space:]]+$/, "", tag)
            print tag "\t" substr($0, 1, RSTART - 1)
        }' "$file")
    awk '
        /^[[:space:]]*#/ { print; next }
        /[[:space:]]+# tebian-[a-z0-9-]+[[:space:]]*$/ { next }
        { print }' "$file" | _tebian_rewrite "$file"

    while IFS=$'\t' read -r key line; do
        [ -n "$line" ] || continue
        key=$(_tebian_block_key "$key")
        # One value per SwayFX option: a reinstall re-appends all of them
        if [ "$key" = swayfx ] && tebian_block_has swayfx "$file"; then
            local directive="${line%% *}" kept
            kept=$(tebian_block_get swayfx "$file" | awk -v d="$directive" '$1 != d')
            # shellcheck disable=SC2086
            mapfile -t _kept <<< "$kept"
            [ -n "$kept" ] || _kept=()
            tebian_block_set_in "$file" swayfx "${_kept[@]}" "$line"
            continue
        fi
        # The old drag-snapping watcher (see above)
        if [[ "$line" == exec_always*tebian-edge-snap* ]]; then
            pkill -f "^[^ ]*python3 [^ ]*tebian-edge-snap" 2>/dev/null
            continue
        fi
        tebian_block_add_line "$(_tebian_block_key "$key")" "$line" "$file"
    done <<< "$moved"
}

# ==============================================================================
# FLOATING MODE AND WINDOW SNAPPING
# Floating mode writes window rules and keyboard snaps to config.user.
# Snapping itself is in Tebian's sway build (tebian-build-sway, or the
# patched SwayFX): drag a floating window to an edge or corner and it shows
# where it will land. It's on by default there, so the config never needs a
# line that an unpatched sway would reject.
# ==============================================================================

# True if the sway that `sway` starts has Tebian's snapping — or, given a
# config line, if it accepts that line (newer builds add options: rev 2 has
# floating_snap_assist, rev 1 rejects it). Asks sway to check a one-line
# config rather than guessing from version numbers, so it holds for
# Debian's sway, Tebian's build and SwayFX alike. A check takes sway a
# quarter of a second and runs at every login and Settings start, so the
# answer is kept until the binary changes (an update, a rebuild, SwayFX).
tebian_snap_supported() {
    local line="${1:-floating_snap enable}" bin id cache probe rc
    bin=$(command -v sway) || return 1
    bin=$(readlink -f "$bin")
    id="$bin:$(stat -c '%i:%s:%Y' "$bin" 2>/dev/null)"
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/tebian/sway-accepts"
    if [ -f "$cache" ]; then
        rc=$(ID="$id" L="$line" awk -F'\t' '$1 == ENVIRON["ID"] && $2 == ENVIRON["L"] { print $3; exit }' "$cache")
        [ -n "$rc" ] && return "$rc"
    fi
    probe=$(mktemp) || return 1
    echo "$line" > "$probe"
    # sway 1.10 starts its backend before it checks the config; at login
    # (no compositor yet) that would take over the screen and seat for a
    # moment, or wait 10 s for a seat it can't get. A headless backend
    # needs neither.
    WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 sway -C -c "$probe" >/dev/null 2>&1
    rc=$?
    rm -f "$probe"
    [ "$rc" -eq 0 ] || rc=1
    # Answers for other binaries are dropped: only the current one matters
    mkdir -p "$(dirname "$cache")" 2>/dev/null &&
        { ID="$id" awk -F'\t' '$1 == ENVIRON["ID"]' "$cache" 2>/dev/null
          printf '%s\t%s\t%s\n' "$id" "$line" "$rc"; } > "$cache.$$" &&
        mv -f "$cache.$$" "$cache"
    return "$rc"
}

# Snap Assist: after a window snaps to a left or right half, sway runs
# tebian-snap, which offers the workspace's other floating windows for the
# other half (floating_snap_assist, rev 2 of Tebian's sway). On unless
# turned off; the off switch is a file, not the block, because the block
# must also go whenever the running sway can't read it (Debian's own sway
# after an update, SwayFX not yet rebuilt) and the choice has to outlive
# that.
TEBIAN_SNAP_ASSIST_LINE='floating_snap_assist ~/.local/bin/tebian-snap assist'
TEBIAN_SNAP_ASSIST_OFF="$HOME/.config/tebian/snap-assist-off"

tebian_snap_assist_enabled() {
    [ ! -f "$TEBIAN_SNAP_ASSIST_OFF" ]
}

# Write or drop the snap-assist block to match the switch and what this
# sway understands. Runs from tebian_user_migrate, i.e. before sway reads
# config.user at login, so an older sway never sees the line.
tebian_snap_assist_sync() {
    local file="${1:-$TEBIAN_SWAY_USER}"
    if tebian_snap_assist_enabled && tebian_snap_supported 'floating_snap_assist none'; then
        tebian_block_get snap-assist "$file" 2>/dev/null | grep -qxF -- "$TEBIAN_SNAP_ASSIST_LINE" ||
            tebian_block_set_in "$file" snap-assist "$TEBIAN_SNAP_ASSIST_LINE"
    elif tebian_block_has snap-assist "$file"; then
        tebian_block_remove snap-assist "$file"
    fi
}

# tebian_snap_assist_set on|off — the Settings switch; applies at once in
# the running sway too (a sway without it just says no)
tebian_snap_assist_set() {
    if [ "$1" = on ]; then
        rm -f "$TEBIAN_SNAP_ASSIST_OFF"
    else
        mkdir -p "$(dirname "$TEBIAN_SNAP_ASSIST_OFF")"
        touch "$TEBIAN_SNAP_ASSIST_OFF"
    fi
    tebian_snap_assist_sync
    if [ "$1" = on ]; then
        swaymsg "${TEBIAN_SNAP_ASSIST_LINE}" >/dev/null 2>&1
    else
        swaymsg floating_snap_assist none >/dev/null 2>&1
    fi
    return 0
}

setup_floating_mode() {
    # Click to focus while windows overlap: with focus-follows-mouse, just
    # moving the pointer across a window focuses it, and sway raises a
    # focused floating window — so windows kept jumping in front of each
    # other. The block is appended after the user's own setting, so it wins
    # here and their choice returns when the block goes (tiling mode).
    local -a keys
    mapfile -t keys < <(tebian_snap_keys)
    tebian_block_set floating-mode \
        'focus_follows_mouse no' \
        'for_window [app_id=".*"] floating enable' \
        'for_window [class=".*"] floating enable' \
        "${keys[@]}"
}

# Floating mode's keyboard snaps. Any sway loads a binding whatever its
# command says (it's checked when the key is pressed), so none of these can
# stop sway from starting; a sway that doesn't know a command just does
# nothing for that key. Up and Down differ: rev 2 of Tebian's sway steps
# with them (half -> quarter, unsnapped -> max -> restored, see
# patches/sway/floating-snap.patch), rev 1 and older SwayFX builds know
# only "max" and "restore" — so those two follow the sway that runs.
TEBIAN_SNAP_KEYS_REV1=(
    'bindsym $mod+Ctrl+Left snap left'
    'bindsym $mod+Ctrl+Right snap right'
    'bindsym $mod+Ctrl+Up snap max'
    'bindsym $mod+Ctrl+Down snap restore'
)
TEBIAN_SNAP_KEYS_REV2=(
    'bindsym $mod+Ctrl+Left snap left'
    'bindsym $mod+Ctrl+Right snap right'
    'bindsym $mod+Ctrl+Up snap up'
    'bindsym $mod+Ctrl+Down snap down'
    'bindsym $mod+Ctrl+Return snap max'
    'bindsym $mod+Ctrl+BackSpace snap restore'
    'bindsym $mod+Ctrl+Home snap top-left'
    'bindsym $mod+Ctrl+Prior snap top-right'
    'bindsym $mod+Ctrl+End snap bottom-left'
    'bindsym $mod+Ctrl+Next snap bottom-right'
    'bindsym $mod+Ctrl+1 snap left-third'
    'bindsym $mod+Ctrl+2 snap center-third'
    'bindsym $mod+Ctrl+3 snap right-third'
    'bindsym $mod+Ctrl+Shift+1 snap left-two-thirds'
    'bindsym $mod+Ctrl+Shift+3 snap right-two-thirds'
    'bindsym $mod+Ctrl+Shift+Left snap prev-output'
    'bindsym $mod+Ctrl+Shift+Right snap next-output'
)

# Rev 2 of Tebian's sway: stepping arrows, thirds, other screens, Snap Assist
tebian_snap_rev2() {
    tebian_snap_supported 'floating_snap_assist none'
}

# The keyboard snap lines for the sway that runs
tebian_snap_keys() {
    if tebian_snap_rev2; then
        printf '%s\n' "${TEBIAN_SNAP_KEYS_REV2[@]}"
    else
        printf '%s\n' "${TEBIAN_SNAP_KEYS_REV1[@]}"
    fi
}

# Bring an existing floating-mode block's keys in line with the sway that
# runs (it can change under the block: a rebuild, SwayFX, a Debian update).
# Only the lines Tebian ships are touched. Going back to rev 1 just turns
# Up/Down back into max/restore; the other rev 2 keys stay, doing nothing
# until sway is rebuilt.
tebian_snap_keys_sync() {
    local file="${1:-$TEBIAN_SWAY_USER}" line
    tebian_block_has floating-mode "$file" || return 0
    if tebian_snap_rev2; then
        if grep -qxE 'bindsym \$mod\+Ctrl\+(Up snap max|Down snap restore)' "$file"; then
            sed -e 's/^bindsym \$mod+Ctrl+Up snap max$/bindsym $mod+Ctrl+Up snap up/' \
                -e 's/^bindsym \$mod+Ctrl+Down snap restore$/bindsym $mod+Ctrl+Down snap down/' \
                "$file" | _tebian_rewrite "$file"
        fi
        for line in "${TEBIAN_SNAP_KEYS_REV2[@]}"; do
            tebian_block_add_line floating-mode "$line" "$file"
        done
    elif grep -qxE 'bindsym \$mod\+Ctrl\+(Up snap up|Down snap down)' "$file"; then
        sed -e 's/^bindsym \$mod+Ctrl+Up snap up$/bindsym $mod+Ctrl+Up snap max/' \
            -e 's/^bindsym \$mod+Ctrl+Down snap down$/bindsym $mod+Ctrl+Down snap restore/' \
            "$file" | _tebian_rewrite "$file"
    fi
}

# Remove floating mode from config.user
remove_floating_mode() {
    tebian_block_remove floating-mode
}

# ==============================================================================
# PACKAGE INSTALLS FROM MENUS
# fuzzel-launched code has no terminal, so a bare `sudo apt install` can't
# prompt for a password and fails silently. Install in a terminal window and
# report whether the packages actually ended up installed.
# ==============================================================================
tebian_term_apt_install() {
    local pkg missing=()
    for pkg in "$@"; do
        dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "ok installed" || missing+=("$pkg")
    done
    [ ${#missing[@]} -eq 0 ] && return 0

    local term="${TERM_CMD:-kitty -e}"
    # The terminal blocks until the command exits, so the check below sees
    # the result
    $term bash -c '
        echo "Installing: $*"
        echo
        if sudo apt install -y "$@"; then
            echo; echo "Done."
            sleep 1
        else
            echo; echo "Install failed."
            read -rp "Press Enter to close. "
        fi
    ' _ "${missing[@]}"

    for pkg in "${missing[@]}"; do
        dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "ok installed" || return 1
    done
}

# Quickshell (the Modern bar's panels) exists in Debian only in
# trixie-backports. Enables that repo the same way the Graphics Drivers
# toggle does — the same list file, and backports is NotAutomatic, so
# nothing else upgrades from it — then installs just quickshell. Runs in a
# terminal for sudo; returns non-zero if it didn't end up installed.
tebian_install_quickshell() {
    local term="${TERM_CMD:-kitty -e}"
    $term bash -c '
        echo "Installing Quickshell (the bar panels and the dock) from trixie-backports..."
        echo
        list=/etc/apt/sources.list.d/tebian-backports.list
        if ! grep -rqs "trixie-backports" /etc/apt/sources.list /etc/apt/sources.list.d/; then
            echo "deb http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware" |
                sudo tee "$list" >/dev/null
        fi
        if sudo apt update && sudo apt install -y -t trixie-backports quickshell; then
            echo; echo "Done."; sleep 1
        else
            echo; echo "Quickshell could not be installed — the bar will use simple menus."
            read -rp "Press Enter to close. "
        fi
    '
    command -v quickshell >/dev/null
}

# ==============================================================================
# SCREEN LOCK & IDLE
# One place builds the swayidle command, so the login autostart and the
# Settings toggles agree. Choices persist in ~/.config/tebian/idle.conf.
# ==============================================================================
TEBIAN_IDLE_CONF="$HOME/.config/tebian/idle.conf"

tebian_idle_start() {
    local AUTOLOCK=on LOCK_MINUTES=5
    # shellcheck disable=SC1090
    [ -f "$TEBIAN_IDLE_CONF" ] && . "$TEBIAN_IDLE_CONF"
    [[ "$LOCK_MINUTES" =~ ^[0-9]+$ ]] && [ "$LOCK_MINUTES" -gt 0 ] || LOCK_MINUTES=5

    pkill -x swayidle 2>/dev/null
    command -v swayidle >/dev/null || return 1

    # Locking on suspend is not part of auto-lock: a laptop shut into a bag
    # with auto-lock off or Keep awake on must still wake up locked. So
    # swayidle always runs for before-sleep (and logind's lock signal, e.g.
    # `loginctl lock-session`); those two switches only drop the timeouts.
    # Keep awake's flag lives in the runtime dir, so it ends at logout.
    local -a timeouts=()
    if [ "$AUTOLOCK" = on ] && [ ! -f "${XDG_RUNTIME_DIR:-/tmp}/tebian/awake-idle" ]; then
        local secs=$((LOCK_MINUTES * 60))
        # swayidle runs each command through sh -c: "output * power off" must
        # stay quoted, or the * expands to the file names in $HOME
        timeouts=(
            timeout "$secs" 'gtklock -d'
            timeout "$((secs * 2))" 'swaymsg "output * power off"'
            resume 'swaymsg "output * power on"'
        )
    fi
    # -w: suspend waits (up to logind's InhibitDelayMaxSec) for gtklock -d,
    # which returns once the screen is locked, so no frame of the desktop
    # shows on resume
    setsid swayidle -w "${timeouts[@]}" \
        before-sleep 'gtklock -d' \
        lock 'gtklock -d' >/dev/null 2>&1 &
}

# Persist idle settings and apply them now
tebian_idle_set() {
    local autolock="$1" minutes="$2"
    mkdir -p "$(dirname "$TEBIAN_IDLE_CONF")"
    printf 'AUTOLOCK=%s\nLOCK_MINUTES=%s\n' "$autolock" "$minutes" > "$TEBIAN_IDLE_CONF"
    tebian_idle_start
}

# ==============================================================================
# BLUETOOTH PAIRING AGENT
# BlueZ refuses every pairing ("Authentication Failed") unless an agent is
# registered; tebian-bt-agent is that agent. It runs as the user service
# tebian-bt-agent, so systemd restarts it if it dies and
# `systemctl --user status tebian-bt-agent` shows what it was asked.
# Started at login, and again by anything about to pair, so a session that
# began before Bluetooth (or this agent) was installed still gets one.
# ==============================================================================
tebian_bt_agent_start() {
    command -v bluetoothctl >/dev/null || return 1
    python3 -c 'import dbus, gi' 2>/dev/null || return 1
    local agent
    agent=$(command -v tebian-bt-agent) || agent="$HOME/.local/bin/tebian-bt-agent"
    [ -x "$agent" ] || return 1

    # "restart" (login): a running agent may still hold the previous
    # session's display, and its prompts would open nowhere
    if [ "${1:-}" != restart ] && systemctl --user -q is-active tebian-bt-agent; then
        return 0
    fi
    systemctl --user stop tebian-bt-agent 2>/dev/null
    local -a env=()
    [ -n "${WAYLAND_DISPLAY:-}" ] && env=(-E "WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
    systemd-run --user --quiet --collect --unit=tebian-bt-agent \
        -p Restart=on-failure -p RestartSec=2 "${env[@]}" "$agent" || return 1
    # Registering with BlueZ takes a moment; a pairing started sooner
    # would still find no agent
    sleep 1
}

# ==============================================================================
# Per-machine choices. ~/Tebian/tebian.conf holds Tebian's defaults (on a
# fleet machine, the fleet's manifest in git); what the user picks in
# Settings is recorded in ~/.config/tebian/machine.conf, which tebian-rebuild,
# desktop.sh and tebian-update read after tebian.conf, so it wins. Writing
# tebian.conf itself dirtied the git checkout (pulls then failed) and mixed
# the user's choices into a file updates own.
# ==============================================================================
TEBIAN_MACHINE_CONF="$HOME/.config/tebian/machine.conf"

tebian_conf_set() {
    local key="$1" value="$2"
    local conf="$TEBIAN_MACHINE_CONF"
    [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || return 1
    # Values are sourced by bash later; keep them to a safe character set
    [[ "$value" =~ ^[A-Za-z0-9._/-]*$ ]] || return 1
    if [ ! -f "$conf" ]; then
        mkdir -p "${conf%/*}" || return 1
        printf '%s\n' \
            "# This machine's settings, recorded by Tebian Settings. Each KEY=\"value\"" \
            "# overrides the default in ~/Tebian/tebian.conf. Apply edits: tebian-rebuild" \
            > "$conf" || return 1
    fi
    # Unchanged: leave the file (and its timestamp) alone
    grep -qxF "${key}=\"${value}\"" "$conf" && return 0
    if grep -qE "^${key}=" "$conf"; then
        K="$key" V="$value" awk '
            index($0, ENVIRON["K"] "=") == 1 { print ENVIRON["K"] "=\"" ENVIRON["V"] "\""; next }
            { print }' "$conf" > "$conf.tmp" && mv "$conf.tmp" "$conf"
    else
        printf '%s="%s"\n' "$key" "$value" >> "$conf"
    fi
}

# ==============================================================================
# CONFIG LINE HELPERS
# ==============================================================================

# Append a line to a file only if it doesn't already exist.
# A sway line tagged the old way ("cmd # tebian-name") goes into the matching
# block instead — a trailing comment would become part of the command.
idempotent_append() {
    local line="$1"
    local file="$2"
    if [[ "$file" == */sway/* && "$line" =~ ^([^#].*[^[:space:]])[[:space:]]+#[[:space:]]tebian-([a-z0-9-]+)$ ]]; then
        tebian_block_add_line "$(_tebian_block_key "${BASH_REMATCH[2]}")" "${BASH_REMATCH[1]}" "$file"
        return
    fi
    grep -qxF "$line" "$file" 2>/dev/null || echo "$line" >> "$file"
}

# ==============================================================================
# FONT CHOICE — Settings -> Fonts saves it to ~/.config/tebian/font; this
# re-applies it to kitty and fuzzel, whose configs tebian-theme regenerates
# on every theme switch
# ==============================================================================
tebian_apply_app_fonts() {
    local FONT_NAME="" FONT_SIZE=""
    # shellcheck disable=SC1090
    [ -f "$HOME/.config/tebian/font" ] && . "$HOME/.config/tebian/font"
    [ -n "$FONT_NAME" ] || return 0
    [ -f "$HOME/.config/kitty/kitty.conf" ] &&
        sed -i "s/^font_family.*/font_family $FONT_NAME/" "$HOME/.config/kitty/kitty.conf"
    [ -f "$HOME/.config/fuzzel/fuzzel.ini" ] &&
        sed -i "s/^font=.*/font=$FONT_NAME:size=${FONT_SIZE:-11}/" "$HOME/.config/fuzzel/fuzzel.ini"
    return 0
}

# ==============================================================================
# DNS PRIVACY helpers (used by Settings -> Security, run inside a terminal)
# ==============================================================================

# True if a well-known name resolves within a few seconds
dns_works() {
    local i
    for i in 1 2 3 4 5; do
        timeout 3 getent ahosts deb.debian.org >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

# ==============================================================================
# APT SOURCES
# Both formats exist in the wild: one-line /etc/apt/sources.list (what the
# Tebian installer writes) and deb822 *.sources files (debian.sources on
# fresh Debian 13 / cloud images). Only Debian's own archives are touched —
# rewriting a third-party line (Docker, Tailscale) would point it at a suite
# or component that repo doesn't have. Every function here needs root and
# echoes nothing unless something changed.
# ==============================================================================

# Files apt reads sources from
_tebian_apt_files() {
    local f
    # TEBIAN_APT_ROOT lets the functions be exercised on a copy of /etc/apt
    local root="${TEBIAN_APT_ROOT:-}"
    for f in "$root"/etc/apt/sources.list "$root"/etc/apt/sources.list.d/*.list "$root"/etc/apt/sources.list.d/*.sources; do
        [ -f "$f" ] && echo "$f"
    done
}

# Run an awk program over a sources file and install the result if it differs
_tebian_apt_edit() {
    local file="$1"; shift
    local tmp
    tmp=$(mktemp) || return 1
    awk "$@" "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
    if ! cmp -s "$tmp" "$file"; then
        # Backups go outside sources.list.d, where apt would print a notice
        # about every unrecognised file on each update
        local bdir="${TEBIAN_APT_ROOT:-}/var/backups/tebian-apt"
        local backup
        backup="$bdir/$(basename "$file").$(date +%Y%m%d-%H%M%S)"
        sudo mkdir -p "$bdir" && sudo cp "$file" "$backup" &&
            sudo tee "$file" < "$tmp" > /dev/null &&
            echo "  updated ${file#"${TEBIAN_APT_ROOT:-}"} (backup: ${backup#"${TEBIAN_APT_ROOT:-}"})"
    fi
    rm -f "$tmp"
}

# awk: is this URI one of Debian's archives?
# Strictly *.debian.org hosts (deb., security., ftp.XX.): a custom mirror is
# skipped rather than risk rewriting a third-party repo that also ends in
# /debian (Docker, Tailscale, Jellyfin all do).
_TEBIAN_AWK_DEBIAN='function is_debian(u) { return u ~ /^https?:\/\/([a-z0-9-]+\.)*debian\.org(\/|$)/ }'

# Add components (e.g. "contrib non-free non-free-firmware") to every Debian
# entry that has "main"
tebian_apt_add_components() {
    local comps="$1" f
    while read -r f; do
        if [[ "$f" == *.sources ]]; then
            _tebian_apt_edit "$f" -v comps="$comps" "$_TEBIAN_AWK_DEBIAN"'
                function flush(   i, n, c, have) {
                    if (nl == 0) return
                    if (deb && cidx) {
                        n = split(comps, c, " ")
                        for (i = 1; i <= n; i++) {
                            have = " " substr(lines[cidx], index(lines[cidx], ":") + 1) " "
                            gsub(/[ \t]+/, " ", have)
                            if (have ~ / main / && index(have, " " c[i] " ") == 0) lines[cidx] = lines[cidx] " " c[i]
                        }
                    }
                    for (i = 1; i <= nl; i++) print lines[i]
                    nl = 0; deb = 0; cidx = 0
                }
                /^[ \t]*$/ { flush(); print; next }
                {
                    lines[++nl] = $0
                    if ($1 == "URIs:") for (i = 2; i <= NF; i++) if (is_debian($i)) deb = 1
                    if ($1 == "Components:") cidx = nl
                }
                END { flush() }'
        else
            _tebian_apt_edit "$f" -v comps="$comps" "$_TEBIAN_AWK_DEBIAN"'
                /^[ \t]*deb(-src)?[ \t]/ {
                    # URI is the first field after "deb" and an optional [options]
                    u = 2; if ($2 ~ /^\[/) { while (u <= NF && $u !~ /\]$/) u++; u++ }
                    line = " " $0 " "
                    if (is_debian($u) && line ~ /[ \t]main[ \t]/) {
                        n = split(comps, c, " ")
                        for (i = 1; i <= n; i++) if (index(line, " " c[i] " ") == 0) { $0 = $0 " " c[i]; line = " " $0 " " }
                    }
                }
                { print }'
        fi
    done < <(_tebian_apt_files)
}

# Kept for callers from before deb822 support; the file argument is ignored
# since the right answer is "every Debian source", wherever it lives.
safe_sources_add_components() {
    tebian_apt_add_components "$2"
}

# Switch Debian entries from a release codename to another suite, keeping
# the pocket: trixie -> testing, trixie-security -> testing-security,
# trixie-updates -> testing-updates. Backports for the old release have no
# meaning on testing, so those entries are dropped rather than renamed.
# Matching is on the whole suite field — never a substring of a URI or of a
# third-party repo line.
tebian_apt_switch_suite() {
    local from="$1" to="$2" f
    while read -r f; do
        if [[ "$f" == *.sources ]]; then
            _tebian_apt_edit "$f" -v from="$from" -v to="$to" "$_TEBIAN_AWK_DEBIAN"'
                function flush(   i, n, s, out, bp) {
                    if (nl == 0) return
                    if (deb && sidx) {
                        n = split(substr(lines[sidx], index(lines[sidx], ":") + 1), s, " ")
                        out = ""; bp = 0
                        for (i = 1; i <= n; i++) {
                            if (s[i] == from "-backports") { bp = 1; continue }
                            if (s[i] == from) s[i] = to
                            else if (index(s[i], from "-") == 1) s[i] = to substr(s[i], length(from) + 1)
                            out = out " " s[i]
                        }
                        if (out == "") { for (i = 1; i <= nl; i++) print "# " lines[i]; nl = 0; deb = 0; sidx = 0; return }
                        lines[sidx] = "Suites:" out
                    }
                    for (i = 1; i <= nl; i++) print lines[i]
                    nl = 0; deb = 0; sidx = 0
                }
                /^[ \t]*$/ { flush(); print; next }
                {
                    lines[++nl] = $0
                    if ($1 == "URIs:") for (i = 2; i <= NF; i++) if (is_debian($i)) deb = 1
                    if ($1 == "Suites:") sidx = nl
                }
                END { flush() }'
        else
            _tebian_apt_edit "$f" -v from="$from" -v to="$to" "$_TEBIAN_AWK_DEBIAN"'
                /^[ \t]*deb(-src)?[ \t]/ {
                    u = 2; if ($2 ~ /^\[/) { while (u <= NF && $u !~ /\]$/) u++; u++ }
                    sfx = u + 1
                    if (is_debian($u)) {
                        if ($sfx == from "-backports") { print "# " $0; next }
                        if ($sfx == from) $sfx = to
                        else if (index($sfx, from "-") == 1) $sfx = to substr($sfx, length(from) + 1)
                    }
                }
                { print }'
        fi
    done < <(_tebian_apt_files)
}

# Current Debian release codename of the configured sources (trixie,
# testing, ...), or empty. Only a bare suite counts: the files are read in
# name order, and debian-backports.sources (the name Debian's backports
# instructions use) sorts before debian.sources, so taking the first suite
# seen answered "trixie-backports" and Join Rolling switched only that
# stanza. awk at the end, not head: it reads everything, so no SIGPIPE
# under pipefail.
tebian_apt_suite() {
    local f
    while read -r f; do
        if [[ "$f" == *.sources ]]; then
            awk "$_TEBIAN_AWK_DEBIAN"'
                function flush(   i) {
                    if (deb) for (i = 1; i <= ns; i++) if (s[i] !~ /-/) print s[i]
                    deb = 0; ns = 0
                }
                /^[ \t]*$/ { flush(); next }
                $1 == "URIs:" { for (i = 2; i <= NF; i++) if (is_debian($i)) deb = 1 }
                $1 == "Suites:" { ns = 0; for (i = 2; i <= NF; i++) s[++ns] = $i }
                END { flush() }' "$f"
        else
            awk "$_TEBIAN_AWK_DEBIAN"'
                /^[ \t]*deb[ \t]/ {
                    u = 2; if ($2 ~ /^\[/) { while (u <= NF && $u !~ /\]$/) u++; u++ }
                    if (is_debian($u) && $(u+1) !~ /-/) print $(u+1)
                }' "$f"
        fi
    done < <(_tebian_apt_files) | awk 'NR == 1'
}
