#!/bin/bash
# ==============================================================================
# TEBIAN COMMON LIBRARY (V2.0)
# Shared functions for error handling, logging, and utilities
# ==============================================================================

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Logging
log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }
log_debug() { [ "${TEBIAN_DEBUG:-0}" != "1" ] || echo -e "${BLUE}[DEBUG]${NC} $1"; }

# Error handling
tebian_error() {
    local exit_code=$?
    log_error "Script failed at line $1 (exit code: $exit_code)"
    if [ "${TEBIAN_DEBUG:-0}" = "1" ] && [ -f "${BASH_SOURCE[1]:-}" ]; then
        log_error "Command: $(sed -n "${1}p" "${BASH_SOURCE[1]}")"
    fi
    exit $exit_code
}

# Error handling (Optional - Call explicitly)
trap_error() {
    set -e
    trap 'tebian_error $LINENO' ERR
}

# Check if running in Wayland
is_wayland() {
    [ -n "$WAYLAND_DISPLAY" ]
}

# Check if running in X11
is_x11() {
    [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]
}

# Check if command exists
has_cmd() {
    command -v "$1" &> /dev/null
}

# Require command or exit
require_cmd() {
    if ! has_cmd "$1"; then
        log_error "Required command not found: $1"
        log_info "Install with: sudo apt install $2"
        exit 1
    fi
}

# Require root/sudo
require_root() {
    if [ "$EUID" -ne 0 ]; then
        log_error "This command requires root. Run with sudo."
        exit 1
    fi
}

# Check Tebian installation
check_tebian() {
    local tebian_dir="${TEBIAN_DIR:-$HOME/Tebian}"
    if [ ! -d "$tebian_dir" ]; then
        log_error "Tebian not found at $tebian_dir"
        log_info "Set TEBIAN_DIR environment variable if installed elsewhere"
        exit 1
    fi
    export TEBIAN_DIR="$tebian_dir"
}

# Safe copy with backup
safe_copy() {
    local src="$1"
    local dst="$2"
    
    if [ ! -f "$src" ]; then
        log_error "Source file not found: $src"
        return 1
    fi
    
    if [ -f "$dst" ]; then
        cp "$dst" "$dst.bak.$(date +%s)"
        log_debug "Backed up: $dst"
    fi
    
    cp "$src" "$dst"
    log_debug "Copied: $src -> $dst"
}

# Confirm action
confirm() {
    local prompt="${1:-Continue?}"
    local default="${2:-n}"
    
    if [ "$default" = "y" ]; then
        read -p "$prompt [Y/n] " choice
        [[ -z "$choice" || "$choice" =~ ^[Yy] ]]
    else
        read -p "$prompt [y/N] " choice
        [[ "$choice" =~ ^[Yy] ]]
    fi
}

# True if a tfuzzel selection is empty (Esc) or the Back entry.
# Must match both icon mode ("󰌍 Back...") and no_icons mode, where tfuzzel
# strips the glyph and leading space so the entry comes back as "Back...".
# "Back " prefix (not bare "Back*") so labels like "Backup Configs" don't match.
is_back() {
    local c="$1"
    [[ -z "$c" || "$c" == *"󰌍 Back"* || "$c" == "Back" || "$c" == "Back "* ]]
}

# Fuzzel Wrapper (Handles Icon Toggling + Separator Filtering)
tfuzzel() {
    local RESULT
    # Opened from the Modern bar: drop down from it instead of the screen
    # centre (tebian-bar-menu sets the edge). Inherited by every submenu.
    # A drop-down is also sized to its items: themes fix fuzzel at 15
    # lines, which left short menus as a tall box hanging off the bar.
    local -a anchor=()
    local input=""
    if [ -n "${TEBIAN_MENU_ANCHOR:-}" ]; then
        input=$(cat)
        local n
        n=$(printf '%s\n' "$input" | grep -c .)
        [ "$n" -gt 15 ] && n=15
        [ "$n" -lt 1 ] && n=1
        anchor=(--anchor "$TEBIAN_MENU_ANCHOR" --x-margin 8 --y-margin 6 --lines "$n")
        exec 3< <(printf '%s\n' "$input")
    else
        exec 3<&0
    fi
    if [ -f "$HOME/.config/tebian/no_icons" ]; then
        # Text Mode: Strip Nerd Fonts (PUA: E000-F8FF, F0000-FFFFD) and Emoji (1F300-1FAFF)
        RESULT=$(perl -CS -pe 's/[\x{E000}-\x{F8FF}\x{F0000}-\x{FFFFD}\x{1F300}-\x{1FAFF}]//g; s/^\s+//' <&3 | fuzzel "${anchor[@]}" "$@")
    else
        # Icon Mode (Default): Pass through
        RESULT=$(fuzzel "${anchor[@]}" "$@" <&3)
    fi
    exec 3<&-
    # Filter out separator lines — treat as no selection
    if [[ "$RESULT" =~ ^─+$ ]]; then
        return 1
    fi
    echo "$RESULT"
}

# ==============================================================================
# HARDWARE DETECTION
# Sets: GPU_TYPE, CPU_TYPE, IS_LAPTOP, IS_HIDPI, HAS_NVIDIA, HAS_AMD_GPU, HAS_INTEL_GPU
# ==============================================================================
detect_hardware() {
    local quiet="${1:-false}"
    _hw_msg() { [ "$quiet" = "true" ] || echo "  $1"; }

    # GPU
    HAS_NVIDIA=$(lspci 2>/dev/null | grep -i nvidia | head -1)
    HAS_AMD_GPU=$(lspci 2>/dev/null | grep -i "AMD.*VGA\|AMD.*3D\|AMD.*Display" | head -1)
    HAS_INTEL_GPU=$(lspci 2>/dev/null | grep -i "Intel.*VGA\|Intel.*Display" | head -1)

    if [ -n "$HAS_NVIDIA" ]; then
        GPU_TYPE="NVIDIA"
        _hw_msg "GPU: NVIDIA detected"
    elif [ -n "$HAS_AMD_GPU" ]; then
        GPU_TYPE="AMD"
        _hw_msg "GPU: AMD detected"
    elif [ -n "$HAS_INTEL_GPU" ]; then
        GPU_TYPE="Intel"
        _hw_msg "GPU: Intel detected"
    else
        GPU_TYPE="Unknown"
        _hw_msg "GPU: Unknown/VM"
    fi

    # CPU (with lscpu fallback)
    CPU_VENDOR=$(grep -m1 "vendor_id" /proc/cpuinfo 2>/dev/null | awk '{print $3}')
    if [ -z "$CPU_VENDOR" ]; then
        CPU_VENDOR=$(lscpu 2>/dev/null | grep "Vendor ID" | awk '{print $3}')
    fi

    if [[ "$CPU_VENDOR" == "GenuineIntel" ]]; then
        CPU_TYPE="Intel"
        _hw_msg "CPU: Intel detected"
    elif [[ "$CPU_VENDOR" == "AuthenticAMD" ]]; then
        CPU_TYPE="AMD"
        _hw_msg "CPU: AMD detected"
    else
        CPU_TYPE="Unknown"
        _hw_msg "CPU: Unknown"
    fi

    # Laptop (battery check)
    HAS_BATTERY=$(ls /sys/class/power_supply/ 2>/dev/null | grep -i bat | head -1)
    if [ -n "$HAS_BATTERY" ]; then
        IS_LAPTOP=true
        _hw_msg "Device: Laptop (battery detected)"
    else
        IS_LAPTOP=false
        _hw_msg "Device: Desktop (no battery)"
    fi

    # HiDPI (Wayland-native via swaymsg)
    local detect_res
    detect_res=$(swaymsg -t get_outputs 2>/dev/null | grep -oP '"width":\s*\K[0-9]+' | head -1)
    if [[ -n "$detect_res" && "$detect_res" -ge 3000 ]] 2>/dev/null; then
        IS_HIDPI=true
        _hw_msg "Display: HiDPI detected (${detect_res} width)"
    else
        IS_HIDPI=false
        _hw_msg "Display: Standard resolution"
    fi
    return 0
}

# ==============================================================================
# SETTINGS BLOCKS IN config.user
# Settings-owned sway lines live between two marker comments:
#
#   # tebian:floating-mode {
#   for_window [app_id=".*"] floating enable
#   # tebian:floating-mode }
#
# Markers get their own lines because sway has no end-of-line comments: a
# trailing "# tebian-x" is handed to the command as extra arguments. That
# is how the old one-line markers broke — `gaps inner 4 # tebian-feel-gaps`
# failed to parse and `floating enable # tebian-floating-mode` was rejected
# ("expected 1 argument, got 3"). tebian_user_migrate converts those.
# ==============================================================================

TEBIAN_SWAY_USER="$HOME/.config/sway/config.user"

# Replace a file's contents with stdin. Rewrites in place rather than
# mv-ing a temp file over it, so a symlinked config (dotfile managers)
# stays a symlink.
_tebian_rewrite() {
    local file="$1" tmp
    tmp=$(mktemp) || return 1
    cat > "$tmp" && cat "$tmp" > "$file"
    rm -f "$tmp"
}

# Legacy marker names that belong to one block
_tebian_block_key() {
    case "$1" in
        titlebars|titlebars-on) echo titlebars ;;
        feel-gaps)              echo gaps ;;
        *)                      echo "$1" ;;
    esac
}

# True if block KEY exists
tebian_block_has() {
    grep -qxF "# tebian:$1 {" "${2:-$TEBIAN_SWAY_USER}" 2>/dev/null
}

# Print the lines inside block KEY
tebian_block_get() {
    local file="${2:-$TEBIAN_SWAY_USER}"
    [ -f "$file" ] || return 0
    K="$1" awk '
        $0 == "# tebian:" ENVIRON["K"] " {" { inb=1; next }
        $0 == "# tebian:" ENVIRON["K"] " }" { inb=0; next }
        inb' "$file"
}

# Remove block KEY
tebian_block_remove() {
    local file="${2:-$TEBIAN_SWAY_USER}"
    [ -f "$file" ] || return 0
    K="$1" awk '
        $0 == "# tebian:" ENVIRON["K"] " {" { inb=1; next }
        $0 == "# tebian:" ENVIRON["K"] " }" { inb=0; next }
        !inb' "$file" | _tebian_rewrite "$file"
}

# Replace block KEY with the given lines (none = remove). Written to the end
# of the file, where it overrides the base config and earlier user lines.
tebian_block_set() {
    tebian_block_set_in "$TEBIAN_SWAY_USER" "$@"
}

tebian_block_set_in() {
    local file="$1" key="$2" line; shift 2
    mkdir -p "$(dirname "$file")"; touch "$file"
    tebian_block_remove "$key" "$file"
    [ $# -gt 0 ] || return 0
    {
        echo "# tebian:$key {"
        for line in "$@"; do echo "$line"; done
        echo "# tebian:$key }"
    } >> "$file"
}

# Add one line to block KEY unless it's already there
tebian_block_add_line() {
    local key="$1" line="$2" file="${3:-$TEBIAN_SWAY_USER}"
    mkdir -p "$(dirname "$file")"; touch "$file"
    if tebian_block_has "$key" "$file"; then
        tebian_block_get "$key" "$file" | grep -qxF -- "$line" && return 0
        K="$key" L="$line" awk '
            $0 == "# tebian:" ENVIRON["K"] " }" { print ENVIRON["L"] }
            { print }' "$file" | _tebian_rewrite "$file"
    else
        printf '# tebian:%s {\n%s\n# tebian:%s }\n' "$key" "$line" "$key" >> "$file"
    fi
}

# Convert old one-line markers ("cmd # tebian-name") into blocks. Idempotent
# and cheap: runs at every login (tebian-session) and when Settings opens.
tebian_user_migrate() {
    local file="${1:-$TEBIAN_SWAY_USER}" key line
    [ -f "$file" ] || return 0

    # Older templates bound bare Ctrl+Left/Right to workspace switching,
    # which steals word-jump from every text field. Only the exact shipped
    # lines are rewritten — a user's own Ctrl bindings are left alone.
    if grep -qxE 'bindsym Ctrl\+(Left workspace prev|Right workspace next)' "$file"; then
        sed -e 's/^bindsym Ctrl+Left workspace prev$/bindsym $mod+Alt+Left workspace prev/' \
            -e 's/^bindsym Ctrl+Right workspace next$/bindsym $mod+Alt+Right workspace next/' \
            "$file" | _tebian_rewrite "$file"
    fi

    # Floating mode's keyboard snaps: the first ones positioned from the
    # output's corner ("move absolute position 0 0") and covered the bar,
    # the next ones ran tebian-edge-snap. Both become sway's own snap
    # command (Tebian's sway build), which fits the workspace's usable area.
    # The resize-set lines only as shipped (custom ones are left alone); any
    # tebian-edge-snap binding, since that script is gone and sway's snap
    # takes the same zone names.
    if grep -qE '^bindsym .+ (resize set|exec tebian-edge-snap snap )' "$file"; then
        sed -E \
            -e 's/^bindsym \$mod\+Ctrl\+Left resize set 50 ppt 100 ppt; move absolute position 0 0( # tebian-floating-mode)?$/bindsym $mod+Ctrl+Left snap left\1/' \
            -e 's/^bindsym \$mod\+Ctrl\+Right resize set 50 ppt 100 ppt; move absolute position 50 ppt 0( # tebian-floating-mode)?$/bindsym $mod+Ctrl+Right snap right\1/' \
            -e 's/^bindsym \$mod\+Ctrl\+Up resize set 100 ppt 100 ppt; move absolute position 0 0( # tebian-floating-mode)?$/bindsym $mod+Ctrl+Up snap max\1/' \
            -e 's/^bindsym \$mod\+Ctrl\+Down resize set 60 ppt 60 ppt; move position center( # tebian-floating-mode)?$/bindsym $mod+Ctrl+Down snap restore\1/' \
            -e 's/^(bindsym .+) exec tebian-edge-snap snap (left|right|max|top-left|top-right|bottom-left|bottom-right|restore)( # tebian-[a-z-]+)?$/\1 snap \2\3/' \
            "$file" | _tebian_rewrite "$file"
    fi

    # tebian-edge-snap, the old drag-snapping watcher, is gone: sway snaps
    # by itself now. Drop its block, and its one-line form below.
    if tebian_block_has edge-snap "$file"; then
        tebian_block_remove edge-snap "$file"
        pkill -f "^[^ ]*python3 [^ ]*tebian-edge-snap" 2>/dev/null
    fi

    # "Snapping off" is a line only Tebian's sway understands; under any
    # other sway (SwayFX not yet rebuilt, Debian's own after an update) it
    # would be a config error at every login, so it waits until it's valid
    if tebian_block_has snap-off "$file" && ! tebian_snap_supported; then
        tebian_block_remove snap-off "$file"
    fi

    grep -qE '[^[:space:]#].*[[:space:]]# tebian-[a-z0-9-]+[[:space:]]*$' "$file" || return 0

    local moved
    moved=$(awk '
        /^[[:space:]]*#/ { next }
        match($0, /[[:space:]]+# tebian-[a-z0-9-]+[[:space:]]*$/) {
            tag = substr($0, RSTART); sub(/^[[:space:]]+# tebian-/, "", tag); sub(/[[:space:]]+$/, "", tag)
            print tag "\t" substr($0, 1, RSTART - 1)
        }' "$file")
    awk '
        /^[[:space:]]*#/ { print; next }
        /[[:space:]]+# tebian-[a-z0-9-]+[[:space:]]*$/ { next }
        { print }' "$file" | _tebian_rewrite "$file"

    while IFS=$'\t' read -r key line; do
        [ -n "$line" ] || continue
        key=$(_tebian_block_key "$key")
        # One value per SwayFX option: a reinstall re-appends all of them
        if [ "$key" = swayfx ] && tebian_block_has swayfx "$file"; then
            local directive="${line%% *}" kept
            kept=$(tebian_block_get swayfx "$file" | awk -v d="$directive" '$1 != d')
            # shellcheck disable=SC2086
            mapfile -t _kept <<< "$kept"
            [ -n "$kept" ] || _kept=()
            tebian_block_set_in "$file" swayfx "${_kept[@]}" "$line"
            continue
        fi
        # The old drag-snapping watcher (see above)
        if [[ "$line" == exec_always*tebian-edge-snap* ]]; then
            pkill -f "^[^ ]*python3 [^ ]*tebian-edge-snap" 2>/dev/null
            continue
        fi
        tebian_block_add_line "$(_tebian_block_key "$key")" "$line" "$file"
    done <<< "$moved"
}

# ==============================================================================
# FLOATING MODE AND WINDOW SNAPPING
# Floating mode writes window rules and keyboard snaps to config.user.
# Snapping itself is in Tebian's sway build (tebian-build-sway, or the
# patched SwayFX): drag a floating window to an edge or corner and it shows
# where it will land. It's on by default there, so the config never needs a
# line that an unpatched sway would reject.
# ==============================================================================

# True if the sway that `sway` starts has Tebian's snapping. Asks sway to
# check a one-line config rather than guessing from version numbers, so it
# holds for Debian's sway, Tebian's build and SwayFX alike.
tebian_snap_supported() {
    command -v sway >/dev/null || return 1
    local probe rc
    probe=$(mktemp) || return 1
    echo 'floating_snap enable' > "$probe"
    sway -C -c "$probe" >/dev/null 2>&1
    rc=$?
    rm -f "$probe"
    return $rc
}

setup_floating_mode() {
    # Click to focus while windows overlap: with focus-follows-mouse, just
    # moving the pointer across a window focuses it, and sway raises a
    # focused floating window — so windows kept jumping in front of each
    # other. The block is appended after the user's own setting, so it wins
    # here and their choice returns when the block goes (tiling mode).
    tebian_block_set floating-mode \
        'focus_follows_mouse no' \
        'for_window [app_id=".*"] floating enable' \
        'for_window [class=".*"] floating enable' \
        'bindsym $mod+Ctrl+Left snap left' \
        'bindsym $mod+Ctrl+Right snap right' \
        'bindsym $mod+Ctrl+Up snap max' \
        'bindsym $mod+Ctrl+Down snap restore'
}

# Remove floating mode from config.user
remove_floating_mode() {
    tebian_block_remove floating-mode
}

# ==============================================================================
# PACKAGE INSTALLS FROM MENUS
# fuzzel-launched code has no terminal, so a bare `sudo apt install` can't
# prompt for a password and fails silently. Install in a terminal window and
# report whether the packages actually ended up installed.
# ==============================================================================
tebian_term_apt_install() {
    local pkg missing=()
    for pkg in "$@"; do
        dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "ok installed" || missing+=("$pkg")
    done
    [ ${#missing[@]} -eq 0 ] && return 0

    local term="${TERM_CMD:-kitty -e}"
    # The terminal blocks until the command exits, so the check below sees
    # the result
    $term bash -c '
        echo "Installing: $*"
        echo
        if sudo apt install -y "$@"; then
            echo; echo "Done."
            sleep 1
        else
            echo; echo "Install failed."
            read -rp "Press Enter to close. "
        fi
    ' _ "${missing[@]}"

    for pkg in "${missing[@]}"; do
        dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "ok installed" || return 1
    done
}

# Quickshell (the Modern bar's panels) exists in Debian only in
# trixie-backports. Enables that repo the same way the Graphics Drivers
# toggle does — the same list file, and backports is NotAutomatic, so
# nothing else upgrades from it — then installs just quickshell. Runs in a
# terminal for sudo; returns non-zero if it didn't end up installed.
tebian_install_quickshell() {
    local term="${TERM_CMD:-kitty -e}"
    $term bash -c '
        echo "Installing Quickshell (panels for the Modern bar) from trixie-backports..."
        echo
        list=/etc/apt/sources.list.d/tebian-backports.list
        if ! grep -rqs "trixie-backports" /etc/apt/sources.list /etc/apt/sources.list.d/; then
            echo "deb http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware" |
                sudo tee "$list" >/dev/null
        fi
        if sudo apt update && sudo apt install -y -t trixie-backports quickshell; then
            echo; echo "Done."; sleep 1
        else
            echo; echo "Quickshell could not be installed — the bar will use simple menus."
            read -rp "Press Enter to close. "
        fi
    '
    command -v quickshell >/dev/null
}

# ==============================================================================
# SCREEN LOCK & IDLE
# One place builds the swayidle command, so the login autostart and the
# Settings toggles agree. Choices persist in ~/.config/tebian/idle.conf.
# ==============================================================================
TEBIAN_IDLE_CONF="$HOME/.config/tebian/idle.conf"

tebian_idle_start() {
    local AUTOLOCK=on LOCK_MINUTES=5
    # shellcheck disable=SC1090
    [ -f "$TEBIAN_IDLE_CONF" ] && . "$TEBIAN_IDLE_CONF"
    [[ "$LOCK_MINUTES" =~ ^[0-9]+$ ]] && [ "$LOCK_MINUTES" -gt 0 ] || LOCK_MINUTES=5

    pkill -x swayidle 2>/dev/null
    [ "$AUTOLOCK" = on ] || return 0
    command -v swayidle >/dev/null || return 1

    local secs=$((LOCK_MINUTES * 60))
    # swayidle runs each command through sh -c: "output * power off" must
    # stay quoted, or the * expands to the file names in $HOME
    setsid swayidle -w \
        timeout "$secs" 'gtklock -d' \
        timeout "$((secs * 2))" 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
        before-sleep 'gtklock -d' >/dev/null 2>&1 &
}

# Persist idle settings and apply them now
tebian_idle_set() {
    local autolock="$1" minutes="$2"
    mkdir -p "$(dirname "$TEBIAN_IDLE_CONF")"
    printf 'AUTOLOCK=%s\nLOCK_MINUTES=%s\n' "$autolock" "$minutes" > "$TEBIAN_IDLE_CONF"
    tebian_idle_start
}

# ==============================================================================
# BLUETOOTH PAIRING AGENT
# BlueZ refuses every pairing ("Authentication Failed") unless an agent is
# registered; tebian-bt-agent is that agent. It runs as the user service
# tebian-bt-agent, so systemd restarts it if it dies and
# `systemctl --user status tebian-bt-agent` shows what it was asked.
# Started at login, and again by anything about to pair, so a session that
# began before Bluetooth (or this agent) was installed still gets one.
# ==============================================================================
tebian_bt_agent_start() {
    command -v bluetoothctl >/dev/null || return 1
    python3 -c 'import dbus, gi' 2>/dev/null || return 1
    local agent
    agent=$(command -v tebian-bt-agent) || agent="$HOME/.local/bin/tebian-bt-agent"
    [ -x "$agent" ] || return 1

    # "restart" (login): a running agent may still hold the previous
    # session's display, and its prompts would open nowhere
    if [ "${1:-}" != restart ] && systemctl --user -q is-active tebian-bt-agent; then
        return 0
    fi
    systemctl --user stop tebian-bt-agent 2>/dev/null
    local -a env=()
    [ -n "${WAYLAND_DISPLAY:-}" ] && env=(-E "WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
    systemd-run --user --quiet --collect --unit=tebian-bt-agent \
        -p Restart=on-failure -p RestartSec=2 "${env[@]}" "$agent" || return 1
    # Registering with BlueZ takes a moment; a pairing started sooner
    # would still find no agent
    sleep 1
}

# ==============================================================================
# tebian.conf — the per-machine manifest tebian-rebuild reads. Settings that
# rebuild re-applies (theme, security profile) must be recorded here, or the
# next rebuild resets them to the defaults.
# ==============================================================================
tebian_conf_set() {
    local key="$1" value="$2"
    local conf="${TEBIAN_DIR:-$HOME/Tebian}/tebian.conf"
    [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || return 1
    # Values are sourced by bash later; keep them to a safe character set
    [[ "$value" =~ ^[A-Za-z0-9._/-]*$ ]] || return 1
    [ -f "$conf" ] || touch "$conf" 2>/dev/null || return 1
    if grep -qE "^${key}=" "$conf"; then
        K="$key" V="$value" awk '
            index($0, ENVIRON["K"] "=") == 1 { print ENVIRON["K"] "=\"" ENVIRON["V"] "\""; next }
            { print }' "$conf" > "$conf.tmp" && mv "$conf.tmp" "$conf"
    else
        printf '%s="%s"\n' "$key" "$value" >> "$conf"
    fi
}

# ==============================================================================
# SAFE SED HELPERS
# ==============================================================================

# Append a line to a file only if it doesn't already exist.
# A sway line tagged the old way ("cmd # tebian-name") goes into the matching
# block instead — a trailing comment would become part of the command.
idempotent_append() {
    local line="$1"
    local file="$2"
    if [[ "$file" == */sway/* && "$line" =~ ^([^#].*[^[:space:]])[[:space:]]+#[[:space:]]tebian-([a-z0-9-]+)$ ]]; then
        tebian_block_add_line "$(_tebian_block_key "${BASH_REMATCH[2]}")" "${BASH_REMATCH[1]}" "$file"
        return
    fi
    grep -qxF "$line" "$file" 2>/dev/null || echo "$line" >> "$file"
}

# Sed replace scoped to within a block (e.g. only within bar { ... })
# Usage: safe_sed_replace "bar {" "}" "s/old/new/" file
safe_sed_replace() {
    local block_start="$1"
    local block_end="$2"
    local sed_expr="$3"
    local file="$4"

    awk -v start="$block_start" -v end_pat="$block_end" -v expr="$sed_expr" '
    BEGIN { in_block=0 }
    $0 ~ start { in_block=1 }
    in_block && $0 ~ end_pat { in_block=0 }
    in_block {
        cmd = "echo " sq($0) " | sed -E " sq(expr)
        cmd | getline result
        close(cmd)
        print result
        next
    }
    { print }
    function sq(s) { gsub(/'\''/, "'\''\\'\'''\''", s); return "'\''" s "'\''" }
    ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

# ==============================================================================
# FONT CHOICE — Settings -> Fonts saves it to ~/.config/tebian/font; this
# re-applies it to kitty and fuzzel, whose configs tebian-theme regenerates
# on every theme switch
# ==============================================================================
tebian_apply_app_fonts() {
    local FONT_NAME="" FONT_SIZE=""
    # shellcheck disable=SC1090
    [ -f "$HOME/.config/tebian/font" ] && . "$HOME/.config/tebian/font"
    [ -n "$FONT_NAME" ] || return 0
    [ -f "$HOME/.config/kitty/kitty.conf" ] &&
        sed -i "s/^font_family.*/font_family $FONT_NAME/" "$HOME/.config/kitty/kitty.conf"
    [ -f "$HOME/.config/fuzzel/fuzzel.ini" ] &&
        sed -i "s/^font=.*/font=$FONT_NAME:size=${FONT_SIZE:-11}/" "$HOME/.config/fuzzel/fuzzel.ini"
    return 0
}

# ==============================================================================
# DNS PRIVACY helpers (used by Settings -> Security, run inside a terminal)
# ==============================================================================

# True if a well-known name resolves within a few seconds
dns_works() {
    local i
    for i in 1 2 3 4 5; do
        timeout 3 getent ahosts deb.debian.org >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

# Undo DNS Privacy: hand /etc/resolv.conf back to NetworkManager
dns_privacy_off() {
    sudo rm -f /etc/systemd/resolved.conf.d/99-tebian-dns.conf \
               /etc/NetworkManager/conf.d/99-tebian-dns-resolved.conf
    sudo systemctl disable --now systemd-resolved 2>/dev/null
    # Only remove a symlink into systemd-resolved: a regular file here is
    # already someone else's (NetworkManager's or the admin's)
    if [ -L /etc/resolv.conf ] && readlink /etc/resolv.conf | grep -q '/systemd/resolve/'; then
        sudo rm -f /etc/resolv.conf
    fi
    # With the file gone and resolved stopped, NetworkManager writes a fresh
    # /etc/resolv.conf from the connection's DNS servers on restart
    sudo systemctl restart NetworkManager
}

# ==============================================================================
# APT SOURCES
# Both formats exist in the wild: one-line /etc/apt/sources.list (what the
# Tebian installer writes) and deb822 *.sources files (debian.sources on
# fresh Debian 13 / cloud images). Only Debian's own archives are touched —
# rewriting a third-party line (Docker, Tailscale) would point it at a suite
# or component that repo doesn't have. Every function here needs root and
# echoes nothing unless something changed.
# ==============================================================================

# Files apt reads sources from
_tebian_apt_files() {
    local f
    # TEBIAN_APT_ROOT lets the functions be exercised on a copy of /etc/apt
    local root="${TEBIAN_APT_ROOT:-}"
    for f in "$root"/etc/apt/sources.list "$root"/etc/apt/sources.list.d/*.list "$root"/etc/apt/sources.list.d/*.sources; do
        [ -f "$f" ] && echo "$f"
    done
}

# Run an awk program over a sources file and install the result if it differs
_tebian_apt_edit() {
    local file="$1"; shift
    local tmp
    tmp=$(mktemp) || return 1
    awk "$@" "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
    if ! cmp -s "$tmp" "$file"; then
        # Backups go outside sources.list.d, where apt would print a notice
        # about every unrecognised file on each update
        local bdir="${TEBIAN_APT_ROOT:-}/var/backups/tebian-apt"
        local backup
        backup="$bdir/$(basename "$file").$(date +%Y%m%d-%H%M%S)"
        sudo mkdir -p "$bdir" && sudo cp "$file" "$backup" &&
            sudo tee "$file" < "$tmp" > /dev/null &&
            echo "  updated ${file#"${TEBIAN_APT_ROOT:-}"} (backup: ${backup#"${TEBIAN_APT_ROOT:-}"})"
    fi
    rm -f "$tmp"
}

# awk: is this URI one of Debian's archives?
# Strictly *.debian.org hosts (deb., security., ftp.XX.): a custom mirror is
# skipped rather than risk rewriting a third-party repo that also ends in
# /debian (Docker, Tailscale, Jellyfin all do).
_TEBIAN_AWK_DEBIAN='function is_debian(u) { return u ~ /^https?:\/\/([a-z0-9-]+\.)*debian\.org(\/|$)/ }'

# Add components (e.g. "contrib non-free non-free-firmware") to every Debian
# entry that has "main"
tebian_apt_add_components() {
    local comps="$1" f
    while read -r f; do
        if [[ "$f" == *.sources ]]; then
            _tebian_apt_edit "$f" -v comps="$comps" "$_TEBIAN_AWK_DEBIAN"'
                function flush(   i, n, c, have) {
                    if (nl == 0) return
                    if (deb && cidx) {
                        n = split(comps, c, " ")
                        for (i = 1; i <= n; i++) {
                            have = " " substr(lines[cidx], index(lines[cidx], ":") + 1) " "
                            gsub(/[ \t]+/, " ", have)
                            if (have ~ / main / && index(have, " " c[i] " ") == 0) lines[cidx] = lines[cidx] " " c[i]
                        }
                    }
                    for (i = 1; i <= nl; i++) print lines[i]
                    nl = 0; deb = 0; cidx = 0
                }
                /^[ \t]*$/ { flush(); print; next }
                {
                    lines[++nl] = $0
                    if ($1 == "URIs:") for (i = 2; i <= NF; i++) if (is_debian($i)) deb = 1
                    if ($1 == "Components:") cidx = nl
                }
                END { flush() }'
        else
            _tebian_apt_edit "$f" -v comps="$comps" "$_TEBIAN_AWK_DEBIAN"'
                /^[ \t]*deb(-src)?[ \t]/ {
                    # URI is the first field after "deb" and an optional [options]
                    u = 2; if ($2 ~ /^\[/) { while (u <= NF && $u !~ /\]$/) u++; u++ }
                    line = " " $0 " "
                    if (is_debian($u) && line ~ /[ \t]main[ \t]/) {
                        n = split(comps, c, " ")
                        for (i = 1; i <= n; i++) if (index(line, " " c[i] " ") == 0) { $0 = $0 " " c[i]; line = " " $0 " " }
                    }
                }
                { print }'
        fi
    done < <(_tebian_apt_files)
}

# Kept for callers from before deb822 support; the file argument is ignored
# since the right answer is "every Debian source", wherever it lives.
safe_sources_add_components() {
    tebian_apt_add_components "$2"
}

# Switch Debian entries from a release codename to another suite, keeping
# the pocket: trixie -> testing, trixie-security -> testing-security,
# trixie-updates -> testing-updates. Backports for the old release have no
# meaning on testing, so those entries are dropped rather than renamed.
# Matching is on the whole suite field — never a substring of a URI or of a
# third-party repo line.
tebian_apt_switch_suite() {
    local from="$1" to="$2" f
    while read -r f; do
        if [[ "$f" == *.sources ]]; then
            _tebian_apt_edit "$f" -v from="$from" -v to="$to" "$_TEBIAN_AWK_DEBIAN"'
                function flush(   i, n, s, out, bp) {
                    if (nl == 0) return
                    if (deb && sidx) {
                        n = split(substr(lines[sidx], index(lines[sidx], ":") + 1), s, " ")
                        out = ""; bp = 0
                        for (i = 1; i <= n; i++) {
                            if (s[i] == from "-backports") { bp = 1; continue }
                            if (s[i] == from) s[i] = to
                            else if (index(s[i], from "-") == 1) s[i] = to substr(s[i], length(from) + 1)
                            out = out " " s[i]
                        }
                        if (out == "") { for (i = 1; i <= nl; i++) print "# " lines[i]; nl = 0; deb = 0; sidx = 0; return }
                        lines[sidx] = "Suites:" out
                    }
                    for (i = 1; i <= nl; i++) print lines[i]
                    nl = 0; deb = 0; sidx = 0
                }
                /^[ \t]*$/ { flush(); print; next }
                {
                    lines[++nl] = $0
                    if ($1 == "URIs:") for (i = 2; i <= NF; i++) if (is_debian($i)) deb = 1
                    if ($1 == "Suites:") sidx = nl
                }
                END { flush() }'
        else
            _tebian_apt_edit "$f" -v from="$from" -v to="$to" "$_TEBIAN_AWK_DEBIAN"'
                /^[ \t]*deb(-src)?[ \t]/ {
                    u = 2; if ($2 ~ /^\[/) { while (u <= NF && $u !~ /\]$/) u++; u++ }
                    sfx = u + 1
                    if (is_debian($u)) {
                        if ($sfx == from "-backports") { print "# " $0; next }
                        if ($sfx == from) $sfx = to
                        else if (index($sfx, from "-") == 1) $sfx = to substr($sfx, length(from) + 1)
                    }
                }
                { print }'
        fi
    done < <(_tebian_apt_files)
}

# Current Debian release codename of the configured sources (trixie,
# testing, ...), or empty
tebian_apt_suite() {
    local f
    while read -r f; do
        if [[ "$f" == *.sources ]]; then
            awk "$_TEBIAN_AWK_DEBIAN"'
                /^[ \t]*$/ { if (deb && suite) { print suite; exit } deb = 0; suite = "" }
                $1 == "URIs:" { for (i = 2; i <= NF; i++) if (is_debian($i)) deb = 1 }
                $1 == "Suites:" { suite = $2 }
                END { if (deb && suite) print suite }' "$f"
        else
            awk "$_TEBIAN_AWK_DEBIAN"'
                /^[ \t]*deb[ \t]/ {
                    u = 2; if ($2 ~ /^\[/) { while (u <= NF && $u !~ /\]$/) u++; u++ }
                    if (is_debian($u) && $(u+1) !~ /-/) { print $(u+1); exit }
                }' "$f"
        fi
    done < <(_tebian_apt_files) | head -1
}
