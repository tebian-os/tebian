#!/bin/bash
# ==============================================================================
# TEBIAN AI TOOLS
# Settings > More > Software > AI Tools. Installs AI coding tools from their
# publishers' official sources, and nowhere else.
#
#   tebian-ai-tools list            ids, in menu order
#   tebian-ai-tools name <id>       short name
#   tebian-ai-tools label <id>      menu text
#   tebian-ai-tools id-of <text>    id from a menu selection
#   tebian-ai-tools group <id>      app | terminal
#   tebian-ai-tools installed <id>  exit 0 if installed
#   tebian-ai-tools can-remove <id> exit 0 if Remove is safe to offer
#   tebian-ai-tools install <id>    shows what will happen and asks first
#   tebian-ai-tools update <id>
#   tebian-ai-tools remove <id>     keeps the user's sessions and settings
#   tebian-ai-tools run <id>
#
# WHY THE SOURCES ARE HARDCODED
# Fake install pages for AI tools are a live attack: a cloned page on a lookalike
# domain, bought to the top of search results, with one changed URL in the
# install command. So nothing here takes a URL from the user, the environment or
# a web page. Every source below was traced from the publisher's own docs or
# GitHub organisation. Change one only after doing the same.
#
# WHAT THE CHECKS DO AND DO NOT PROVE
# A pinned key proves the publisher signed it. A pinned host proves it came from
# the publisher's domain, which stops the lookalike attack but not a compromise
# of the publisher itself. The screen before each install says which one applies.
# ==============================================================================
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

# Inherited from whatever opened the terminal; sudo keeps the stricter mask, and
# root-owned repo files apt cannot read would break every later apt run.
umask 022

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
else
    source "$HOME/.local/bin/tebian-common"
fi

# From code.claude.com/docs/en/setup, which publishes this fingerprint
CLAUDE_KEY_URL="https://downloads.claude.ai/keys/claude-code.asc"
CLAUDE_KEY_FPR="31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE"
CLAUDE_KEYRING="/etc/apt/keyrings/claude-code.asc"
CLAUDE_LIST="/etc/apt/sources.list.d/claude-code.list"
# The stable channel skips releases with major regressions
CLAUDE_DEB_LINE="deb [signed-by=$CLAUDE_KEYRING] https://downloads.claude.ai/claude-code/apt/stable stable main"

T3_RELEASES="https://github.com/pingdotgg/t3code/releases/latest/download"
# Where GitHub serves release files from after redirecting
GITHUB_HOSTS="github.com release-assets.githubusercontent.com objects.githubusercontent.com"

arch() { dpkg --print-architecture 2>/dev/null || echo unknown; }

tool_list() {
    case "$(arch)" in
        amd64|arm64) echo "t3 hermes claude codex grok opencode antigravity" ;;
        # Everything here publishes 64-bit builds only
        *) echo "" ;;
    esac
}

require_id() {
    case "${1:-}" in
        t3|hermes|claude|codex|grok|opencode|antigravity) return 0 ;;
    esac
    log_error "Unknown tool: ${1:-<none>} (expected one of: t3 hermes claude codex grok opencode antigravity)"
    exit 2
}

tool_name() {
    case "$1" in
        t3) echo "T3 Code" ;;
        hermes) echo "Hermes Desktop" ;;
        claude) echo "Claude Code" ;;
        codex) echo "Codex" ;;
        grok) echo "Grok Build" ;;
        opencode) echo "OpenCode" ;;
        antigravity) echo "Antigravity CLI" ;;
    esac
}

# The publisher is in the menu text on purpose: it is the fact a scam changes.
# id_of matches on the name, so a description must not mention another tool.
tool_label() {
    case "$1" in
        t3) echo "T3 Code - T3 Tools; runs your agents in one app" ;;
        hermes) echo "Hermes Desktop - Nous Research; builds from source" ;;
        claude) echo "Claude Code - Anthropic; signed apt repo" ;;
        codex) echo "Codex - OpenAI" ;;
        grok) echo "Grok Build - xAI" ;;
        opencode) echo "OpenCode - anomalyco; use any provider" ;;
        antigravity) echo "Antigravity CLI - Google; replaces Gemini CLI" ;;
    esac
}

id_of() {
    case "$1" in
        *"T3 Code"*) echo t3 ;;
        *"Hermes Desktop"*) echo hermes ;;
        *"Claude Code"*) echo claude ;;
        *Codex*) echo codex ;;
        *"Grok Build"*) echo grok ;;
        *OpenCode*) echo opencode ;;
        *"Antigravity CLI"*) echo antigravity ;;
        *) return 1 ;;
    esac
}

tool_group() {
    case "$1" in
        t3|hermes) echo app ;;
        *) echo terminal ;;
    esac
}

tool_publisher() {
    case "$1" in
        t3) echo "T3 Tools (github.com/pingdotgg)" ;;
        hermes) echo "Nous Research (github.com/NousResearch)" ;;
        claude) echo "Anthropic" ;;
        codex) echo "OpenAI" ;;
        grok) echo "xAI" ;;
        opencode) echo "anomalyco (github.com/anomalyco)" ;;
        antigravity) echo "Google (github.com/google-antigravity)" ;;
    esac
}

tool_docs() {
    case "$1" in
        t3) echo "https://github.com/pingdotgg/t3code/releases" ;;
        hermes) echo "https://hermes-agent.nousresearch.com/docs/getting-started/installation" ;;
        claude) echo "https://code.claude.com/docs/en/setup" ;;
        codex) echo "https://developers.openai.com/codex/cli" ;;
        grok) echo "https://x.ai/cli" ;;
        opencode) echo "https://opencode.ai/docs" ;;
        antigravity) echo "https://antigravity.google/docs/cli/overview" ;;
    esac
}

tool_source() {
    case "$1" in
        t3) echo "$T3_RELEASES" ;;
        hermes) echo "https://hermes-agent.nousresearch.com/install.sh" ;;
        claude) echo "https://downloads.claude.ai/claude-code/apt/stable" ;;
        codex) echo "https://chatgpt.com/codex/install.sh" ;;
        grok) echo "https://x.ai/cli/install.sh" ;;
        opencode) echo "https://opencode.ai/v2/install" ;;
        antigravity) echo "https://antigravity.google/cli/install.sh" ;;
    esac
}

# Domains a script may finally be served from, after any redirect
script_hosts() {
    case "$1" in
        hermes) echo "hermes-agent.nousresearch.com" ;;
        codex) echo "chatgpt.com releases.openai.com" ;;
        grok) echo "x.ai" ;;
        opencode) echo "opencode.ai" ;;
        antigravity) echo "antigravity.google" ;;
    esac
}

tool_check() {
    case "$1" in
        t3) echo "Checksum and publisher name from the project's own release. Catches a bad or swapped download, not a compromised project." ;;
        hermes) echo "Official domain only. The script pins checksums for the tools it bootstraps." ;;
        claude) echo "Signed by Anthropic. Tebian checks the key's fingerprint; apt checks every package." ;;
        codex) echo "Official domain only. The script checks its download against OpenAI's checksums." ;;
        grok) echo "Official domain only. The script has no further checks of its own." ;;
        opencode) echo "Official domain only. The script has no further checks of its own." ;;
        antigravity) echo "Official domain only. The script checks its download against a SHA-512 from Google's update service." ;;
    esac
}

tool_changes() {
    case "$1" in
        t3) echo "Installs the t3code package (/opt)." ;;
        hermes) echo "Installs Debian's build tools, clones to ~/.hermes, adds ~/.local/bin/hermes, and downloads Python, Node.js, a Chromium and a computer-control driver. Takes 10+ minutes and several GB." ;;
        claude) echo "Adds Anthropic's apt repo and key, and installs claude-code. Updates arrive with System Update." ;;
        codex) echo "Installs to ~/.codex and ~/.local/bin." ;;
        grok) echo "Installs to ~/.grok and edits ~/.bashrc (keeps a backup)." ;;
        opencode) echo "Installs to ~/.opencode and edits ~/.bashrc." ;;
        antigravity) echo "Installs agy to ~/.local/bin." ;;
    esac
}

tool_data() {
    case "$1" in
        t3) echo "Controls the agents you sign in to; sends nothing itself without one." ;;
        hermes|opencode) echo "Your prompts and code go to whichever provider you configure." ;;
        claude) echo "Your prompts and code go to Anthropic." ;;
        codex) echo "Your prompts and code go to OpenAI." ;;
        grok) echo "Your prompts and code go to xAI." ;;
        antigravity) echo "Your prompts and code go to Google." ;;
    esac
}

tool_next_step() {
    case "$1" in
        t3) echo "Needs at least one signed-in agent. Install one from this menu." ;;
        hermes) echo "Open it from Mod+D, or run: hermes desktop" ;;
        claude) echo "Sign in: claude auth login" ;;
        codex) echo "Sign in: codex login" ;;
        grok) echo "Sign in: grok login (open a new terminal first)" ;;
        opencode) echo "Sign in: opencode auth login (open a new terminal first)" ;;
        antigravity) echo "Start it with: agy (sign in with your Google account)" ;;
    esac
}

deb_installed() {
    [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" = "install ok installed" ]
}

# Installers put some tools on a PATH only new login shells see
tool_bin() {
    local cmd extra=""
    case "$1" in
        hermes) cmd=hermes ;;
        claude) cmd=claude ;;
        codex) cmd=codex ;;
        grok) cmd=grok; extra="$HOME/.grok/bin/grok" ;;
        opencode) cmd=opencode; extra="$HOME/.opencode/bin/opencode" ;;
        antigravity) cmd=agy ;;
        *) return 1 ;;
    esac
    if command -v "$cmd" 2>/dev/null; then
        return 0
    fi
    [ -n "$extra" ] && [ -x "$extra" ] && echo "$extra"
}

is_installed() {
    case "$1" in
        t3) deb_installed t3code ;;
        *) tool_bin "$1" >/dev/null ;;
    esac
}

# Offered only where the publisher documents removal or the package manager owns
# the files. Codex, Grok and Antigravity ship no uninstaller, and deleting paths observed by
# hand would be guesswork in a user's home directory.
can_remove() {
    case "$1" in
        t3) deb_installed t3code ;;
        claude) deb_installed claude-code ;;
        hermes) is_installed hermes ;;
        # Elsewhere means it did not come from the official script
        opencode) [ -x "$HOME/.opencode/bin/opencode" ] ;;
        *) return 1 ;;
    esac
}

# Shows where it comes from before anything runs. Reading from stdin means no
# terminal answers "no", so nothing ever installs unattended.
review() {
    local id="$1" script="${2:-}" answer name
    name=$(tool_name "$id")
    echo "========================================="
    echo "  Install $name"
    echo "========================================="
    echo ""
    echo "  Publisher:  $(tool_publisher "$id")"
    echo "  Source:     $(tool_source "$id")"
    echo "  Docs:       $(tool_docs "$id")"
    echo "  Checks:     $(tool_check "$id")"
    echo "  Changes:    $(tool_changes "$id")"
    echo "  Your data:  $(tool_data "$id")"
    if [ -n "$script" ]; then
        echo "  Script:     sha256 $(sha256sum "$script" | cut -d' ' -f1)"
        echo "              $(wc -l < "$script") lines, saved locally and not run yet"
    fi
    echo ""
    echo "  Tebian installs $name only from the source above."
    echo "  Treat any other download page for it as fake."
    if [ "$id" = hermes ]; then
        # Their docs: "Linux desktop packaging is disabled in the release workflow"
        echo "  Nous publishes no Linux desktop package: on Linux it is always built"
        echo "  locally. A site offering a Hermes .deb or AppImage is not official."
    fi
    echo ""
    while true; do
        if [ -n "$script" ]; then
            read -r -p "Continue? [y]es, [r]ead the script, [N]o: " answer || answer=n
        else
            read -r -p "Continue? [y]es, [N]o: " answer || answer=n
        fi
        case "$answer" in
            y|Y|yes) return 0 ;;
            r|R)
                if [ -n "$script" ]; then
                    "${PAGER:-less}" "$script" || cat "$script"
                fi
                ;;
            *)
                echo "Cancelled. Nothing was installed."
                return 1
                ;;
        esac
    done
}

# Saved first, never piped: piping would run it before anyone could read it, and
# a dropped connection could run half of it.
fetch_script() {
    local id="$1" out="$2" url final host allowed
    url=$(tool_source "$id")
    allowed=$(script_hosts "$id")
    final=$(curl --proto '=https' --proto-redir '=https' --tlsv1.2 --max-redirs 3 \
                 -fsSL -o "$out" -w '%{url_effective}' "$url") || {
        log_error "Could not download $url"
        return 1
    }
    host=${final#https://}
    host=${host%%/*}
    case " $allowed " in
        *" $host "*) ;;
        *)
            log_error "$url was served from $host, which is not an official host. Stopping."
            return 1
            ;;
    esac
    # An error page saved to disk must not get as far as a shell
    if [ "$(head -c 2 "$out")" != '#!' ]; then
        log_error "$url did not return a script. Stopping."
        return 1
    fi
}

terminal_stdin() {
    if ( : </dev/tty ) 2>/dev/null; then
        echo /dev/tty
    else
        echo /dev/null
    fi
}

# Always as the user: these install under $HOME, and a vendor script that needs
# root asks for it in the open.
install_script() {
    local id="$1" interpreter="$2" work rc=0 input
    shift 2
    work=$(mktemp -d)
    if fetch_script "$id" "$work/install.sh" && review "$id" "$work/install.sh"; then
        input=$(terminal_stdin)
        ( cd "$work" && "$interpreter" "$work/install.sh" "$@" < "$input" ) || rc=$?
    else
        rc=1
    fi
    rm -rf "$work"
    return "$rc"
}

install_claude() {
    review claude || return 1
    sudo apt-get update || log_warn "Package lists could not all be refreshed; trying anyway."
    sudo apt-get install -y gnupg curl ca-certificates || return 1
    local added=false
    if ! grep -rqs "downloads.claude.ai" /etc/apt/sources.list /etc/apt/sources.list.d/; then
        tebian_apt_repo_add "$CLAUDE_KEY_URL" "$CLAUDE_KEY_FPR" "$CLAUDE_KEYRING" "$CLAUDE_LIST" "$CLAUDE_DEB_LINE" || return 1
        added=true
    fi
    if ! { sudo apt-get update && sudo apt-get install -y claude-code; }; then
        if [ "$added" = true ]; then
            claude_drop_repo
            sudo apt-get update >/dev/null 2>&1 || true
        fi
        return 1
    fi
}

claude_drop_repo() {
    sudo rm -f "$CLAUDE_LIST" "$CLAUDE_KEYRING"
}

# The filename comes from the release's own metadata, so it is held to a strict
# shape before it goes near a URL or a path. T3 publishes no signature for the
# .deb; its sha512 in that metadata is the strongest check available.
fetch_t3_deb() {
    local work="$1" yml name want got final host
    case "$(arch)" in
        amd64) yml="latest-linux.yml" ;;
        arm64) yml="latest-linux-arm64.yml" ;;
        *) return 1 ;;
    esac

    final=$(curl --proto '=https' --proto-redir '=https' --tlsv1.2 --max-redirs 5 \
                 -fsSL -o "$work/release.yml" -w '%{url_effective}' "$T3_RELEASES/$yml") || {
        log_error "Could not read T3 Code's release information."
        return 1
    }
    host=${final#https://}; host=${host%%/*}
    case " $GITHUB_HOSTS " in
        *" $host "*) ;;
        *) log_error "Release information came from $host, not GitHub. Stopping."; return 1 ;;
    esac

    name=$(sed -n 's/^ *- url: \(T3-Code-[0-9A-Za-z.-]*\.deb\)$/\1/p' "$work/release.yml" | head -1)
    if ! [[ "$name" =~ ^T3-Code-[0-9][0-9A-Za-z.-]*-(amd64|arm64)\.deb$ ]]; then
        log_error "T3 Code's release information did not name a .deb."
        return 1
    fi
    want=$(grep -A1 -F "url: $name" "$work/release.yml" | sed -n 's/^ *sha512: //p' | head -1)
    if [ -z "$want" ]; then
        log_error "T3 Code's release information has no checksum for $name."
        return 1
    fi

    echo "Downloading $name..."
    final=$(curl --proto '=https' --proto-redir '=https' --tlsv1.2 --max-redirs 5 \
                 -fsSL -o "$work/t3code.deb" -w '%{url_effective}' "$T3_RELEASES/$name") || {
        log_error "Could not download $name."
        return 1
    }
    host=${final#https://}; host=${host%%/*}
    case " $GITHUB_HOSTS " in
        *" $host "*) ;;
        *) log_error "$name came from $host, not GitHub. Stopping."; return 1 ;;
    esac

    # The release metadata stores it base64-encoded; sha512sum prints hex
    got=$(sha512sum "$work/t3code.deb" | cut -d' ' -f1)
    want=$(base64 -d <<< "$want" | od -An -v -tx1 | tr -d ' \n')
    if [ "$got" != "$want" ]; then
        log_error "T3 Code's download does not match its published checksum. Stopping."
        return 1
    fi
    echo "  Checksum matches."

    if [ "$(dpkg-deb -f "$work/t3code.deb" Package)" != t3code ] ||
       [[ "$(dpkg-deb -f "$work/t3code.deb" Maintainer)" != *"<hello@t3.codes>"* ]]; then
        log_error "That package does not name T3 Tools as its publisher. Stopping."
        return 1
    fi
}

install_t3() {
    local work rc=0
    review t3 || return 1
    work=$(mktemp -d)
    # apt's sandbox user has to be able to read the file
    chmod 755 "$work"
    if fetch_t3_deb "$work"; then
        sudo apt-get install -y "$work/t3code.deb" || rc=$?
    else
        rc=1
    fi
    rm -rf "$work"
    return "$rc"
}

# A minimal Debian has no compiler, and the desktop build compiles node-pty; the
# official script assumes one and fails near the end. The libraries are what the
# Electron app and the optional cua-driver link against.
install_hermes() {
    local work rc=0 input pkg policy
    local -a flags=(--include-desktop) wanted available=()
    wanted=(git build-essential python3 xz-utils libgtk-3-0t64 libnss3 libasound2t64
            libgbm1 libnotify4 libsecret-1-0 libxss1 libxtst6 libxi6)
    work=$(mktemp -d)
    if ! { fetch_script hermes "$work/install.sh" && review hermes "$work/install.sh"; }; then
        rm -rf "$work"
        return 1
    fi

    sudo apt-get update || log_warn "Package lists could not all be refreshed; trying anyway."
    # apt refuses the whole list over one unknown name, and these are renamed
    # between releases
    for pkg in "${wanted[@]}"; do
        # Held in a variable: under pipefail, "apt-cache | grep -q" reports
        # failure when grep exits early, and every package would look missing
        policy=$(apt-cache policy "$pkg" 2>/dev/null || true)
        if [[ "$policy" == *"Candidate: "* && "$policy" != *"Candidate: (none)"* ]]; then
            available+=("$pkg")
        fi
    done
    if [ "${#available[@]}" -eq 0 ] || ! sudo apt-get install -y "${available[@]}"; then
        log_error "Could not install what Hermes needs to build."
        rm -rf "$work"
        return 1
    fi

    input=$(terminal_stdin)
    [ "$input" = /dev/tty ] || flags+=(--non-interactive)
    ( cd "$work" && bash "$work/install.sh" "${flags[@]}" < "$input" ) || rc=$?
    rm -rf "$work"
    return "$rc"
}

do_install() {
    local id="$1" name rc=0
    name=$(tool_name "$id")

    case "$(arch)" in
        amd64|arm64) ;;
        *) log_error "$name has no build for this system ($(arch))."; return 1 ;;
    esac

    if is_installed "$id"; then
        echo "$name is already installed."
        return 0
    fi

    case "$id" in
        t3) install_t3 || rc=$? ;;
        hermes) install_hermes || rc=$? ;;
        claude) install_claude || rc=$? ;;
        # Its "Start Codex now?" question belongs to a later step
        codex) CODEX_NON_INTERACTIVE=1 install_script codex sh || rc=$? ;;
        grok) install_script grok bash || rc=$? ;;
        opencode) install_script opencode bash || rc=$? ;;
        antigravity) install_script antigravity bash || rc=$? ;;
    esac

    if [ "$rc" -ne 0 ]; then
        echo ""
        # Hermes can fail at the desktop build with its command already working
        if is_installed "$id"; then
            log_error "$name only partly installed; see the output above."
        else
            log_error "$name was not installed."
        fi
        echo "  Official instructions: $(tool_docs "$id")"
        return 1
    fi
    if ! is_installed "$id"; then
        log_error "$name did not end up installed; see the output above."
        echo "  Official instructions: $(tool_docs "$id")"
        return 1
    fi

    case "$id" in
        t3) tebian_pin_app t3code.desktop ;;
        hermes) tebian_pin_app hermes.desktop ;;
    esac

    echo ""
    echo "$name is installed."
    echo "  $(tool_next_step "$id")"
}

do_update() {
    local id="$1" name bin
    name=$(tool_name "$id")
    if ! is_installed "$id"; then
        echo "$name is not installed."
        return 0
    fi
    bin=$(tool_bin "$id" || true)
    case "$id" in
        t3)
            # Moving someone from a nightly to a release is a downgrade
            if [[ "$(dpkg-query -W -f='${Version}' t3code)" == *nightly* ]]; then
                echo "This is a nightly build of T3 Code, so it is left alone."
                return 0
            fi
            install_t3
            ;;
        claude)
            if deb_installed claude-code; then
                sudo apt-get update || log_warn "Package lists could not all be refreshed; trying anyway."
                sudo apt-get install -y --only-upgrade claude-code
            else
                "$bin" update
            fi
            ;;
        hermes|codex|grok|antigravity) "$bin" update ;;
        opencode) "$bin" upgrade ;;
    esac
}

do_remove() {
    local id="$1" name bin
    name=$(tool_name "$id")
    if ! is_installed "$id"; then
        echo "$name is not installed."
        return 0
    fi
    if ! can_remove "$id"; then
        echo "$name has no uninstaller, or was installed outside this menu."
        echo "  See the official instructions: $(tool_docs "$id")"
        return 1
    fi
    bin=$(tool_bin "$id" || true)
    case "$id" in
        t3) sudo apt-get remove -y t3code ;;
        claude)
            sudo apt-get remove -y claude-code
            claude_drop_repo
            ;;
        hermes) "$bin" uninstall ;;
        opencode)
            # Its uninstaller keeps user data but stops short of the program,
            # printing an rm for the user to run. --force because the choice
            # was already made in the menu, and a "no" must not reach the rm.
            "$bin" uninstall --force
            rm -f "$HOME/.opencode/bin/opencode" "$HOME/.opencode/bin/opencode2"
            rmdir "$HOME/.opencode/bin" "$HOME/.opencode" 2>/dev/null || true
            ;;
    esac
    if is_installed "$id"; then
        echo "$name is still installed."
        return 1
    fi
    echo "$name removed. Sessions and settings in your home folder were kept unless you chose otherwise."
}

launch_app() {
    # Through the compositor, like tebian-menu, so the app outlives this process
    if ! swaymsg exec -- "$1" &>/dev/null; then
        setsid -f sh -c "$1" &>/dev/null 9>&-
    fi
}

do_run() {
    local id="$1" bin exec_line
    bin=$(tool_bin "$id" || true)
    case "$id" in
        t3)
            exec_line=$(grep -m1 '^Exec=' /usr/share/applications/t3code.desktop | cut -d= -f2- | sed 's/ %[fFuU]//')
            launch_app "$exec_line"
            ;;
        hermes) launch_app "$bin desktop" ;;
        *)
            cd "$HOME"
            exec "$bin"
            ;;
    esac
}

case "${1:-}" in
    list) tool_list ;;
    name) require_id "${2:-}"; tool_name "$2" ;;
    label) require_id "${2:-}"; tool_label "$2" ;;
    id-of) id_of "${2:-}" ;;
    group) require_id "${2:-}"; tool_group "$2" ;;
    installed) require_id "${2:-}"; is_installed "$2" ;;
    can-remove) require_id "${2:-}"; can_remove "$2" ;;
    install) require_id "${2:-}"; do_install "$2" ;;
    update) require_id "${2:-}"; do_update "$2" ;;
    remove) require_id "${2:-}"; do_remove "$2" ;;
    run) require_id "${2:-}"; do_run "$2" ;;
    *)
        sed -n '3,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
