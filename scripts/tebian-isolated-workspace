#!/bin/bash
# ==============================================================================
# TEBIAN ISOLATED WORKSPACE
# Whonix-style gateway + workstation VMs via libvirt/QEMU
# Gateway VM runs Tor, workstation can ONLY reach internet through gateway.
# Usage: tebian-isolated-workspace [setup|start|stop|destroy|status]
# ==============================================================================

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[workspace]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[workspace]${NC} $1"; }
log_error() { echo -e "${RED}[workspace]${NC} $1" >&2; }

ACTION="${1:-status}"
WORKSPACE_DIR="$HOME/.local/share/tebian-workspace"
GW_NAME="tebian-gateway"
WS_NAME="tebian-workstation"
NET_NAME="tebian-isolated"
GW_IP="10.66.0.1"
WS_IP="10.66.0.2"

ensure_kvm() {
    if ! command -v virsh &>/dev/null; then
        log_info "Installing KVM/QEMU/libvirt..."
        sudo apt update
        sudo apt install -y qemu-system-x86 qemu-utils libvirt-daemon-system virtinst bridge-utils
        sudo adduser "$USER" libvirt 2>/dev/null || true
        sudo adduser "$USER" kvm 2>/dev/null || true
        sudo systemctl enable --now libvirtd
    fi
    if ! command -v virt-install &>/dev/null; then
        sudo apt install -y virtinst
    fi
}

# The gateway's external NIC rides libvirt's built-in 'default' NAT network for
# its internet uplink. On a fresh libvirt install that network exists but is
# inactive and not autostarted, so the gateway VM would fail to start with
# "network 'default' is not active". Make sure it's up and stays up.
ensure_default_network() {
    if ! virsh net-info default &>/dev/null; then
        log_warn "libvirt 'default' network missing — the gateway needs it for internet."
        log_warn "Recreate it with: virsh net-define /usr/share/libvirt/networks/default.xml"
        return
    fi
    virsh net-start default 2>/dev/null || true       # no-op if already active
    virsh net-autostart default 2>/dev/null || true
    log_info "Default NAT network active (gateway uplink)"
}

create_isolated_network() {
    if virsh net-info "$NET_NAME" &>/dev/null; then
        log_info "Isolated network already exists"
        return
    fi

    log_info "Creating isolated network ($NET_NAME)..."
    # TRUE isolation: no <forward> (can't reach the LAN/internet) and, crucially,
    # NO <ip>/<dhcp>. Giving a libvirt network an <ip> puts the HOST on the bridge
    # at that address and runs host dnsmasq — which would (a) collide with the
    # gateway VM's 10.66.0.1 and (b) hand the workstation the HOST as its router,
    # bypassing Tor entirely. Without <ip> this is a pure L2 switch the host is
    # not on: the only route off it is through the gateway VM. Addressing/DHCP is
    # provided by the gateway VM itself (see gateway-setup.sh).
    cat <<EOF > "$WORKSPACE_DIR/isolated-net.xml"
<network>
  <name>$NET_NAME</name>
  <bridge name="virbr-tebian" stp="on" delay="0"/>
</network>
EOF
    virsh net-define "$WORKSPACE_DIR/isolated-net.xml"
    virsh net-start "$NET_NAME"
    virsh net-autostart "$NET_NAME"
    log_info "Isolated network created (L2-only, host not present)"
}

build_gateway_image() {
    local img="$WORKSPACE_DIR/gateway.qcow2"
    if [ -f "$img" ]; then
        log_info "Gateway image already exists"
        return
    fi

    log_info "Building gateway VM image..."
    qemu-img create -f qcow2 "$img" 4G

    # Create gateway setup script (runs once inside the gateway VM after install)
    cat <<'GWSCRIPT' > "$WORKSPACE_DIR/gateway-setup.sh"
#!/bin/bash
# ==============================================================================
# Tebian gateway setup — run once inside the gateway VM (as root)
# Turns this VM into a Whonix-style Tor gateway:
#   EXTERNAL nic (default route, NAT'd to the internet)  -> Tor's uplink
#   INTERNAL nic (isolated segment, faces the workstation) -> 10.66.0.1
# The workstation gets its address/route/DNS from THIS VM (dnsmasq below), so it
# can only reach the internet through Tor. Fail-closed: if Tor is down, nothing
# leaks — FORWARD defaults to DROP and non-Tor traffic is never forwarded.
# ==============================================================================
set -euo pipefail

GW_ADDR="10.66.0.1"
GW_CIDR="10.66.0.1/24"

# --- Identify the two interfaces ---------------------------------------------
# External = whichever carries the default route (DHCP'd from libvirt's NAT net).
# Internal = the other wired interface (the isolated segment, no DHCP yet).
EXT_IF=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
if [ -z "$EXT_IF" ]; then
    echo "ERROR: no default route — is the external NIC up? Aborting." >&2
    exit 1
fi
INT_IF=$(for i in /sys/class/net/*; do n=$(basename "$i"); \
    [ "$n" = "lo" ] && continue; [ "$n" = "$EXT_IF" ] && continue; \
    case "$n" in en*|eth*) echo "$n"; break;; esac; done)
if [ -z "$INT_IF" ]; then
    echo "ERROR: could not find the internal (isolated) NIC. Aborting." >&2
    exit 1
fi
echo "External (internet) NIC: $EXT_IF"
echo "Internal (workstation) NIC: $INT_IF -> $GW_ADDR"

# --- Static address on the internal NIC (persist via ifupdown) ---------------
cat > /etc/network/interfaces.d/tebian-isolated <<IFACE
auto $INT_IF
iface $INT_IF inet static
    address $GW_CIDR
IFACE
ip addr replace "$GW_CIDR" dev "$INT_IF"
ip link set "$INT_IF" up

apt-get update
apt-get install -y tor dnsmasq iptables iptables-persistent

# --- Tor transparent proxy (bound to the internal IP only) -------------------
cat > /etc/tor/torrc.d/tebian-gateway.conf <<TORCONF
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1
TransPort ${GW_ADDR}:9040
DNSPort ${GW_ADDR}:5353
TORCONF
grep -q '^%include /etc/tor/torrc.d' /etc/tor/torrc || echo '%include /etc/tor/torrc.d/*.conf' >> /etc/tor/torrc
systemctl enable tor
systemctl restart tor

# --- dnsmasq: DHCP-only for the workstation (DNS disabled; Tor handles DNS) ---
cat > /etc/dnsmasq.d/tebian-isolated.conf <<DNSMASQ
interface=$INT_IF
bind-interfaces
port=0
dhcp-range=10.66.0.10,10.66.0.50,255.255.255.0,12h
dhcp-option=3,$GW_ADDR
dhcp-option=6,$GW_ADDR
DNSMASQ
systemctl enable dnsmasq
systemctl restart dnsmasq

# --- Firewall: redirect the workstation's traffic into Tor, fail closed ------
iptables -F
iptables -t nat -F
# The workstation's DNS and TCP get REDIRECTed into Tor locally on this VM.
iptables -t nat -A PREROUTING -i "$INT_IF" -p udp --dport 53 -j REDIRECT --to-ports 5353
iptables -t nat -A PREROUTING -i "$INT_IF" -p tcp --syn -j REDIRECT --to-ports 9040
# Nothing from the workstation is allowed to forward out untouched — this is the
# leak guard. Only established replies flow back; raw eth->eth forwarding is denied.
iptables -P FORWARD DROP
iptables -A FORWARD -i "$EXT_IF" -o "$INT_IF" -m state --state ESTABLISHED,RELATED -j ACCEPT
# Tor itself (running on this VM) reaches the internet via the OUTPUT chain on EXT_IF.
netfilter-persistent save

echo ""
echo "Gateway ready. Start the workstation VM — it will DHCP from $GW_ADDR and"
echo "route all traffic through Tor. Verify inside the workstation with:"
echo "    curl https://check.torproject.org/api/ip   (should report IsTor:true)"
GWSCRIPT
    chmod +x "$WORKSPACE_DIR/gateway-setup.sh"
    log_info "Gateway image created (4GB)"
}

build_workstation_image() {
    local img="$WORKSPACE_DIR/workstation.qcow2"
    if [ -f "$img" ]; then
        log_info "Workstation image already exists"
        return
    fi

    log_info "Building workstation VM image..."
    qemu-img create -f qcow2 "$img" 20G
    log_info "Workstation image created (20GB)"
}

setup_workspace() {
    log_info "Setting up Tebian Isolated Workspace..."
    echo ""
    log_warn "This creates two VMs:"
    echo "  Gateway    — Minimal Debian, runs Tor, routes traffic"
    echo "  Workstation — Your workspace, can ONLY reach internet through Gateway"
    echo ""
    log_warn "Requirements: ~25GB disk, ~2GB RAM"
    echo ""

    ensure_kvm
    mkdir -p "$WORKSPACE_DIR"

    # Check for Debian ISO
    local iso="$WORKSPACE_DIR/debian-netinst.iso"
    if [ ! -f "$iso" ]; then
        log_info "Downloading Debian netinst ISO..."
        local arch iso_url
        arch=$(dpkg --print-architecture)
        # Resolve the current point-release filename from the directory listing —
        # a hardcoded version 404s the moment Debian ships the next point release
        local iso_dir="https://cdimage.debian.org/debian-cd/current/${arch}/iso-cd/"
        local iso_name
        iso_name=$(curl -fsSL "$iso_dir" 2>/dev/null | grep -oE "debian-[0-9.]+-${arch}-netinst\.iso" | head -1)
        iso_url="${iso_dir}${iso_name:-debian-${arch}-netinst.iso}"
        curl -fSL "$iso_url" -o "$iso" || {
            log_error "Failed to download Debian ISO."
            echo "Download manually and place at: $iso"
            return 1
        }
    fi

    # Create network and disk images
    ensure_default_network
    create_isolated_network
    build_gateway_image
    build_workstation_image

    # Define Gateway VM
    if ! virsh dominfo "$GW_NAME" &>/dev/null; then
        log_info "Defining gateway VM..."
        virt-install \
            --name "$GW_NAME" \
            --ram 512 \
            --vcpus 1 \
            --disk path="$WORKSPACE_DIR/gateway.qcow2",format=qcow2 \
            --cdrom "$iso" \
            --os-variant debian12 \
            --network network=default \
            --network network="$NET_NAME" \
            --graphics spice \
            --noautoconsole \
            --print-xml > "$WORKSPACE_DIR/gateway-vm.xml"
        virsh define "$WORKSPACE_DIR/gateway-vm.xml"
        log_info "Gateway VM defined"
    fi

    # Define Workstation VM
    if ! virsh dominfo "$WS_NAME" &>/dev/null; then
        log_info "Defining workstation VM..."
        virt-install \
            --name "$WS_NAME" \
            --ram 2048 \
            --vcpus 2 \
            --disk path="$WORKSPACE_DIR/workstation.qcow2",format=qcow2 \
            --cdrom "$iso" \
            --os-variant debian12 \
            --network network="$NET_NAME" \
            --graphics spice \
            --noautoconsole \
            --print-xml > "$WORKSPACE_DIR/workstation-vm.xml"
        virsh define "$WORKSPACE_DIR/workstation-vm.xml"
        log_info "Workstation VM defined"
    fi

    echo ""
    log_info "Setup complete!"
    echo ""
    echo "  Next steps:"
    echo "  1. Start Gateway:     tebian-isolated-workspace start"
    echo "  2. Install Debian on the Gateway VM (minimal, no desktop)."
    echo "     During install let the FIRST (internet) NIC use DHCP; leave the"
    echo "     second (isolated) NIC unconfigured — the setup script addresses it."
    echo "  3. Copy in and run gateway-setup.sh inside the Gateway VM (as root)."
    echo "  4. Install Debian on the Workstation VM (with desktop). Its single NIC"
    echo "     should use DHCP — it will lease from the gateway automatically."
    echo "  5. All workstation traffic then routes through Tor (fail-closed)."
    echo ""
    echo "  Gateway setup script: $WORKSPACE_DIR/gateway-setup.sh"
    echo ""
    echo "  Architecture:"
    echo "  ┌──────────────┐     ┌──────────────┐     ┌─────────┐"
    echo "  │ Workstation  │────▶│   Gateway     │────▶│   Tor   │──▶ Internet"
    echo "  │ (your work)  │     │ (Tor proxy)   │     │ Network │"
    echo "  └──────────────┘     └──────────────┘     └─────────┘"
    echo "   DHCP 10.66.0.x       $GW_IP (internal)"
    echo "   isolated net only    isolated + NAT net"
    echo ""
    echo "  Verify (inside workstation): curl https://check.torproject.org/api/ip"
    echo ""
}

start_workspace() {
    log_info "Starting Isolated Workspace..."

    # Start networks — both the isolated segment AND the default NAT net the
    # gateway uses for its uplink (either may be down after a host reboot)
    ensure_default_network
    virsh net-start "$NET_NAME" 2>/dev/null || true

    # Start gateway first
    if virsh dominfo "$GW_NAME" &>/dev/null; then
        virsh start "$GW_NAME" 2>/dev/null && log_info "Gateway started" || log_info "Gateway already running"
    else
        log_error "Gateway VM not found. Run: tebian-isolated-workspace setup"
        return 1
    fi

    # Wait for gateway to boot
    log_info "Waiting for gateway to initialize..."
    sleep 5

    # Start workstation
    if virsh dominfo "$WS_NAME" &>/dev/null; then
        virsh start "$WS_NAME" 2>/dev/null && log_info "Workstation started" || log_info "Workstation already running"
    else
        log_error "Workstation VM not found. Run: tebian-isolated-workspace setup"
        return 1
    fi

    echo ""
    log_info "Workspace running!"
    echo "  Open virt-manager to access the VMs"
    echo "  Or: virt-viewer $WS_NAME"
}

stop_workspace() {
    log_info "Stopping Isolated Workspace..."

    if virsh dominfo "$WS_NAME" &>/dev/null; then
        virsh shutdown "$WS_NAME" 2>/dev/null && log_info "Workstation shutting down" || true
    fi

    if virsh dominfo "$GW_NAME" &>/dev/null; then
        virsh shutdown "$GW_NAME" 2>/dev/null && log_info "Gateway shutting down" || true
    fi

    log_info "Workspace stopped"
}

destroy_workspace() {
    log_warn "This will DELETE both VMs and all data inside them."
    read -p "Are you sure? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        return
    fi

    log_info "Destroying Isolated Workspace..."

    # Stop VMs
    virsh destroy "$WS_NAME" 2>/dev/null || true
    virsh destroy "$GW_NAME" 2>/dev/null || true

    # Undefine VMs
    virsh undefine "$WS_NAME" --remove-all-storage 2>/dev/null || true
    virsh undefine "$GW_NAME" --remove-all-storage 2>/dev/null || true

    # Remove network
    virsh net-destroy "$NET_NAME" 2>/dev/null || true
    virsh net-undefine "$NET_NAME" 2>/dev/null || true

    # Clean up files
    rm -rf "$WORKSPACE_DIR"

    log_info "Workspace destroyed — all traces removed"
}

show_status() {
    echo ""
    echo "  ┌─────────────────────────────┐"
    echo "  │  ISOLATED WORKSPACE STATUS  │"
    echo "  └─────────────────────────────┘"
    echo ""

    if [ ! -d "$WORKSPACE_DIR" ]; then
        echo "  Not set up. Run: tebian-isolated-workspace setup"
        return
    fi

    # Network
    if virsh net-info "$NET_NAME" &>/dev/null; then
        local net_state
        net_state=$(virsh net-info "$NET_NAME" 2>/dev/null | grep "Active:" | awk '{print $2}')
        echo "  Network:     $NET_NAME ($net_state)"
    else
        echo "  Network:     not defined"
    fi

    # Gateway
    if virsh dominfo "$GW_NAME" &>/dev/null; then
        local gw_state
        gw_state=$(virsh domstate "$GW_NAME" 2>/dev/null)
        echo "  Gateway:     $GW_NAME ($gw_state)"
    else
        echo "  Gateway:     not defined"
    fi

    # Workstation
    if virsh dominfo "$WS_NAME" &>/dev/null; then
        local ws_state
        ws_state=$(virsh domstate "$WS_NAME" 2>/dev/null)
        echo "  Workstation: $WS_NAME ($ws_state)"
    else
        echo "  Workstation: not defined"
    fi

    echo ""
    echo "  Disk usage:  $(du -sh "$WORKSPACE_DIR" 2>/dev/null | cut -f1)"
    echo ""
}

case "$ACTION" in
    setup)   setup_workspace ;;
    start)   start_workspace ;;
    stop)    stop_workspace ;;
    destroy) destroy_workspace ;;
    status)  show_status ;;
    *)
        echo "Usage: tebian-isolated-workspace [setup|start|stop|destroy|status]"
        exit 1
        ;;
esac
