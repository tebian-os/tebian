#!/bin/bash
# Opens a Tebian menu as a drop-down from the bar (Waybar on-click actions).
# Usage: tebian-bar-menu <wifi|bluetooth|audio|screen|display|calendar|power|drives|update|settings|launcher> [left]
# The anchor follows the bar's edge (TEBIAN_BAR_POSITION, set by tebian-bar);
# tfuzzel picks it up from TEBIAN_MENU_ANCHOR, so every submenu opened from
# there drops down in the same place.
edge=top
[ "${TEBIAN_BAR_POSITION:-top}" = bottom ] && edge=bottom
side=right
[ "${2:-}" = left ] && side=left
export TEBIAN_MENU_ANCHOR="$edge-$side"

# Panels with a Quickshell drop-down (tebian-panels) open that; if the
# daemon isn't running (not installed, or Classic-era session) the fuzzel
# menu below is the fallback
case "${1:-}" in
    wifi)      tebian-panels toggle network && exit 0 ;;
    bluetooth) tebian-panels toggle bluetooth && exit 0 ;;
    audio)     tebian-panels toggle audio && exit 0 ;;
    power)     tebian-panels toggle power && exit 0 ;;
    screen|display) tebian-panels toggle display && exit 0 ;;
    calendar)  tebian-panels toggle calendar && exit 0 ;;
    drives)    tebian-panels toggle drives && exit 0 ;;
esac

# This month as a grid, for the calendar notification. cal comes with
# ncal, which a minimal install lacks: the notification then had a title
# and nothing under it.
month_view() {
    if command -v cal >/dev/null 2>&1; then
        cal
        return
    fi
    local first days dow d line
    first=$(date +%Y-%m-01)
    days=$(date -d "$first +1 month -1 day" +%-d)
    dow=$(date -d "$first" +%u)
    echo "Mo Tu We Th Fr Sa Su"
    line=$(printf '%*s' $(( (dow - 1) * 3 )) '')
    for ((d = 1; d <= days; d++)); do
        line+=$(printf '%2d ' "$d")
        if (( (dow - 1 + d) % 7 == 0 )); then
            echo "${line% }"
            line=""
        fi
    done
    [ -z "$line" ] || echo "${line% }"
}

case "${1:-settings}" in
    launcher) exec tebian-menu ;;
    display)  exec tebian-settings --menu screen ;;
    # No fuzzel calendar: a plain month view in a notification instead
    calendar) exec notify-send -a Calendar "$(date '+%A %d %B %Y')" "$(month_view 2>/dev/null)" ;;
    *)        exec tebian-settings --menu "${1:-settings}" ;;
esac
