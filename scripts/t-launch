#!/bin/bash
sleep 0.5

# Tebian "Smart Start" - Terminal Workspace Selector

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
elif [ -f "$HOME/.local/bin/tebian-common" ]; then
    source "$HOME/.local/bin/tebian-common"
fi

get_term() {
    # The terminal picked in Settings (config.user's "terminal" block),
    # then the base config's, then whatever is installed
    local t
    t=$(tebian_block_get terminal 2>/dev/null | awk '$1 == "set" && $2 == "$term" { print $3; exit }')
    [ -n "$t" ] || t=$(awk '/^set \$term[[:space:]]/ { print $3; exit }' ~/.config/sway/config 2>/dev/null)
    if [ -n "$t" ] && command -v "$t" &>/dev/null; then echo "$t"
    elif command -v kitty &>/dev/null; then echo "kitty"
    elif command -v foot &>/dev/null; then echo "foot"
    elif command -v alacritty &>/dev/null; then echo "alacritty"
    elif command -v xterm &>/dev/null; then echo "xterm"
    else echo "kitty"
    fi
}
TERM_APP=$(get_term)

# Root directory for our work
SESSIONS_DIR="$HOME/Sessions"
DATE=$(date +%Y-%m-%d)

# 1. Generate the list of options
OPTIONS="󰋜 Home
󰐊 New Daily Session
󰷊 Scratchpad
----------------"
RECENT_SESSIONS=$(find "$SESSIONS_DIR/Daily" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | sort -r | head -n 5)
PROJECTS=$(find "$SESSIONS_DIR/Projects" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null)

FULL_LIST=$(echo -e "$OPTIONS
$RECENT_SESSIONS
$PROJECTS")

# 2. Show the popup and get the choice
CHOICE=$(echo -e "$FULL_LIST" | tfuzzel -d)

# Esc/no selection — abort instead of falling through to a $HOME terminal
[ -z "$CHOICE" ] && exit 0

# 3. Logic for the choice. Matched on the words: Text Mode strips the
# glyph, and "Scratchpad" then fell through to the session lookup and
# opened $HOME instead.
case "${CHOICE#"${CHOICE%%[[:alnum:]-]*}"}" in
    "Home")
        TARGET="$HOME"
        ;;
    "New Daily Session")
        NAME=$(echo "" | tfuzzel -d)
        if [ -z "$NAME" ]; then exit 1; fi
        TARGET="$SESSIONS_DIR/Daily/$DATE-$NAME"
        mkdir -p "$TARGET"
        echo "# Session: $NAME ($DATE)" > "$TARGET/README.md"
        ;;
    "Scratchpad")
        TARGET="$SESSIONS_DIR/Scratchpad"
        ;;
    "----------------")
        exit 0
        ;;
    *)
        # Search if it's a Project or a Daily session
        if [ -d "$SESSIONS_DIR/Daily/$CHOICE" ]; then
            TARGET="$SESSIONS_DIR/Daily/$CHOICE"
        elif [ -d "$SESSIONS_DIR/Projects/$CHOICE" ]; then
            TARGET="$SESSIONS_DIR/Projects/$CHOICE"
        else
            TARGET="$HOME"
        fi
        ;;
esac

# 4. Launch terminal in that directory
# The folder goes in as an argument: names come from the user's folders,
# and one containing a quote broke the old "cd '$TARGET'" command
case "$TERM_APP" in
    kitty) kitty --directory "$TARGET" ;;
    foot|alacritty) "$TERM_APP" --working-directory "$TARGET" ;;
    gnome-terminal) gnome-terminal --working-directory="$TARGET" ;;
    *) "$TERM_APP" -e bash -c 'cd "$1" && exec bash' _ "$TARGET" ;;
esac
