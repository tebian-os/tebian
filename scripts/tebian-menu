#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"
# ==============================================================================
# TEBIAN MAIN MENU (Mod+D)
# Opens on the pinned apps and the system entries; typing searches every
# installed app. Pin/unpin from the App Drawer.
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
elif [ -f "$HOME/.local/bin/tebian-common" ]; then
    source "$HOME/.local/bin/tebian-common"
fi

PIN_FILE="$HOME/.config/tebian/pinned-apps.conf"

# Create default pins on first run
if [ ! -f "$PIN_FILE" ]; then
    mkdir -p "$HOME/.config/tebian"
    cat > "$PIN_FILE" << 'EOF'
helium.desktop
app.zen_browser.zen.desktop
t3code.desktop
hermes.desktop
firefox-esr.desktop
firefox.desktop
chromium.desktop
org.mozilla.firefox.desktop
kitty.desktop
thunar.desktop
code.desktop
EOF
fi

# Every launchable app, once, sorted by name. Split by hand, not with
# `IFS=$'\t' read`: that merges the tabs around an empty icon.
declare -A LABEL ICON
APP_IDS=()
while IFS= read -r line; do
    id="${line%%$'\t'*}"; rest="${line#*$'\t'}"
    LABEL[$id]="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    ICON[$id]="${rest%%$'\t'*}"
    APP_IDS+=("$id")
done < <(tebian_apps_labeled)

# The menu is built as two parallel lists: what fuzzel shows (ENTRY, ICONS)
# and what picking it does (ACTION). fuzzel --index returns the position, so
# nothing is matched on label text: an app called "Power Options" or a
# same-named app can't be mistaken for another entry.
ENTRY=() ICONS=() ACTION=()
add() { ENTRY+=("$1"); ICONS+=("$2"); ACTION+=("$3"); }

declare -A PINNED
while IFS= read -r id || [ -n "$id" ]; do
    # Hand-edited files may carry trailing spaces or a CR
    id="${id%"${id##*[![:space:]]}"}"
    [[ -z "$id" || "$id" == \#* ]] && continue
    [ -n "${LABEL[$id]+x}" ] || continue
    [ -n "${PINNED[$id]+x}" ] && continue
    PINNED[$id]=1
    add "${LABEL[$id]}" "${ICON[$id]}" "app:$id"
done < "$PIN_FILE"

# A base system has no browser, and the installer for one is otherwise four
# menus deep. Offer it here until there is one, then get out of the way.
if ! tebian-browser any-installed 2>/dev/null; then
    add "󰖟 Get a Web Browser" "" browser
fi

# System entries (always present — nerd font icons for consistent mono look)
add "󰀻 App Drawer" "" drawer
add "󰒓 System Settings" "" settings
add "󰐥 Power Options" "" power

# The menu opens at the size of everything above; the rest is only seen
# when typing filters it in
TOP=${#ENTRY[@]}

# Every other app, below the visible part
for id in "${APP_IDS[@]}"; do
    [ -n "${PINNED[$id]+x}" ] || add "${LABEL[$id]}" "${ICON[$id]}" "app:$id"
done

# --- SETTINGS SEARCH HOOK -----------------------------------------------------
# Every setting, after all the apps, so typing "time zone" or "printer" finds
# it too; picking one runs the "setting:*" branch below. --search-list reads
# one table and takes no lock, so an open Settings window is left alone.
# Read in one go and split on newlines (bash reads a pipe a byte at a time
# for read and mapfile), then appended whole-array, no icon; the action keeps
# "id<TAB>label", cut in the branch below. Four hundred lines handled one at
# a time added a noticeable pause to Mod+D.
settings_out=$(tebian-settings --search-list 2>/dev/null)
set -f; old_ifs=$IFS; IFS=$'\n'
# shellcheck disable=SC2206  # split on newlines on purpose, globbing off
SETTINGS=($settings_out)
IFS=$old_ifs; set +f
ENTRY+=("${SETTINGS[@]#*$'\t'}")
ICONS+=("${SETTINGS[@]/*/}")
ACTION+=("${SETTINGS[@]/#/setting:}")
# ------------------------------------------------------------------------------

LINES=$TOP
[ "$LINES" -gt 15 ] && LINES=15

# Printed straight into the pipe, never through a variable: the icon
# separator is a NUL, which bash variables drop (see tfuzzel). printf %s
# also keeps a backslash in an app's name from being read as an escape.
print_entries() {
    local i
    for i in "${!ENTRY[@]}"; do
        if [ -n "${ICONS[$i]}" ]; then
            printf '%s\0icon\x1f%s\n' "${ENTRY[$i]}" "${ICONS[$i]}"
        else
            printf '%s\n' "${ENTRY[$i]}"
        fi
    done
}

PICK=$(print_entries | tfuzzel -d --index -p " 󰀻 Tebian | " --width 40 --lines "$LINES")

# Escape, or text typed that matched nothing
[[ "$PICK" =~ ^[0-9]+$ ]] && [ "$PICK" -lt "${#ACTION[@]}" ] || exit 0

case "${ACTION[$PICK]}" in
    browser)  tebian-settings --browser ;;
    drawer)   tebian-drawer & ;;
    settings) tebian-settings ;;
    power)    tebian-settings --power ;;
    app:*)
        tebian_app_launch "${ACTION[$PICK]#app:}" ||
            notify-send "Menu" "Could not start ${ENTRY[$PICK]}" 2>/dev/null
        ;;
    # SETTINGS SEARCH HOOK: entries added above land here
    setting:*)
        id="${ACTION[$PICK]#setting:}"
        tebian-settings --open "${id%%$'\t'*}" ;;
esac
exit 0
