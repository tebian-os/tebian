#!/bin/bash
# ==============================================================================
# TEBIAN INSTALLER (V1.0)
# Custom whiptail-based installer for Tebian OS
# Runs from the live session — installs to disk with dual-boot support
#
# Features: partitioning, optional LUKS encryption, debootstrap,
#           user creation, Desktop/Server mode, GRUB + os-prober
# ==============================================================================

set -euo pipefail

# ── Catppuccin Mocha whiptail theme ──
export NEWT_COLORS='
root=white,black
border=cyan,black
title=cyan,black
roottext=white,black
window=white,black
textbox=white,black
button=black,cyan
actbutton=white,blue
compactbutton=white,black
listbox=white,black
actlistbox=black,cyan
actsellistbox=black,cyan
checkbox=white,black
actcheckbox=black,cyan
entry=white,black
disentry=gray,black
emptyscale=black
fullscale=cyan
helpline=white,black
'

# ── Globals ──
TEBIAN_SRC="${TEBIAN_SRC:-/home/user/Tebian}"
TARGET="/mnt/tebian"
DISK=""
PARTITION_ROOT=""
PARTITION_EFI=""
PARTITION_BOOT=""       # separate /boot, only for encrypted installs
LUKS_PART=""            # raw partition under the LUKS mapping
ENCRYPT=false           # set once the disk plan has been applied
ENCRYPT_PLANNED=false   # user's choice, collected before partitioning
LUKS_PASS=""
PART_MODE=""            # erase | alongside | manual
SHRINK_PART=""
SHRINK_FSTYPE=""
SHRINK_TO_BYTES=0
MANUAL_FORMAT_EFI=false
AUTOLOGIN=false          # one-password encrypted desktop: skip greeter once per boot
CRYPT_NAME="tebian_crypt"
USERNAME=""
USERPASS=""
HOSTNAME_VAL="tebian"
MODE="desktop"  # desktop or server
IS_EFI=false
DEBIAN_VERSION="trixie"
DUAL_BOOT=false
KB_LAYOUT="us"
KB_VARIANT=""
TIMEZONE="UTC"
INSTALL_LOG="/tmp/tebian-install.log"

# Unattended mode: answers come from a KEY=VALUE file instead of dialogs.
# Used for automated VM testing; see load_answers.
AUTO=false
declare -A ANS=()

# ── UI helpers ──
WT_HEIGHT=18
WT_WIDTH=70
WT_MENU=10
WT_BACKTITLE="Tebian OS Installer | Minimal + Fast"

wt() {
    command whiptail --backtitle "$WT_BACKTITLE" "$@"
}

msg() {
    wt --title "  Tebian Installer" --msgbox "$1" $WT_HEIGHT $WT_WIDTH
}

yesno() {
    wt --title "  Tebian Installer" --yesno "$1" $WT_HEIGHT $WT_WIDTH
}

input() {
    wt --title "  Tebian Installer" --inputbox "$1" $WT_HEIGHT $WT_WIDTH "$2" 3>&1 1>&2 2>&3
}

password() {
    wt --title "  Tebian Installer" --passwordbox "$1" $WT_HEIGHT $WT_WIDTH 3>&1 1>&2 2>&3
}

progress() {
    wt --title "  Tebian Installer" --gauge "$1" 8 $WT_WIDTH 0
}

die() {
    echo "INSTALL_FAILED: $1" >> "$INSTALL_LOG"
    if $AUTO; then
        echo "ERROR: $1" >&2
        poweroff
    fi
    msg "ERROR: $1"
    exit 1
}

step_back() {
    msg "$1"
    return 1
}

# Unattended answers: KEY=VALUE lines, parsed (never sourced — it holds
# passwords and is read by root). Comes from --answers FILE, or from QEMU's
# fw_cfg (-fw_cfg name=opt/org.tebian/answers,file=...), which only a VM's
# host can set — so a stray file or USB stick can never start a wipe.
load_answers() {
    local file="$1" key val
    [ -r "$file" ] || die "Answers file not readable: $file"
    while IFS= read -r line || [ -n "$line" ]; do
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
        key="${line%%=*}" val="${line#*=}"
        [[ "$key" =~ ^[a-z_]+$ ]] || die "Answers file: bad line '$line'"
        ANS[$key]="$val"
    done < "$file"
    for key in disk username password; do
        [ -n "${ANS[$key]:-}" ] || die "Answers file: '$key' is required"
    done
    AUTO=true
}

# ── Step 1: Welcome ──
welcome() {
    $AUTO && return 0
    wt --title "  T E B I A N" --yesno "\
Welcome to Tebian.

This will guide you through installing Tebian to disk.
You can press Cancel at any step to go back.

Begin installation?" $WT_HEIGHT $WT_WIDTH || {
        echo ""
        echo "  Type 'sudo tebian-installer' to restart the installer."
        echo ""
        exit 0
    }
}

# ── Step 2: Keyboard layout ──
select_keyboard() {
    if $AUTO; then
        KB_LAYOUT="${ANS[keyboard]:-us}"
        apply_live_keymap
        return 0
    fi
    KB_LAYOUT=$(wt --title "  Keyboard Layout" --menu "\
Select your keyboard layout:" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU \
        "us" "English (US)" \
        "gb" "English (UK)" \
        "de" "German" \
        "fr" "French" \
        "es" "Spanish" \
        "it" "Italian" \
        "pt" "Portuguese" \
        "nl" "Dutch" \
        "se" "Swedish" \
        "no" "Norwegian" \
        "dk" "Danish" \
        "fi" "Finnish" \
        "pl" "Polish" \
        "br" "Portuguese (Brazil)" \
        "latam" "Spanish (Latin America)" \
        "jp" "Japanese" \
        "kr" "Korean" \
        "ru" "Russian" \
        "ch" "Swiss (German)" \
        "ca" "Canadian (French)" \
        3>&1 1>&2 2>&3) || return 1

    apply_live_keymap
}

# Switch the live console to the chosen layout, so the passphrase and
# password typed next are what the installed system will expect. setupcon
# compiles the XKB layout itself — the same names the installed system and
# Sway use — so no separate console-keymap naming table is needed. If it
# fails the user must know: a German user typing their LUKS passphrase on a
# silently-US keymap can't unlock the disk after installing.
apply_live_keymap() {
    [ "$KB_LAYOUT" = us ] && return 0
    # ckbcomp compiles the XKB layout into a console keymap, so the same
    # names work here, on the installed system and in Sway — no separate
    # console-keymap table. (kbd alone ships no keymaps: `loadkeys de`
    # used to fail silently.)
    if command -v ckbcomp >/dev/null && ckbcomp -model pc105 -layout "$KB_LAYOUT" 2>/dev/null | loadkeys -q 2>/dev/null; then
        return 0
    fi
    $AUTO && return 0
    msg "Couldn't switch this console to the \"${KB_LAYOUT}\" layout.\n\nThe installed system will use ${KB_LAYOUT}, but while installing\nyou're typing on a US layout. Avoid characters that differ\nbetween the two in passwords, or they won't match later."
}

# ── Step 3: Timezone ──
select_timezone() {
    if $AUTO; then
        TIMEZONE="${ANS[timezone]:-UTC}"
        [ -f "/usr/share/zoneinfo/$TIMEZONE" ] || die "Answers file: unknown timezone '$TIMEZONE'"
        return 0
    fi
    local region
    region=$(wt --title "  Timezone" --menu "\
Select your region:" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU \
        "America"    "Americas" \
        "Europe"     "Europe" \
        "Asia"       "Asia" \
        "Africa"     "Africa" \
        "Australia"  "Australia" \
        "Pacific"    "Pacific" \
        "UTC"        "UTC (no timezone)" \
        3>&1 1>&2 2>&3) || return 1

    if [ "$region" = "UTC" ]; then
        TIMEZONE="UTC"
        return 0
    fi

    # Build city list for selected region
    local cities=()
    while IFS= read -r tz; do
        local city
        city=$(echo "$tz" | cut -d/ -f2- | tr '_' ' ')
        cities+=("$tz" "$city")
    done < <(find /usr/share/zoneinfo/"$region" -maxdepth 1 -type f 2>/dev/null | sed "s|/usr/share/zoneinfo/||" | sort)

    if [ ${#cities[@]} -eq 0 ]; then
        TIMEZONE="UTC"
        return 0
    fi

    TIMEZONE=$(wt --title "  Timezone" --menu "\
Select your city:" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU "${cities[@]}" 3>&1 1>&2 2>&3) || return 1
}

# ── Step 4: Network check ──
# Uses NetworkManager (nmcli) for WiFi — NM handles wpa_supplicant,
# regulatory domain bootstrap, and passive scanning automatically.
# Stopping NM and using iw directly breaks Intel LAR WiFi cards.
setup_network() {
    # Quick connectivity test — use curl, not ping (ICMP blocked in QEMU SLIRP)
    if curl -sfm5 http://deb.debian.org/debian/dists/ -o /dev/null 2>/dev/null; then
        return 0
    fi
    if $AUTO; then
        sleep 10
        curl -sfm10 http://deb.debian.org/debian/dists/ -o /dev/null 2>/dev/null && return 0
        die "Unattended install: no network"
    fi
    # Fallback: NM may still be getting DHCP — wait briefly and retry
    sleep 3
    if curl -sfm5 http://deb.debian.org/debian/dists/ -o /dev/null 2>/dev/null; then
        return 0
    fi

    # Find WiFi interface
    local wifi_dev=""
    wifi_dev=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '/wifi/{print $1; exit}')
    [ -z "$wifi_dev" ] && wifi_dev=$(iw dev 2>/dev/null | awk '/Interface/{print $2}' | head -1)

    if [ -n "$wifi_dev" ]; then
        if ! yesno "No internet connection detected.\n\nConnect to Wi-Fi now?\n\n(Installation requires internet to download packages.)"; then
            wt --title "  Warning" --yesno "\
Installation requires downloading packages from the internet.
Without a connection, the install WILL fail.

Continue anyway?" $WT_HEIGHT $WT_WIDTH || return 1
            return 0
        fi

        # WiFi connection loop — retry on failure instead of going back
        while true; do
            # Scan for networks via NetworkManager (progress bar)
            local scan_tmp
            scan_tmp=$(mktemp /tmp/tebian-scan.XXXXXX)

            (
                echo 5; echo "# Enabling Wi-Fi radio..."
                rfkill unblock wifi 2>/dev/null || true
                nmcli radio wifi on 2>/dev/null || true

                echo 15; echo "# Waiting for adapter..."
                # Wait for NM to bring device to 'disconnected' (ready to scan)
                for w in $(seq 1 10); do
                    local state
                    state=$(nmcli -t -f DEVICE,STATE device 2>/dev/null | grep "^${wifi_dev}:" | cut -d: -f2)
                    [ "$state" = "disconnected" ] && break
                    [ "$state" = "unavailable" ] && nmcli device set "$wifi_dev" managed yes 2>/dev/null || true
                    sleep 1
                done

                echo 40; echo "# Scanning for networks..."
                nmcli device wifi rescan 2>/dev/null || true
                sleep 3

                echo 70; echo "# Getting results..."
                nmcli -t -f SSID,SIGNAL,SECURITY device wifi list 2>/dev/null > "$scan_tmp"

                # Retry once if empty
                if [ ! -s "$scan_tmp" ] || ! grep -q ':' "$scan_tmp"; then
                    echo 80; echo "# Retrying scan..."
                    sleep 3
                    nmcli device wifi rescan 2>/dev/null || true
                    sleep 3
                    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list 2>/dev/null > "$scan_tmp"
                fi

                echo 100
            ) | progress "Scanning for Wi-Fi..."

            # Parse nmcli terse output (SSID:SIGNAL:SECURITY)
            # Parse from right to handle SSIDs containing colons
            local networks=()
            local seen_ssids=""
            local scan_data
            scan_data=$(cat "$scan_tmp" 2>/dev/null)
            rm -f "$scan_tmp"

            while IFS= read -r line; do
                [ -z "$line" ] && continue
                local rest="${line%:*}"
                local security="${line##*:}"
                local ssid="${rest%:*}"
                local signal="${rest##*:}"

                [ -z "$ssid" ] && continue
                echo "$seen_ssids" | grep -qxF "$ssid" && continue
                seen_ssids+="${ssid}"$'\n'

                [ -z "$security" ] && security="Open"
                networks+=("$ssid" "${signal}%  ${security}")
            done <<< "$scan_data"

            if [ ${#networks[@]} -eq 0 ]; then
                local diag=""
                diag+="interface: ${wifi_dev}\n"
                diag+="nmcli device:\n$(nmcli device status 2>&1)\n\n"
                diag+="rfkill:\n$(rfkill list wifi 2>&1)\n\n"
                diag+="dmesg:\n$(dmesg 2>/dev/null | grep -i -E 'iwl|wlan|wifi|firmware' | tail -8)"
                wt --title "  WiFi Debug" --msgbox "$diag" 24 $WT_WIDTH

                local retry_choice
                retry_choice=$(wt --title "  Wi-Fi" --menu "\
No Wi-Fi networks found." \
                    $WT_HEIGHT $WT_WIDTH $WT_MENU \
                    "retry" "Scan again" \
                    "skip"  "Continue without Wi-Fi" \
                    "back"  "Go back" \
                    3>&1 1>&2 2>&3) || retry_choice="back"

                case "$retry_choice" in
                    retry) continue ;;
                    skip)  return 0 ;;
                    back)  return 1 ;;
                esac
            fi

            local ssid
            ssid=$(wt --title "  Wi-Fi" --menu "Select a network:" \
                $WT_HEIGHT $WT_WIDTH $WT_MENU "${networks[@]}" 3>&1 1>&2 2>&3) || continue

            # Check if network needs a password
            local wifi_pass=""
            if echo "$scan_data" | grep -F "$ssid" | grep -qiE 'WPA|WEP|SAE'; then
                wifi_pass=$(password "Enter password for \"${ssid}\":") || continue
                if [ -z "$wifi_pass" ]; then
                    msg "Password cannot be empty for encrypted networks."
                    continue
                fi
            fi

            # Connect via NetworkManager (handles auth + DHCP)
            (
                echo 10; echo "# Connecting to ${ssid}..."
                if [ -n "$wifi_pass" ]; then
                    nmcli device wifi connect "$ssid" password "$wifi_pass" >/dev/null 2>&1 &
                else
                    nmcli device wifi connect "$ssid" >/dev/null 2>&1 &
                fi
                local nm_pid=$!

                for w in $(seq 1 20); do
                    kill -0 $nm_pid 2>/dev/null || break
                    echo $((10 + w * 4)); echo "# Connecting..."
                    sleep 1
                done
                wait $nm_pid 2>/dev/null || true

                echo 95; echo "# Verifying connection..."
                sleep 1
                echo 100
            ) | progress "Connecting to Wi-Fi..."
            unset wifi_pass

            if ping -c1 -W3 deb.debian.org &>/dev/null; then
                msg "Connected to ${ssid}."
                return 0
            else
                msg "Failed to connect to ${ssid}.\n\nCheck the password and try again."
                nmcli connection delete "$ssid" 2>/dev/null || true
            fi
        done
    else
        # No wifi hardware — just warn
        wt --title "  Warning" --yesno "\
No internet connection detected and no Wi-Fi adapter found.

Connect an Ethernet cable, or installation will fail.

Continue anyway?" $WT_HEIGHT $WT_WIDTH || return 1
        return 0
    fi
}

# ── Step 5: Detect boot mode ──
detect_efi() {
    if [ -d /sys/firmware/efi ]; then
        IS_EFI=true
    fi
}

# Partition device name for partition number $2 of disk $1. Kernel naming
# adds a "p" when the disk name ends in a digit (nvme0n1p1, mmcblk0p1,
# loop0p1) — matching on "nvme"/"mmcblk" missed other such devices.
part_dev() {
    local disk="$1" num="$2"
    if [[ "$disk" =~ [0-9]$ ]]; then echo "${disk}p${num}"; else echo "${disk}${num}"; fi
}

# Wait until every listed device node exists. udev creates partition nodes
# asynchronously after the kernel rereads a table; formatting too early
# fails (or, before, silently didn't).
wait_for_devs() {
    local dev
    udevadm settle --timeout=10 2>/dev/null || true
    for dev in "$@"; do
        for _ in $(seq 50); do
            [ -b "$dev" ] && break
            sleep 0.2
        done
        [ -b "$dev" ] || { echo "Device $dev did not appear" >&2; return 1; }
    done
}

# Tell the kernel about a new partition table and wait for it to settle
reread_table() {
    local disk="$1"
    udevadm settle --timeout=10 2>/dev/null || true
    partprobe "$disk" 2>/dev/null || blockdev --rereadpt "$disk" 2>/dev/null || true
    udevadm settle --timeout=10 2>/dev/null || true
}

ESP_GUID="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"

# EFI System Partition on $1, found by partition type — not "first vfat
# partition", which can be a FAT data or recovery partition
find_esp() {
    local disk="$1" name ptype
    while read -r name ptype; do
        [ "$name" = "$disk" ] && continue
        case "${ptype,,}" in
            "$ESP_GUID"|0xef) echo "$name"; return 0 ;;
        esac
    done < <(lsblk -lnpo NAME,PARTTYPE "$disk" 2>/dev/null)
    return 1
}

disk_label() { blkid -p -o value -s PTTYPE "$1" 2>/dev/null || true; }

# ── Step 6: Disk selection ──
select_disk() {
    DISK=""
    # Find the live boot media device so we can exclude it
    local live_disk=""
    if mountpoint -q /run/live/medium 2>/dev/null; then
        local live_source
        live_source=$(findmnt -no SOURCE /run/live/medium 2>/dev/null)
        if [ -n "$live_source" ]; then
            live_disk=$(lsblk -npo PKNAME "$live_source" 2>/dev/null | head -1)
        fi
    fi

    local disks=()
    local dev size model
    while read -r dev size model; do
        [ -z "$model" ] && model="Disk"
        # Skip the live boot media (USB/DVD the installer booted from)
        [ "$dev" = "$live_disk" ] && continue
        disks+=("$dev" "$size  $model")
    done < <(lsblk -dpno NAME,SIZE,MODEL 2>/dev/null | grep -E '^/dev/(sd|nvme|vd|mmcblk)')

    if [ ${#disks[@]} -eq 0 ]; then
        step_back "No disks found.\n\nGo back and check storage/controller settings, then retry."
        return 1
    fi

    if $AUTO; then
        DISK="${ANS[disk]:-}"
        [ -b "$DISK" ] || die "Answers file: disk '${DISK}' is not a block device"
        return 0
    fi

    DISK=$(wt --title "  Select Target Drive" --menu "\
Choose the drive to install Tebian on.

Next screen lets you choose:
  • Erase entire drive (fresh install)
  • Install alongside existing OS (dual-boot)
  • Manual partitioning (advanced)

Nothing is written to disk until the final
confirmation screen." \
        $WT_HEIGHT $WT_WIDTH $WT_MENU "${disks[@]}" 3>&1 1>&2 2>&3) || return 1
}

# ── Step 7: Partition strategy ──
# Only decides what to do. The disk is not touched until apply_disk_plan
# runs after the final confirmation, so going back and changing answers is
# always safe. (Previously the wipe ran here, and backing up from a later
# screen re-ran it — shrinking Windows twice.)
select_partition_mode() {
    PART_MODE="" DUAL_BOOT=false SHRINK_PART="" SHRINK_FSTYPE="" SHRINK_TO_BYTES=0
    PARTITION_ROOT="" PARTITION_EFI="" PARTITION_BOOT="" MANUAL_FORMAT_EFI=false

    local has_windows=false has_linux=false has_bitlocker=false
    local existing_os="" part_summary=""
    local part fstype size label size_bytes
    while read -r part; do
        [ "$part" = "$DISK" ] && continue
        fstype=$(blkid -p -o value -s TYPE "$part" 2>/dev/null || true)
        size=$(lsblk -dnpo SIZE "$part" 2>/dev/null | xargs)
        label=$(blkid -p -o value -s LABEL "$part" 2>/dev/null || true)

        case "$fstype" in
            ntfs)
                size_bytes=$(blockdev --getsize64 "$part" 2>/dev/null || echo 0)
                if [[ "$label" =~ [Ww]indows|[Ss]ystem ]] || [ "$size_bytes" -gt 20000000000 ]; then
                    has_windows=true
                fi ;;
            BitLocker) has_windows=true; has_bitlocker=true ;;
            ext4|btrfs|xfs) has_linux=true ;;
        esac
        if [ -n "$fstype" ]; then
            local desc="$size $fstype"
            [ -n "$label" ] && desc="$size $fstype ($label)"
            part_summary+="  ${part##*/}: ${desc}\n"
        fi
    done < <(lsblk -lnpo NAME "$DISK" 2>/dev/null)

    local options=()
    if $has_windows; then
        existing_os="Windows detected on this disk.\n"
        options+=("alongside" "Install alongside Windows (dual-boot)")
    elif $has_linux; then
        existing_os="Linux detected on this disk.\n"
        options+=("alongside" "Install alongside existing Linux (dual-boot)")
    fi
    options+=("erase" "Erase entire disk and install Tebian")
    options+=("manual" "Manual partitioning (advanced)")
    [ -n "$part_summary" ] && existing_os+="Current partitions:\n${part_summary}"

    local choice
    if $AUTO; then
        choice="${ANS[partition]:-erase}"
    else
        choice=$(wt --title "  Partition Disk" --menu "\
${existing_os}
How would you like to partition ${DISK}?" \
            $WT_HEIGHT $WT_WIDTH $WT_MENU "${options[@]}" 3>&1 1>&2 2>&3) || return 1
    fi

    case "$choice" in
        alongside)
            if $has_bitlocker; then
                step_back "This disk has a BitLocker-encrypted partition.\n\nIt can't be resized from Linux. In Windows, open Settings >\nPrivacy & security > Device encryption (or Manage BitLocker)\nand turn it off, wait for decryption to finish, then retry.\n\nKeep your BitLocker recovery key handy either way: changing\nthe boot order can make Windows ask for it."
                return 1
            fi
            plan_alongside ;;
        erase)  plan_erase ;;
        manual) plan_manual ;;
        *) return 1 ;;
    esac
}

plan_erase() {
    PART_MODE=erase
    local existing_parts
    existing_parts="$(lsblk -lnpo NAME,SIZE,FSTYPE "$DISK" | grep -v "^${DISK}[[:space:]]" | sed 's/^/  • /' || true)"
    [ -z "$existing_parts" ] && existing_parts="  • (no existing partitions detected)"

    $AUTO && return 0
    yesno "You selected: ${DISK}\n\nThese partitions will be DELETED when you confirm at the end:\n${existing_parts}\n\nThis erases everything on the disk (Windows, recovery, data)." || return 1
}

# Choose a partition to shrink and how much space to give Tebian.
# Everything here is read-only: sizes are validated against what the
# filesystem tools say is possible, but nothing is resized yet.
plan_alongside() {
    PART_MODE=alongside
    DUAL_BOOT=true

    local label; label=$(disk_label "$DISK")

    # A firmware/disk mismatch can't be fixed by the installer — refuse
    # before anything is resized rather than fail at grub-install after
    if ! $IS_EFI && [ "$label" = gpt ] && find_esp "$DISK" >/dev/null; then
        step_back "The existing OS on this disk boots in UEFI mode, but this\ninstaller was started in legacy BIOS mode.\n\nReboot, choose the USB entry marked \"UEFI\" in your boot\nmenu, and run the installer again."
        return 1
    fi
    if $IS_EFI && ! find_esp "$DISK" >/dev/null; then
        if [ "$label" = dos ]; then
            step_back "The existing OS on this disk boots in legacy BIOS mode,\nbut this installer was started in UEFI mode.\n\nReboot and pick the USB's legacy/non-UEFI boot entry, then\nrun the installer again."
        else
            step_back "No EFI System Partition found on ${DISK}.\n\nUse Manual partitioning instead."
        fi
        return 1
    fi

    # Pick the largest NTFS/ext4 partition
    local part fstype size_bytes largest_size=0
    while read -r part; do
        [ "$part" = "$DISK" ] && continue
        fstype=$(blkid -p -o value -s TYPE "$part" 2>/dev/null || true)
        [ "$fstype" = ntfs ] || [ "$fstype" = ext4 ] || continue
        size_bytes=$(blockdev --getsize64 "$part" 2>/dev/null || echo 0)
        if [ "$size_bytes" -gt "$largest_size" ]; then
            largest_size=$size_bytes SHRINK_PART=$part SHRINK_FSTYPE=$fstype
        fi
    done < <(lsblk -lnpo NAME "$DISK" 2>/dev/null)

    if [ -z "$SHRINK_PART" ]; then
        step_back "Could not find a shrinkable NTFS/ext4 partition on ${DISK}.\n\nUse Manual partitioning instead."
        return 1
    fi

    # MBR holds 4 primary partitions; Tebian needs 1 (2 when encrypted)
    local need=1; $ENCRYPT_PLANNED && need=2
    if [ "$label" = dos ]; then
        local used; used=$(lsblk -lnpo NAME "$DISK" | grep -vc "^${DISK}$" || true)
        if [ $((used + need)) -gt 4 ]; then
            step_back "${DISK} uses an MBR partition table that already has ${used}\npartitions — no room for Tebian's.\n\nUse Manual partitioning instead."
            return 1
        fi
    fi

    if findmnt -n "$SHRINK_PART" &>/dev/null; then
        umount "$SHRINK_PART" 2>/dev/null || {
            step_back "${SHRINK_PART} is mounted and could not be unmounted.\nUnmount it first, then retry."
            return 1
        }
    fi

    # Smallest size the existing filesystem can be shrunk to, plus room for
    # it to keep working (Windows needs free space for updates)
    local min_bytes=0
    if [ "$SHRINK_FSTYPE" = ntfs ]; then
        # Read-only dry run: catches hibernation / Fast Startup and a dirty
        # volume now, before the user commits, instead of mid-install
        local info
        if ! info=$(ntfsresize --info --no-progress-bar "$SHRINK_PART" 2>&1); then
            step_back "Windows can't be resized right now:\n\n$(echo "$info" | grep -iE 'hibernat|unclean|error|chkdsk' | head -3)\n\nBoot Windows, turn off Fast Startup (Control Panel > Power\nOptions > Choose what the power buttons do), shut down fully,\nthen retry."
            return 1
        fi
        min_bytes=$(echo "$info" | sed -n 's/.*resize at \([0-9]*\) bytes.*/\1/p' | head -1)
    else
        local blocks bsize
        blocks=$(resize2fs -P "$SHRINK_PART" 2>/dev/null | grep -o '[0-9]*$' || true)
        bsize=$(dumpe2fs -h "$SHRINK_PART" 2>/dev/null | sed -n 's/^Block size: *//p')
        [ -n "$blocks" ] && [ -n "$bsize" ] && min_bytes=$((blocks * bsize))
    fi
    [ -n "$min_bytes" ] || min_bytes=0
    local GiB=1073741824
    local keep_min_gb=$(( (min_bytes + 10 * GiB) / GiB + 1 ))   # used + 10GiB headroom
    local total_gb=$(( largest_size / GiB ))
    local max_tebian=$(( total_gb - keep_min_gb ))
    if [ "$max_tebian" -lt 20 ]; then
        step_back "${SHRINK_PART} doesn't have enough free space.\n\nTebian needs 20GB; at most ${max_tebian}GB can be freed while\nleaving the existing system room to work."
        return 1
    fi

    local suggest=$(( total_gb / 2 ))
    [ "$suggest" -gt "$max_tebian" ] && suggest=$max_tebian
    [ "$suggest" -lt 20 ] && suggest=20

    local tebian_gb
    while true; do
        if $AUTO; then
            tebian_gb="${ANS[alongside_gb]:-$suggest}"
        else
            tebian_gb=$(input "${SHRINK_PART} is ${total_gb}GB (${SHRINK_FSTYPE}).\n\nHow many GB for Tebian? (20 to ${max_tebian})" "$suggest") || return 1
        fi
        if [[ "$tebian_gb" =~ ^[0-9]+$ ]] && [ "$tebian_gb" -ge 20 ] && [ "$tebian_gb" -le "$max_tebian" ]; then
            break
        fi
        $AUTO && die "Answers file: alongside_gb must be 20..${max_tebian}"
        msg "Enter a whole number between 20 and ${max_tebian}."
    done

    SHRINK_TO_BYTES=$(( (total_gb - tebian_gb) * GiB ))
    $AUTO && return 0
    yesno "When you confirm at the end, this will:\n\n• Shrink ${SHRINK_PART} to $((total_gb - tebian_gb))GB\n• Create ${tebian_gb}GB for Tebian in the freed space\n\nBack up anything important first — resizing is safe but\nnot risk-free.\n\nContinue?" || return 1
}

plan_manual() {
    PART_MODE=manual
    $AUTO && die "Answers file: manual partitioning is interactive only"
    msg "Opening cfdisk. Changes you write there are applied immediately.\n\nCreate at least:\n  • A root partition (20GB+, type Linux)\n  • An EFI partition (512MB, type EFI System) if using UEFI\n  • A /boot partition (1GB, type Linux) if you'll encrypt\n\nPress OK to continue."

    cfdisk "$DISK"
    reread_table "$DISK"

    local parts=() dev size fstype
    while read -r dev size fstype; do
        parts+=("$dev" "$size  ${fstype:--}")
    done < <(lsblk -lnpo NAME,SIZE,FSTYPE "$DISK" | grep -v "^${DISK} ")
    [ ${#parts[@]} -gt 0 ] || { step_back "No partitions on ${DISK}."; return 1; }

    PARTITION_ROOT=$(wt --title "  Select Root Partition" --menu \
        "Which partition for / (root)?\n\nIt will be formatted as ext4." \
        $WT_HEIGHT $WT_WIDTH $WT_MENU "${parts[@]}" 3>&1 1>&2 2>&3) || return 1

    if $IS_EFI; then
        PARTITION_EFI=$(wt --title "  Select EFI Partition" --menu \
            "Which partition is the EFI System Partition?" \
            $WT_HEIGHT $WT_WIDTH $WT_MENU "${parts[@]}" 3>&1 1>&2 2>&3) || return 1
        [ "$PARTITION_EFI" != "$PARTITION_ROOT" ] || { step_back "EFI and root must be different partitions."; return 1; }
        local efi_type
        efi_type=$(blkid -p -o value -s TYPE "$PARTITION_EFI" 2>/dev/null || true)
        if [ "$efi_type" != vfat ]; then
            # An existing ESP is shared with other systems — only format one
            # that has no filesystem yet, and only when asked
            yesno "${PARTITION_EFI} is not FAT32.\n\nFormat it as FAT32 for use as the EFI partition?\n(Only do this for a new, empty partition.)" || return 1
            MANUAL_FORMAT_EFI=true
        fi
    fi

    if $ENCRYPT_PLANNED; then
        PARTITION_BOOT=$(wt --title "  Select /boot Partition" --menu \
            "Encryption needs a separate unencrypted /boot (1GB).\nIt will be formatted as ext4." \
            $WT_HEIGHT $WT_WIDTH $WT_MENU "${parts[@]}" 3>&1 1>&2 2>&3) || return 1
        if [ "$PARTITION_BOOT" = "$PARTITION_ROOT" ] || [ "$PARTITION_BOOT" = "${PARTITION_EFI:-}" ]; then
            step_back "/boot must be its own partition."; return 1
        fi
    fi
}

# ── Step 8: Encryption ──
# Asked before partitioning: an encrypted install needs a separate /boot,
# which changes the layout. Only collects the passphrase.
setup_encryption() {
    # Only the yes/no here: it changes the disk layout (a separate /boot),
    # so it must come before partitioning. The passphrase is chosen with
    # the user's password in setup_user, where it can simply reuse it.
    ENCRYPT_PLANNED=false LUKS_PASS=""
    if $AUTO; then
        [ "${ANS[encrypt]:-no}" = yes ] && ENCRYPT_PLANNED=true
        return 0
    fi
    yesno "Enable disk encryption (LUKS)?\n\nEncrypts the whole Tebian system: nothing on the disk can be\nread without your passphrase, e.g. if the laptop is stolen.\nYou'll type it once at every boot. Recommended for laptops.\n\nIf you forget it, your data cannot be recovered." && ENCRYPT_PLANNED=true
    return 0
}

# ── Apply the disk plan (runs only after the final confirmation) ──
# Runs in a subshell under the progress gauge, so results come back through
# $DISK_STATE; errexit + an ERR trap make any failing command abort with a
# logged reason instead of carrying on with a half-made disk.
apply_disk_plan() {
    local state; state=$(mktemp /tmp/tebian-disk.XXXXXX)
    set +e
    (
        set -eE
        trap 'echo "INSTALL_FAILED: partitioning: \"$BASH_COMMAND\" (line $LINENO)" >> "$INSTALL_LOG"' ERR
        exec 2>>"$INSTALL_LOG"
        local boot_part="" root_part="" efi_part=""

        case "$PART_MODE" in
        erase)
            echo 5; echo "# Wiping ${DISK}..."
            local p
            while read -r p; do
                [ "$p" = "$DISK" ] && continue
                wipefs -a -f "$p" >/dev/null || true
            done < <(lsblk -lnpo NAME "$DISK")
            wipefs -a -f "$DISK" >/dev/null
            sgdisk --zap-all "$DISK" >/dev/null || true
            reread_table "$DISK"

            # GPT for UEFI, and for BIOS disks past MBR's 2 TiB limit (with a
            # bios_grub partition for GRUB's core image). Small BIOS disks get
            # MBR, which the oldest firmware handles best.
            local n=1 table=gpt
            if ! $IS_EFI && [ "$(blockdev --getsize64 "$DISK")" -le 2199023255552 ]; then
                table=msdos
            fi
            echo 20; echo "# Creating partition table..."
            parted -s "$DISK" mklabel "$table"
            # MBR partitions take a type ("primary") where GPT takes a name
            local nm_boot=boot nm_root=root
            [ "$table" = msdos ] && nm_boot=primary nm_root=primary
            local start=1
            if $IS_EFI; then
                parted -s "$DISK" mkpart ESP fat32 1MiB 1025MiB
                parted -s "$DISK" set $n esp on
                efi_part=$(part_dev "$DISK" $n); n=$((n + 1)); start=1025
            elif [ "$table" = gpt ]; then
                parted -s "$DISK" mkpart biosgrub 1MiB 2MiB
                parted -s "$DISK" set $n bios_grub on
                n=$((n + 1)); start=2
            fi
            local active=""
            if $ENCRYPT_PLANNED; then
                parted -s "$DISK" mkpart $nm_boot ext4 ${start}MiB $((start + 1024))MiB
                boot_part=$(part_dev "$DISK" $n); active=$n; n=$((n + 1)); start=$((start + 1024))
            fi
            parted -s "$DISK" mkpart $nm_root ext4 ${start}MiB 100%
            root_part=$(part_dev "$DISK" $n)
            # Some legacy BIOSes won't boot an MBR disk with no active
            # partition; mark the one holding /boot
            [ "$table" = msdos ] && parted -s "$DISK" set "${active:-$n}" boot on
            reread_table "$DISK"
            wait_for_devs $efi_part $boot_part $root_part
            [ -n "$efi_part" ] && mkfs.fat -F32 -n EFI "$efi_part" >/dev/null
            ;;

        alongside)
            local sect
            sect=$(basename "$SHRINK_PART")
            local start_s size_s pnum
            start_s=$(cat "/sys/class/block/$sect/start")
            size_s=$(cat "/sys/class/block/$sect/size")
            pnum=$(cat "/sys/class/block/$sect/partition")
            umount "$SHRINK_PART" 2>/dev/null || true

            # New partition size in sectors, aligned to 1MiB, and the
            # filesystem shrunk to exactly that size — matching them the way
            # GParted does. NTFS keeps its backup boot sector in the
            # partition's last sector, so slack after the filesystem breaks
            # it; and parted's "resizepart N 40GiB" (the old way) sets the
            # END position on the disk, not the size, which cut the tail off
            # any filesystem that didn't start at sector 0.
            local align=2048 new_size_s new_bytes
            new_size_s=$(( SHRINK_TO_BYTES / 512 / align * align ))
            new_bytes=$(( new_size_s * 512 ))
            [ "$new_size_s" -lt "$size_s" ]

            echo 10; echo "# Shrinking ${SHRINK_PART} (this can take a while)..."
            if [ "$SHRINK_FSTYPE" = ntfs ]; then
                # Exact bytes: ntfsresize's k/M/G suffixes are decimal
                ntfsresize --force --no-progress-bar -s "$new_bytes" "$SHRINK_PART" </dev/null >>"$INSTALL_LOG"
            else
                local rc=0
                e2fsck -f -y "$SHRINK_PART" >>"$INSTALL_LOG" || rc=$?
                [ "$rc" -le 2 ]   # 0 clean, 1-2 corrected; >2 is fatal
                resize2fs "$SHRINK_PART" "$((new_bytes / 1024))K" >>"$INSTALL_LOG"
            fi

            echo 40; echo "# Resizing partition entry..."
            echo ",$new_size_s" | sfdisk --no-reread --no-tell-kernel -q -N "$pnum" "$DISK" >>"$INSTALL_LOG"

            # New partitions go exactly into the freed region, never to
            # "100%" — Windows usually keeps a recovery partition after C:
            local free_start=$(( start_s + new_size_s ))
            local free_end=$(( start_s + size_s ))       # exclusive
            local ptype_linux=0FC63DAF-8483-4772-8E79-3D69D8477DE4
            [ "$(disk_label "$DISK")" = dos ] && ptype_linux=83
            local before after
            before=$(lsblk -lnpo NAME "$DISK" | sort)
            echo 50; echo "# Creating Tebian partitions..."
            if $ENCRYPT_PLANNED; then
                printf 'start=%s, size=%s, type=%s\nstart=%s, size=%s, type=%s\n' \
                    "$free_start" $((1024 * 2048)) "$ptype_linux" \
                    $((free_start + 1024 * 2048)) $((free_end - free_start - 1024 * 2048)) "$ptype_linux" |
                    sfdisk --append --no-reread --no-tell-kernel -q "$DISK" >>"$INSTALL_LOG"
            else
                printf 'start=%s, size=%s, type=%s\n' "$free_start" $((free_end - free_start)) "$ptype_linux" |
                    sfdisk --append --no-reread --no-tell-kernel -q "$DISK" >>"$INSTALL_LOG"
            fi
            reread_table "$DISK"
            after=$(lsblk -lnpo NAME "$DISK" | sort)
            local new; new=$(comm -13 <(echo "$before") <(echo "$after"))
            if $ENCRYPT_PLANNED; then
                boot_part=$(echo "$new" | sed -n 1p); root_part=$(echo "$new" | sed -n 2p)
            else
                root_part=$(echo "$new" | sed -n 1p)
            fi
            [ -n "$root_part" ]
            wait_for_devs $boot_part $root_part
            efi_part=""
            $IS_EFI && efi_part=$(find_esp "$DISK")
            ;;

        manual)
            root_part="$PARTITION_ROOT" boot_part="$PARTITION_BOOT" efi_part="$PARTITION_EFI"
            if $MANUAL_FORMAT_EFI; then
                mkfs.fat -F32 -n EFI "$efi_part" >/dev/null
            fi
            ;;
        esac

        if [ -n "$boot_part" ]; then
            echo 60; echo "# Formatting /boot..."
            wipefs -a -f "$boot_part" >/dev/null
            mkfs.ext4 -q -F -L boot "$boot_part"
        fi

        local luks_part=""
        if $ENCRYPT_PLANNED; then
            echo 70; echo "# Encrypting root partition..."
            luks_part="$root_part"
            wipefs -a -f "$luks_part" >/dev/null
            printf '%s' "$LUKS_PASS" | cryptsetup luksFormat --batch-mode --type luks2 "$luks_part" -
            printf '%s' "$LUKS_PASS" | cryptsetup open "$luks_part" "$CRYPT_NAME" -
            root_part="/dev/mapper/$CRYPT_NAME"
        fi

        echo 85; echo "# Formatting root..."
        [ -z "$luks_part" ] && wipefs -a -f "$root_part" >/dev/null
        mkfs.ext4 -q -F -L tebian "$root_part"

        {
            echo "PARTITION_ROOT=$root_part"
            echo "PARTITION_BOOT=$boot_part"
            echo "PARTITION_EFI=$efi_part"
            echo "LUKS_PART=$luks_part"
        } > "$state"
        echo 100; echo "# Disk ready"
    ) | progress "Preparing ${DISK}..."
    local rc=${PIPESTATUS[0]}
    set -e
    unset LUKS_PASS

    if [ "$rc" -ne 0 ] || ! grep -q '^PARTITION_ROOT=/' "$state"; then
        rm -f "$state"
        grep -q INSTALL_FAILED "$INSTALL_LOG" || echo "INSTALL_FAILED: partitioning exited $rc" >> "$INSTALL_LOG"
        install_failed
    fi
    # Read back what the subshell created (plain KEY=VALUE, device paths only)
    local key val
    while IFS='=' read -r key val; do
        case "$key" in
            PARTITION_ROOT|PARTITION_BOOT|PARTITION_EFI|LUKS_PART) printf -v "$key" '%s' "$val" ;;
        esac
    done < "$state"
    rm -f "$state"
    ENCRYPT=$ENCRYPT_PLANNED
}

# ── Step 9: User creation ──
setup_user() {
    LUKS_PASS=""
    if $AUTO; then
        USERNAME="${ANS[username]}" USERPASS="${ANS[password]}" HOSTNAME_VAL="${ANS[hostname]:-tebian}"
        [[ "$USERNAME" =~ ^[a-z][a-z0-9_-]*$ ]] || die "Answers file: invalid username"
        # No separate encrypt_passphrase = one password for both
        if $ENCRYPT_PLANNED; then LUKS_PASS="${ANS[encrypt_passphrase]:-$USERPASS}"; fi
        return 0
    fi
    while true; do
        USERNAME=$(input "Enter your username:" "") || return 1
        # Validate username
        if [[ "$USERNAME" =~ ^[a-z][a-z0-9_-]*$ ]] && [ ${#USERNAME} -le 32 ]; then
            break
        fi
        msg "Invalid username. Use lowercase letters, numbers, hyphens.\nMust start with a letter."
    done

    local pass1 pass2
    while true; do
        pass1=$(password "Enter password for ${USERNAME}:") || return 1
        pass2=$(password "Confirm password:") || return 1
        if [ "$pass1" != "$pass2" ] || [ -z "$pass1" ]; then
            msg "Passwords don't match or are empty. Try again."
            continue
        fi
        # It may also guard the disk, where it can be attacked offline
        if $ENCRYPT_PLANNED && [ ${#pass1} -lt 8 ] &&
           ! yesno "That password is only ${#pass1} characters. It may also protect\nyour encrypted disk, where short passwords can be guessed\noffline.\n\nUse it anyway?"; then
            continue
        fi
        USERPASS="$pass1"
        break
    done

    if $ENCRYPT_PLANNED; then
        # One password, like FileVault: the user's password unlocks the disk
        # and, since that is the authentication, the desktop opens without a
        # second login screen. Sharing it doesn't weaken the disk: LUKS2
        # stretches it with argon2id, and the login hash lives inside the
        # encrypted disk where it can't be attacked until it's unlocked.
        if yesno "Use this password to unlock the disk too?\n\nYes (recommended): one password. Type it once at boot and\nTebian opens your desktop — no second login screen. The\nlock screen and admin tasks still ask for it.\n\nNo: choose a separate disk passphrase, and log in as usual."; then
            LUKS_PASS="$USERPASS"
        else
            while true; do
                pass1=$(password "Enter disk encryption passphrase:") || return 1
                pass2=$(password "Confirm disk encryption passphrase:") || return 1
                if [ "$pass1" != "$pass2" ] || [ -z "$pass1" ]; then
                    msg "Passphrases don't match or are empty. Try again."
                    continue
                fi
                if [ ${#pass1} -lt 8 ] && ! yesno "That passphrase is only ${#pass1} characters — short\npassphrases can be guessed offline.\n\nUse it anyway?"; then
                    continue
                fi
                LUKS_PASS="$pass1"
                break
            done
        fi
    fi

    while true; do
        HOSTNAME_VAL=$(input "Enter hostname:" "tebian") || return 1
        if [[ "$HOSTNAME_VAL" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
            break
        fi
        msg "Invalid hostname. Use letters, numbers, and hyphens only (max 63 chars, can't start/end with hyphen)."
    done
}

# ── Step 10: Mode selection ──
select_mode() {
    if $AUTO; then
        MODE="${ANS[mode]:-desktop}"
        case "$MODE" in desktop|server-bare|server-secure) ;; *) die "Answers file: bad mode '$MODE'" ;; esac
        return 0
    fi
    MODE=$(wt --title "  System Mode" --menu "\
Choose what to install:\n" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU \
        "desktop" "Tebian Desktop (Sway, audio, apps menu)" \
        "server"  "Tebian Server (headless)" \
        3>&1 1>&2 2>&3) || return 1

    if [ "$MODE" = "server" ]; then
        MODE=$(wt --title "  Server Mode" --menu "\
Choose server configuration:\n" \
            $WT_HEIGHT $WT_WIDTH $WT_MENU \
            "server-bare"   "Bare Server (SSH + pure Debian)" \
            "server-secure" "Secure Server (SSH + firewall + monitoring)" \
            3>&1 1>&2 2>&3) || return 1
    fi
}

# ── Step 11: Confirmation ──
confirm() {
    local encrypt_str="No"
    $ENCRYPT_PLANNED && encrypt_str="Yes (LUKS2, separate /boot)"

    local efi_str="Legacy BIOS"
    $IS_EFI && efi_str="UEFI"

    local mode_str="Desktop"
    [ "$MODE" = "server-secure" ] && mode_str="Server (SSH + Firewall)"
    [ "$MODE" = "server-bare" ] && mode_str="Server (Bare)"

    # Decided here, while both passwords are still known (LUKS_PASS is
    # cleared once the disk is encrypted)
    AUTOLOGIN=false
    if $ENCRYPT_PLANNED && [ "$MODE" = desktop ] && [ -n "$LUKS_PASS" ] && [ "$LUKS_PASS" = "$USERPASS" ]; then
        AUTOLOGIN=true
    fi
    local login_str="Login screen"
    $AUTOLOGIN && login_str="Automatic after disk unlock (one password)"
    [ "$MODE" = desktop ] || login_str="Console / SSH"

    local disk_str
    case "$PART_MODE" in
        erase)     disk_str="ERASE ALL of ${DISK}" ;;
        alongside) disk_str="Shrink ${SHRINK_PART} to $((SHRINK_TO_BYTES / 1073741824))GB, install in freed space" ;;
        manual)    disk_str="Format ${PARTITION_ROOT} as root${PARTITION_BOOT:+, ${PARTITION_BOOT} as /boot}" ;;
    esac

    $AUTO && return 0
    wt --title "  Confirm Installation" --yesno "\
Ready to install Tebian. Nothing has been written yet.

  Disk:        ${DISK}
  Changes:     ${disk_str}
  Boot mode:   ${efi_str}
  Encryption:  ${encrypt_str}
  Keyboard:    ${KB_LAYOUT}
  Timezone:    ${TIMEZONE}
  Username:    ${USERNAME}
  Hostname:    ${HOSTNAME_VAL}
  Mode:        ${mode_str}
  Login:       ${login_str}

Select Yes to begin. This is the point of no return." 22 $WT_WIDTH || return 1
}

# ── Install error handler ──
install_failed() {
    if $AUTO; then
        grep -o 'INSTALL_FAILED: .*' "$INSTALL_LOG" | tail -1 >&2
        cleanup
        poweroff
    fi
    local fail_reason=""
    if grep -q "No network" "$INSTALL_LOG" 2>/dev/null; then
        fail_reason="\n\nCause: No internet connection.\nConnect to WiFi/Ethernet and retry."
    elif grep -q "debootstrap failed" "$INSTALL_LOG" 2>/dev/null; then
        fail_reason="\n\nCause: Package download failed.\nCheck internet connection and retry."
    else
        local last
        last=$(grep -o 'INSTALL_FAILED: .*' "$INSTALL_LOG" 2>/dev/null | tail -1 | cut -c17-120)
        [ -n "$last" ] && fail_reason="\n\nFailed step: ${last}"
    fi
    wt --title "  Installation Failed" --msgbox "\
An error occurred during installation.${fail_reason}

Log saved to: ${INSTALL_LOG}

You can review the log from the shell.
Press OK to drop to a shell." $WT_HEIGHT $WT_WIDTH
    echo ""
    echo "  Install log: $INSTALL_LOG"
    echo "  Type 'sudo tebian-installer' to try again."
    echo ""
    cleanup
    $AUTO && poweroff
    exit 1
}

# ── Chroot package helpers ──
chroot_run() {
    local rc=0
    echo "$(date -Iseconds) | CHROOT_CMD_START: $*" >> "$INSTALL_LOG"
    if chroot "$TARGET" env DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true "$@" >> "$INSTALL_LOG" 2>&1; then
        rc=0
    else
        rc=$?
    fi
    echo "$(date -Iseconds) | CHROOT_CMD_END rc=${rc}: $*" >> "$INSTALL_LOG"
    return "$rc"
}

chroot_apt_update() {
    echo "$(date -Iseconds) | APT_UPDATE_START" >> "$INSTALL_LOG"
    chroot_run apt-get -o Acquire::Retries=3 update
}

chroot_apt_install() {
    echo "$(date -Iseconds) | APT_INSTALL_START: $*" >> "$INSTALL_LOG"
    chroot_run apt-get install -y --no-install-recommends -o Dpkg::Use-Pty=0 "$@"
}

# Desktop packages need recommends (GPU drivers, seat management, audio backends)
chroot_apt_install_desktop() {
    echo "$(date -Iseconds) | APT_INSTALL_DESKTOP_START: $*" >> "$INSTALL_LOG"
    chroot_run apt-get install -y -o Dpkg::Use-Pty=0 "$@"
}

chroot_apt_clean() {
    echo "$(date -Iseconds) | APT_CLEAN_START" >> "$INSTALL_LOG"
    chroot_run apt-get clean
}

# Remove stale hardcoded laptop panel directives from user sway overrides.
sanitize_sway_user_config() {
    local config_file="$1"
    local tmp_file

    [ -f "$config_file" ] || return 0

    if grep -Eq '^[[:space:]]*output[[:space:]]+eDP[[:alnum:]_.:-]*([[:space:]]|$)' "$config_file"; then
        tmp_file="$(mktemp)"
        awk '!/^[[:space:]]*output[[:space:]]+eDP[[:alnum:]_.:-]*([[:space:]]|$)/' "$config_file" > "$tmp_file"
        mv "$tmp_file" "$config_file"
        echo "$(date -Iseconds) | CONFIG_SANITIZE: removed stale output eDP* lines from $config_file" >> "$INSTALL_LOG"
    fi
}

sanitize_sway_configs_for_user() {
    local user_home="$1"
    sanitize_sway_user_config "$user_home/.config/sway/config.user"
    sanitize_sway_user_config "$user_home/.config/sway/config"
    sanitize_sway_user_config "$user_home/Tebian/configs/sway/config.user"
    sanitize_sway_user_config "$user_home/Tebian/configs/sway/config"
}

# ── Step 12: Install base system ──
install_base() {
    mkdir -p "$TARGET"
    mount "$PARTITION_ROOT" "$TARGET"
    if [ -n "$PARTITION_BOOT" ]; then
        mkdir -p "$TARGET/boot"
        mount "$PARTITION_BOOT" "$TARGET/boot"
    fi
    if $IS_EFI && [ -n "$PARTITION_EFI" ]; then
        mkdir -p "$TARGET/boot/efi"
        mount "$PARTITION_EFI" "$TARGET/boot/efi"
    fi

    # errexit inside the gauge subshell: bash ignores `set -e` for anything
    # on the left of `||` or inside `if`, which is how this used to run —
    # a failed kernel install or chpasswd still ended in "installed
    # successfully". Now any failing command stops the install and the ERR
    # trap records which one.
    set +e
    (
        set -eE
        trap 'echo "INSTALL_FAILED: \"$BASH_COMMAND\" (line $LINENO)" >> "$INSTALL_LOG"' ERR
        echo 2; echo "# Verifying network connectivity..."
        if ! curl -sfm10 http://deb.debian.org/debian/dists/ -o /dev/null 2>/dev/null; then
            echo "INSTALL_FAILED: No network — cannot reach deb.debian.org" >> "$INSTALL_LOG"
            echo 100; exit 1
        fi

        # Sync the clock before debootstrap. debootstrap GPG-verifies the Release
        # file, and a wrong live-session clock makes a valid signature look
        # "invalid" (no NTP has run yet on a fresh boot). Set the time from the
        # mirror's HTTP Date header — same HTTP we already use, no NTP needed.
        echo 3; echo "# Syncing clock for package verification..."
        # GET (not HEAD) — the mirror CDN strips Date from HEAD responses.
        _http_date=$(curl -sf -m10 -o /dev/null -D - http://deb.debian.org/debian/ 2>/dev/null | grep -i '^date:' | head -1 | cut -d' ' -f2- | tr -d '\r' || true)
        if [ -n "$_http_date" ]; then
            date -s "$_http_date" >> "$INSTALL_LOG" 2>&1 || true
            hwclock --systohc 2>/dev/null || true
            echo "Clock set from mirror: $_http_date" >> "$INSTALL_LOG"
        fi

        echo 5; echo "# Bootstrapping Debian base (this is the longest step)..."
        local DEB_ARCH
        DEB_ARCH=$(dpkg --print-architecture)
        # Retry debootstrap — a transient network hiccup or corrupted Release
        # download otherwise fails the whole 10-minute step. The common failure
        # (a bad-clock signature error) happens before anything is written, so a
        # plain retry over the pre-mounted target is safe.
        _dbs_ok=false
        for _dbs_try in 1 2 3; do
            if debootstrap --arch="$DEB_ARCH" "$DEBIAN_VERSION" "$TARGET" http://deb.debian.org/debian >> "$INSTALL_LOG" 2>&1; then
                _dbs_ok=true; break
            fi
            echo "debootstrap attempt $_dbs_try failed, retrying..." >> "$INSTALL_LOG"
            sleep 3
        done
        if ! $_dbs_ok; then
            echo "INSTALL_FAILED: debootstrap failed" >> "$INSTALL_LOG"
            echo 100; exit 1
        fi

        echo 35; echo "# Configuring system..."

        # fstab (no swap partition: zram is configured below)
        local root_uuid boot_uuid efi_uuid
        root_uuid=$(blkid -o value -s UUID "$PARTITION_ROOT")
        echo "UUID=$root_uuid / ext4 errors=remount-ro 0 1" > "$TARGET/etc/fstab"
        if [ -n "$PARTITION_BOOT" ]; then
            boot_uuid=$(blkid -o value -s UUID "$PARTITION_BOOT")
            echo "UUID=$boot_uuid /boot ext4 defaults 0 2" >> "$TARGET/etc/fstab"
        fi
        if $IS_EFI && [ -n "$PARTITION_EFI" ]; then
            efi_uuid=$(blkid -o value -s UUID "$PARTITION_EFI")
            echo "UUID=$efi_uuid /boot/efi vfat umask=0077 0 1" >> "$TARGET/etc/fstab"
        fi

        # crypttab — the raw partition recorded when it was encrypted, not
        # "the first LUKS partition on the disk", which on a dual-boot disk
        # can belong to another system
        if $ENCRYPT; then
            local luks_uuid
            luks_uuid=$(blkid -o value -s UUID "$LUKS_PART")
            [ -n "$luks_uuid" ]
            echo "$CRYPT_NAME UUID=$luks_uuid none luks" > "$TARGET/etc/crypttab"
        fi

        # Hostname
        echo "$HOSTNAME_VAL" > "$TARGET/etc/hostname"
        cat > "$TARGET/etc/hosts" << HOSTS
127.0.0.1   localhost
127.0.1.1   $HOSTNAME_VAL

::1         localhost ip6-localhost ip6-loopback
HOSTS

        # APT sources with non-free-firmware
        cat > "$TARGET/etc/apt/sources.list" << APT
deb http://deb.debian.org/debian $DEBIAN_VERSION main contrib non-free non-free-firmware
deb http://deb.debian.org/debian $DEBIAN_VERSION-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security $DEBIAN_VERSION-security main contrib non-free non-free-firmware
APT

        echo 40; echo "# Mounting virtual filesystems..."
        mount --bind /dev "$TARGET/dev"
        mount --bind /dev/pts "$TARGET/dev/pts"
        mount -t proc proc "$TARGET/proc"
        mount -t sysfs sys "$TARGET/sys"
        if $IS_EFI && [ -d /sys/firmware/efi/efivars ]; then
            mount --bind /sys/firmware/efi/efivars "$TARGET/sys/firmware/efi/efivars"
        fi

        # Copy resolv.conf for internet in chroot
        cp /etc/resolv.conf "$TARGET/etc/resolv.conf"

        echo 42; echo "# Updating package lists..."
        chroot_apt_update

        echo 45; echo "# Installing Linux kernel..."
        chroot_apt_install \
            "linux-image-${DEB_ARCH}"

        echo 50; echo "# Installing firmware..."
        chroot_apt_install \
            firmware-linux firmware-iwlwifi firmware-realtek \
            firmware-atheros firmware-bnx2 firmware-bnx2x \
            firmware-brcm80211 firmware-libertas firmware-misc-nonfree \
            firmware-zd1211 firmware-mediatek firmware-amd-graphics \
            firmware-sof-signed wireless-regdb rfkill

        # ── Hardware auto-detection (like standard Debian installer) ──
        echo 52; echo "# Detecting hardware..."

        # Bluetooth (always install — needed for laptops, harmless on desktops)
        chroot_apt_install \
            bluez libspa-0.2-bluetooth python3-dbus python3-gi
        chroot "$TARGET" systemctl enable bluetooth >> "$INSTALL_LOG" 2>&1

        # CPU microcode
        local cpu_vendor
        cpu_vendor=$(grep -m1 "vendor_id" /proc/cpuinfo 2>/dev/null | awk '{print $3}' || true)
        if [ "$cpu_vendor" = "GenuineIntel" ]; then
            echo 53; echo "# Installing Intel microcode..."
            chroot_apt_install intel-microcode
        elif [ "$cpu_vendor" = "AuthenticAMD" ]; then
            echo 53; echo "# Installing AMD microcode..."
            chroot_apt_install amd64-microcode
        fi

        # Laptop detection — install power management
        if grep -qsx Battery /sys/class/power_supply/*/type; then
            echo 54; echo "# Laptop detected — installing power management..."
            chroot_apt_install tlp powertop
            chroot "$TARGET" systemctl enable tlp >> "$INSTALL_LOG" 2>&1
        fi

        echo 55; echo "# Installing system tools..."
        chroot_apt_install \
            sudo bash-completion curl git nano \
            locales console-setup \
            dbus libpam-systemd \
            systemd-timesyncd zram-tools

        # Compressed swap in RAM instead of a swap partition: no partition
        # to size or encrypt (a plain swap partition leaked decrypted pages
        # on encrypted installs), and faster than disk swap on low-RAM PCs.
        # zram-tools, with the same settings tebian-onboard and Settings >
        # Performance > RAM Boost manage.
        printf 'ALGO=zstd\nPERCENT=60\n' > "$TARGET/etc/default/zramswap"

        echo 57; echo "# Configuring locale..."
        # Locale
        echo "en_US.UTF-8 UTF-8" > "$TARGET/etc/locale.gen"
        chroot "$TARGET" locale-gen >> "$INSTALL_LOG" 2>&1
        echo 'LANG=en_US.UTF-8' > "$TARGET/etc/default/locale"

        echo 58; echo "# Configuring keyboard and timezone..."

        # Keyboard layout
        cat > "$TARGET/etc/default/keyboard" << KBEOF
XKBMODEL="pc105"
XKBLAYOUT="$KB_LAYOUT"
XKBVARIANT="$KB_VARIANT"
XKBOPTIONS=""
BACKSPACE="guess"
KBEOF
        chroot "$TARGET" dpkg-reconfigure -f noninteractive keyboard-configuration >> "$INSTALL_LOG" 2>&1

        # Timezone
        ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$TARGET/etc/localtime"
        echo "$TIMEZONE" > "$TARGET/etc/timezone"
        chroot "$TARGET" dpkg-reconfigure -f noninteractive tzdata >> "$INSTALL_LOG" 2>&1

        echo 62; echo "# Installing bootloader..."
        if $IS_EFI; then
            # Signed shim + GRUB so the installed system boots with Secure
            # Boot on (the default on most PCs). The signed GRUB looks for
            # its config under \EFI\debian, so the bootloader id must stay
            # "debian". The extra copy at \EFI\BOOT\BOOTX64.EFI is what
            # firmware falls back to when it ignores or loses NVRAM entries
            # (common on some HP/MSI boards); the debconf answer keeps grub
            # package upgrades maintaining that copy.
            echo "grub-efi-amd64 grub2/force_efi_extra_removable boolean true" |
                chroot "$TARGET" debconf-set-selections
            chroot_apt_install \
                shim-signed grub-efi-amd64-signed grub-efi-amd64 efibootmgr os-prober
            if ! chroot "$TARGET" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
                    --bootloader-id=debian --uefi-secure-boot --force-extra-removable >> "$INSTALL_LOG" 2>&1; then
                echo "INSTALL_FAILED: GRUB could not be installed to the EFI partition" >> "$INSTALL_LOG"
                exit 1
            fi
        else
            chroot_apt_install \
                grub-pc os-prober
            # Keep future grub-pc upgrades installing to the right disk
            echo "grub-pc grub-pc/install_devices multiselect $DISK" |
                chroot "$TARGET" debconf-set-selections
            if ! chroot "$TARGET" grub-install --target=i386-pc "$DISK" >> "$INSTALL_LOG" 2>&1; then
                echo "INSTALL_FAILED: GRUB could not be installed to $DISK" >> "$INSTALL_LOG"
                exit 1
            fi
        fi

        echo 66; echo "# Configuring bootloader..."
        # Enable os-prober for dual-boot detection
        echo "GRUB_DISABLE_OS_PROBER=false" >> "$TARGET/etc/default/grub"

        # Clean boot: Plymouth covers the text. No console palette tricks —
        # zeroing vt.default_* made every TTY, rescue shell and fsck prompt
        # black-on-black. loglevel=3 still hides noise but shows real errors.
        sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 systemd.show_status=auto rd.udev.log_level=3"/' "$TARGET/etc/default/grub"
        sed -i 's/^#\?GRUB_GFXMODE=.*/GRUB_GFXMODE=auto/' "$TARGET/etc/default/grub"
        if $DUAL_BOOT; then
            sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/' "$TARGET/etc/default/grub"
        else
            sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/' "$TARGET/etc/default/grub"
            sed -i 's/^#\?GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' "$TARGET/etc/default/grub"
        fi

        echo 68; echo "# Installing boot splash..."
        chroot_apt_install \
            plymouth plymouth-themes

        # Install custom Tebian Plymouth theme
        local plymouth_theme_dir="$TARGET/usr/share/plymouth/themes/tebian"
        mkdir -p "$plymouth_theme_dir"
        if [ -d "$TEBIAN_SRC/assets/plymouth/tebian" ]; then
            cp "$TEBIAN_SRC/assets/plymouth/tebian/tebian.plymouth" "$plymouth_theme_dir/"
            cp "$TEBIAN_SRC/assets/plymouth/tebian/tebian.script" "$plymouth_theme_dir/"
        fi
        chroot "$TARGET" plymouth-set-default-theme tebian >> "$INSTALL_LOG" 2>&1 || true
        # Plymouth shutdown services (poweroff/reboot/halt) are statically
        # pulled in by systemd targets — no explicit enable needed.

        if $ENCRYPT; then
            chroot_apt_install \
                cryptsetup-initramfs
            # The passphrase prompt runs in the initramfs, before the
            # system's keymap loads — include it, or a non-US user types
            # their passphrase on a US layout and can't unlock
            if [ "$KB_LAYOUT" != us ]; then
                sed -i 's/^#\?KEYMAP=.*/KEYMAP=y/' "$TARGET/etc/initramfs-tools/initramfs.conf"
            fi
        fi
        # initramfs and grub.cfg are built once, at the very end, after
        # every setting that feeds them (theme, background, crypttab) exists

        echo 75; echo "# Creating user ${USERNAME}..."
        chroot "$TARGET" useradd -m -s /bin/bash -G sudo,audio,video,input,render,netdev "$USERNAME"
        echo "${USERNAME}:${USERPASS}" | chroot "$TARGET" chpasswd
        unset USERPASS

        # sudo asks for the user's password (sudo group membership above).
        # Passwordless sudo is an opt-in in Settings > Security: on by
        # default it meant any process running as the user — a browser
        # exploit, a curl|bash script — silently had root.

        # Network
        echo 80; echo "# Configuring network..."
        # wpasupplicant is only a Recommends of network-manager, and this
        # helper skips recommends — without naming it, WiFi (including the
        # network carried over below) could not connect at all
        chroot_apt_install \
            network-manager wpasupplicant
        chroot "$TARGET" systemctl enable NetworkManager >> "$INSTALL_LOG" 2>&1

        # Carry WiFi credentials from live session to installed system.
        # Check /run too — NM stores profiles created as "volatile" there
        # instead of /etc, and a live session profile may land either place.
        local nm_target="$TARGET/etc/NetworkManager/system-connections"
        local nm_src
        for nm_src in /etc/NetworkManager/system-connections /run/NetworkManager/system-connections; do
            ls "$nm_src"/*.nmconnection &>/dev/null || continue
            mkdir -p "$nm_target"
            cp "$nm_src"/*.nmconnection "$nm_target/"
        done
        if ls "$nm_target"/*.nmconnection &>/dev/null; then
            # Strip permissions= lines: profiles created by the live user are
            # locked to that username, which doesn't exist on the installed
            # system — NM would refuse to autoconnect them on first boot.
            sed -i '/^permissions=/d' "$nm_target"/*.nmconnection
            chmod 600 "$nm_target"/*.nmconnection
        fi

        echo 85; echo "# Copying Tebian files..."
        # Copy Tebian repo
        local user_home="$TARGET/home/$USERNAME"
        cp -r "$TEBIAN_SRC" "$user_home/Tebian"
        # Seed tebian-update's manifest (sha256 of every shipped file) so
        # the first update can tell the user's edits from upstream changes,
        # instead of backing up every file it touches
        mkdir -p "$user_home/.local/share/tebian"
        ( cd "$user_home/Tebian" && find . -type f ! -path './.git/*' ! -name tebian.conf -printf '%P\0' |
            sort -z | xargs -0 -r sha256sum ) > "$user_home/.local/share/tebian/manifest.sha256"
        chroot "$TARGET" chown -R "$USERNAME:$USERNAME" "/home/$USERNAME/Tebian" "/home/$USERNAME/.local"

        # Install tebian-bootstrap system-wide
        cp "$TEBIAN_SRC/bootstrap.sh" "$TARGET/usr/local/bin/tebian-bootstrap"
        chmod +x "$TARGET/usr/local/bin/tebian-bootstrap"

        # tebian-session system-wide
        if [ -f "$TEBIAN_SRC/scripts/tebian-session" ]; then
            cp "$TEBIAN_SRC/scripts/tebian-session" "$TARGET/usr/local/bin/tebian-session"
            chmod +x "$TARGET/usr/local/bin/tebian-session"
        fi

        if [ "$MODE" = "desktop" ]; then
            echo 86; echo "# Installing Sway compositor..."
            chroot_apt_install_desktop \
                sway swaybg xwayland fuzzel kitty libnotify-bin

            # Tebian's sway: Debian's, rebuilt with window snapping (see
            # tebian-build-sway). The build tools go again afterwards. If it
            # fails the install carries on with Debian's sway, which runs the
            # same config; Settings offers the build again.
            echo 86; echo "# Adding window snapping to Sway..."
            chroot_run env HOME=/root TEBIAN_DIR="/home/$USERNAME/Tebian" \
                bash "/home/$USERNAME/Tebian/scripts/tebian-build-sway" \
                    --install --clean --output /var/cache/tebian ||
                echo "$(date -Iseconds) | WARN: sway with window snapping not built; Debian's sway stays" >> "$INSTALL_LOG"

            echo 87; echo "# Installing desktop extras..."
            chroot_apt_install_desktop \
                blueman mako-notifier grim slurp wl-clipboard \
                brightnessctl lxpolkit cliphist thunar thunar-archive-plugin \
                file-roller papirus-icon-theme btop \
                pavucontrol adwaita-qt \
                udisks2 ntfs-3g dosfstools exfatprogs fdisk \
                xdg-desktop-portal-wlr xdg-desktop-portal-gtk

            echo 88; echo "# Installing audio system..."
            chroot_apt_install_desktop \
                pipewire-audio libspa-0.2-libcamera

            echo 90; echo "# Installing login screen..."
            chroot_apt_install_desktop \
                greetd nwg-hello

            echo 92; echo "# Installing fonts..."
            chroot_apt_install \
                fonts-noto fonts-jetbrains-mono

            echo 93; echo "# Downloading Nerd Font..."
            # Pinned release + checksum (from upstream's SHA-256.txt): a
            # "latest" download changes under us and can't be verified. Not
            # fatal — the desktop falls back to Debian's JetBrains Mono,
            # just without the icon glyphs.
            local nf_ver="v3.5.1"
            local nf_sha="04d5e8f903693f9dd13e16f867e994834e681eb3c72c0d337a770dcda09010cf"
            chroot_apt_install xz-utils
            if curl -fsSL --retry 3 -o "$TARGET/tmp/nf.tar.xz" \
                    "https://github.com/ryanoasis/nerd-fonts/releases/download/${nf_ver}/JetBrainsMono.tar.xz" &&
               echo "${nf_sha}  $TARGET/tmp/nf.tar.xz" | sha256sum -c --quiet - >> "$INSTALL_LOG" 2>&1; then
                mkdir -p "$TARGET/usr/local/share/fonts/JetBrainsMonoNerd"
                # Extracted inside the target: xz-utils was just installed
                # there, the live session doesn't have it
                chroot "$TARGET" tar -xf /tmp/nf.tar.xz -C /usr/local/share/fonts/JetBrainsMonoNerd
                chroot "$TARGET" fc-cache -f /usr/local/share/fonts >> "$INSTALL_LOG" 2>&1
            else
                echo "WARNING: Nerd Font download failed or checksum mismatch — skipped" >> "$INSTALL_LOG"
            fi
            rm -f "$TARGET/tmp/nf.tar.xz"

            echo 94; echo "# Configuring login manager..."
            # Set up greeter
            chroot "$TARGET" bash -c "
                useradd -r -m -s /bin/bash greeter 2>/dev/null || true
                usermod -aG video,input,render greeter
            " >/dev/null 2>&1 || true

            # Copy greetd configs
            mkdir -p "$TARGET/etc/greetd"
            cp "$TEBIAN_SRC/configs/greetd/config.toml" "$TARGET/etc/greetd/"
            cp "$TEBIAN_SRC/configs/greetd/environments" "$TARGET/etc/greetd/"

            # One-password installs open the desktop after the disk unlocks
            # (greetd initial_session, once per boot). Only when the disk
            # passphrase IS the login password: then it already proved who
            # this is. A separate passphrase keeps the normal login screen.
            if $AUTOLOGIN; then
                bash "$TEBIAN_SRC/scripts/tebian-autologin" enable --user "$USERNAME" \
                    --file "$TARGET/etc/greetd/config.toml" --assume-encrypted >> "$INSTALL_LOG" 2>&1
            fi

            # Copy nwg-hello configs
            mkdir -p "$TARGET/etc/nwg-hello"
            cp "$TEBIAN_SRC/configs/nwg-hello/nwg-hello.json" "$TARGET/etc/nwg-hello/" 2>/dev/null || true
            cp "$TEBIAN_SRC/configs/nwg-hello/nwg-hello.css" "$TARGET/etc/nwg-hello/" 2>/dev/null || true
            cp "$TEBIAN_SRC/configs/nwg-hello/tebian.glade" "$TARGET/etc/nwg-hello/" 2>/dev/null || true
            cp "$TEBIAN_SRC/configs/nwg-hello/sway-config" "$TARGET/etc/nwg-hello/" 2>/dev/null || true

            # Fix nwg-hello upstream bug (still in trixie's 0.3.0): the
            # session combo uses the session name instead of its exec. ui.py
            # belongs to the package, so an upgrade would silently undo an
            # in-place edit — an apt hook re-applies it after every dpkg run.
            # Same fix as desktop.sh installs.
            mkdir -p "$TARGET/usr/local/sbin"
            cat > "$TARGET/usr/local/sbin/tebian-nwg-hello-fix" << 'NWGFIX'
#!/bin/sh
# Re-applies Tebian's one-line nwg-hello fix; run by apt after every dpkg run.
# Safe to delete (with /etc/apt/apt.conf.d/80-tebian-nwg-hello) once Debian's
# nwg-hello selects sessions by exec.
f=/usr/lib/python3/dist-packages/nwg_hello/ui.py
if [ -f "$f" ] && grep -q 'sessions\[0\]\["name"\]' "$f"; then
    sed -i 's/sessions\[0\]\["name"\]/sessions[0]["exec"]/' "$f"
fi
exit 0
NWGFIX
            chmod 755 "$TARGET/usr/local/sbin/tebian-nwg-hello-fix"
            echo 'DPkg::Post-Invoke { "if [ -x /usr/local/sbin/tebian-nwg-hello-fix ]; then /usr/local/sbin/tebian-nwg-hello-fix; fi"; };' \
                > "$TARGET/etc/apt/apt.conf.d/80-tebian-nwg-hello"
            chroot "$TARGET" /usr/local/sbin/tebian-nwg-hello-fix

            # Clean greetd PAM (remove gnome-keyring/kwallet which cause auth failures)
            if [ -f "$TARGET/etc/pam.d/greetd" ]; then
                sed -i '/pam_gnome_keyring/d; /pam_kwallet/d' "$TARGET/etc/pam.d/greetd"
            fi

            # Pre-populate greeter cache so hidden combos have correct defaults
            mkdir -p "$TARGET/var/cache/nwg-hello"
            echo "{\"user\": \"$USERNAME\", \"sessions\": {\"$USERNAME\": \"/usr/local/bin/tebian-session\"}}" \
                > "$TARGET/var/cache/nwg-hello/cache.json"
            chroot "$TARGET" chown -R greeter:greeter /var/cache/nwg-hello

            # Greeter home directory (prevents "unable to set working directory")
            chroot "$TARGET" bash -c '
                mkdir -p /home/greeter/.local/state/wireplumber
                chown -R greeter:greeter /home/greeter
                chmod 700 /home/greeter
            ' 2>/dev/null || true

            # System wallpaper
            mkdir -p "$TARGET/usr/share/backgrounds/tebian"
            cp "$TEBIAN_SRC/assets/wallpapers/glass.jpg" "$TARGET/usr/share/backgrounds/tebian/default.jpg" 2>/dev/null || true

            # GRUB wallpaper
            if [ -f "$TARGET/etc/default/grub" ]; then
                echo 'GRUB_BACKGROUND="/usr/share/backgrounds/tebian/default.jpg"' >> "$TARGET/etc/default/grub"
            fi

            chroot "$TARGET" systemctl enable greetd >> "$INSTALL_LOG" 2>&1
            chroot "$TARGET" systemctl set-default graphical.target >> "$INSTALL_LOG" 2>&1

            # Smooth Plymouth→greeter transition
            # The '-' prefix means systemd ignores failures (e.g. plymouth not running)
            mkdir -p "$TARGET/etc/systemd/system/greetd.service.d"
            cat > "$TARGET/etc/systemd/system/greetd.service.d/plymouth.conf" << 'PLYDROP'
[Service]
ExecStartPre=-/usr/bin/plymouth deactivate
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
# Fallback: force-quit plymouth if retain-splash hangs
ExecStartPre=-/bin/sh -c 'sleep 2 && /usr/bin/plymouth quit 2>/dev/null || true'
PLYDROP

            # Boot diagnostics — logs the boot chain for debugging
            cat > "$TARGET/usr/local/bin/tebian-boot-diag" << 'DIAGEOF'
#!/bin/bash
# Tebian boot chain diagnostics
LOG="/var/log/tebian-boot-diag.log"
echo "=== Tebian Boot Diagnostics $(date) ===" >> "$LOG"
echo "Plymouth running: $(pidof plymouthd 2>/dev/null && echo yes || echo no)" >> "$LOG"
echo "greetd status: $(systemctl is-active greetd 2>/dev/null)" >> "$LOG"
echo "graphical.target: $(systemctl is-active graphical.target 2>/dev/null)" >> "$LOG"
echo "greeter user: $(id greeter 2>/dev/null || echo 'MISSING')" >> "$LOG"
echo "tebian-session: $([ -x /usr/local/bin/tebian-session ] && echo 'OK' || echo 'MISSING')" >> "$LOG"
echo "nwg-hello config: $([ -f /etc/nwg-hello/nwg-hello.json ] && echo 'OK' || echo 'MISSING')" >> "$LOG"
echo "sway-config: $([ -f /etc/nwg-hello/sway-config ] && echo 'OK' || echo 'MISSING')" >> "$LOG"
echo "greetd config: $([ -f /etc/greetd/config.toml ] && echo 'OK' || echo 'MISSING')" >> "$LOG"
echo "greeter home: $([ -d /home/greeter ] && echo 'OK' || echo 'MISSING')" >> "$LOG"
echo "nwg-hello cache: $([ -f /var/cache/nwg-hello/cache.json ] && cat /var/cache/nwg-hello/cache.json || echo 'MISSING')" >> "$LOG"
# Check if sway can find its deps
echo "sway binary: $(which sway 2>/dev/null || echo 'MISSING')" >> "$LOG"
echo "nwg-hello binary: $(which nwg-hello 2>/dev/null || echo 'MISSING')" >> "$LOG"
echo "---" >> "$LOG"
DIAGEOF
            chmod +x "$TARGET/usr/local/bin/tebian-boot-diag"

            # Run diagnostics early in boot
            cat > "$TARGET/etc/systemd/system/tebian-boot-diag.service" << 'DIAGSVC'
[Unit]
Description=Tebian boot chain diagnostics
After=multi-user.target
Before=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tebian-boot-diag

[Install]
WantedBy=graphical.target
DIAGSVC
            chroot "$TARGET" systemctl enable tebian-boot-diag >> "$INSTALL_LOG" 2>&1

            # ── User config setup (done here so first boot works immediately) ──
            echo 96; echo "# Setting up user configs..."

            # Sway config
            mkdir -p "$user_home/.config/sway"
            cp "$TEBIAN_SRC/configs/sway/config" "$user_home/.config/sway/config"
            cp "$TEBIAN_SRC/configs/themes/glass/sway-theme" "$user_home/.config/sway/theme"
            touch "$user_home/.config/sway/config.user"

            # Pre-seed keyboard layout
            if [ "$KB_LAYOUT" != "us" ]; then
                cat >> "$user_home/.config/sway/config.user" << KBSWAY
# Keyboard layout (set by installer)
input type:keyboard {
    xkb_layout $KB_LAYOUT
}
KBSWAY
            fi
            sanitize_sway_configs_for_user "$user_home"
            # Checksum of the config as installed: tebian-update replaces it
            # on later updates only while it still matches (i.e. unedited)
            mkdir -p "$user_home/.local/share/tebian"
            sha256sum "$user_home/.config/sway/config" | awk '{ print $1 }' \
                > "$user_home/.local/share/tebian/sway-config.sha256"

            # Kitty config
            mkdir -p "$user_home/.config/kitty"
            cp "$TEBIAN_SRC/configs/themes/glass/kitty.conf" "$user_home/.config/kitty/kitty.conf"

            # Fuzzel config
            mkdir -p "$user_home/.config/fuzzel"
            cp "$TEBIAN_SRC/configs/themes/glass/fuzzel.ini" "$user_home/.config/fuzzel/fuzzel.ini"

            # Environment variables
            mkdir -p "$user_home/.config/environment.d"
            if [ -d "$TEBIAN_SRC/configs/environment.d" ]; then
                cp "$TEBIAN_SRC/configs/environment.d/"* "$user_home/.config/environment.d/" 2>/dev/null || true
            fi

            # Font rendering: RGB subpixel + medium hinting. Debian's baseline
            # (hintslight, no subpixel) reads soft on 1080p panels next to
            # Windows ClearType; Ubuntu ships RGB subpixel and Fedora ships
            # medium hinting. Tunable later in Settings > UI > Font Rendering.
            mkdir -p "$user_home/.config/fontconfig/conf.d"
            cat > "$user_home/.config/fontconfig/conf.d/50-tebian-font-rendering.conf" << 'FONTEOF'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Managed by tebian-settings (UI > Font Rendering) -->
<fontconfig>
  <match target="font">
    <edit name="antialias" mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle" mode="assign"><const>hintmedium</const></edit>
    <edit name="rgba" mode="assign"><const>rgb</const></edit>
    <edit name="lcdfilter" mode="assign"><const>lcddefault</const></edit>
  </match>
</fontconfig>
FONTEOF

            # GTK3 theme (dark mode + Papirus icons)
            mkdir -p "$user_home/.config/gtk-3.0"
            cat > "$user_home/.config/gtk-3.0/settings.ini" << 'GTKEOF'
[Settings]
gtk-application-prefer-dark-theme=true
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Papirus
gtk-cursor-theme-name=Adwaita
GTKEOF
            cat > "$user_home/.config/gtk-3.0/gtk.css" << 'CSSEOF'
/* Force sidebar to use colored icons instead of symbolic (dark) ones */
placessidebar row image {
    -gtk-icon-style: regular;
}
CSSEOF

            # GTK4 theme
            mkdir -p "$user_home/.config/gtk-4.0"
            cat > "$user_home/.config/gtk-4.0/settings.ini" << 'GTK4EOF'
[Settings]
gtk-application-prefer-dark-theme=true
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Papirus
gtk-cursor-theme-name=Adwaita
GTK4EOF

            # XDG Desktop Portal config (wlr for screencasting, gtk for everything else)
            mkdir -p "$user_home/.config/xdg-desktop-portal"
            cp "$TEBIAN_SRC/configs/xdg-desktop-portal/sway-portals.conf" "$user_home/.config/xdg-desktop-portal/" 2>/dev/null || true

            # Mako notification config
            mkdir -p "$user_home/.config/mako"
            if [ -f "$TEBIAN_SRC/configs/mako/config" ]; then
                cp "$TEBIAN_SRC/configs/mako/config" "$user_home/.config/mako/config"
            fi

            # Wallpaper for user
            mkdir -p "$user_home/.local/share/backgrounds/tebian"
            cp "$TEBIAN_SRC/assets/wallpapers/glass.jpg" "$user_home/.local/share/backgrounds/tebian/default.jpg" 2>/dev/null || true

            # Install user scripts to ~/.local/bin
            mkdir -p "$user_home/.local/bin"
            for script in "$TEBIAN_SRC/scripts/"*; do
                name=$(basename "$script")
                [ -d "$script" ] && continue
                case "$name" in
                    desktop.sh|build-iso.sh|uninstall.sh|tebian-installer) continue ;;
                    *) cp "$script" "$user_home/.local/bin/" ;;
                esac
            done
            chmod +x "$user_home/.local/bin/"* 2>/dev/null || true

            # Copy modular settings directory
            if [ -d "$TEBIAN_SRC/scripts/tebian-settings.d" ]; then
                mkdir -p "$user_home/.local/bin/tebian-settings.d"
                cp "$TEBIAN_SRC/scripts/tebian-settings.d/"*.sh "$user_home/.local/bin/tebian-settings.d/" 2>/dev/null || true
            fi

            # Drive Doctor's root half. The probe must be root-owned and
            # outside the user's home: udev runs it as root on every USB
            # plug-in, so a user-writable copy would be a privilege escalation.
            install -o root -g root -m 755 "$TEBIAN_SRC/scripts/tebian-drive-probe" \
                "$TARGET/usr/local/bin/tebian-drive-probe"
            mkdir -p "$TARGET/etc/udev/rules.d"
            install -o root -g root -m 644 "$TEBIAN_SRC/configs/udev/90-tebian-drive-doctor.rules" \
                "$TARGET/etc/udev/rules.d/90-tebian-drive-doctor.rules"

            # Default bar stats to OFF (user can enable in Settings > Screen)
            mkdir -p "$user_home/.config/tebian"
            touch "$user_home/.config/tebian/bar_perf_off"

            # Standard directories
            mkdir -p "$user_home/Pictures/Screenshots" "$user_home/Downloads" \
                     "$user_home/Applications" "$user_home/Workspace"

            # Ensure PATH includes ~/.local/bin
            if ! grep -q '\.local/bin' "$user_home/.bashrc" 2>/dev/null; then
                echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$user_home/.bashrc"
            fi

            # t-fetch on login (skip on tty7 to prevent flash during greetd→sway transition)
            cat >> "$user_home/.bashrc" << 'BASHRC'

# Tebian Startup Fetch (skip during greetd→sway transition on tty7)
if [ -t 1 ] && command -v t-fetch >/dev/null && [ "$(tty)" != "/dev/tty7" ]; then
    t-fetch
fi
BASHRC

            chroot "$TARGET" chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"
        elif [ "$MODE" = "server-secure" ] || [ "$MODE" = "server-bare" ]; then
            echo 87; echo "# Installing server essentials..."
            chroot_apt_install \
                openssh-server ca-certificates less wget \
                man-db manpages file lsof pciutils bzip2 \
                bind9-dnsutils traceroute
            chroot "$TARGET" systemctl enable ssh >> "$INSTALL_LOG" 2>&1

            if [ "$MODE" = "server-secure" ]; then
                echo 92; echo "# Installing security hardening..."
                chroot_apt_install \
                    ufw fail2ban btop unzip

                # ufw's commands here only write rule files. `ufw enable` is
                # avoided on purpose: inside the chroot it would load the
                # rules into the *live session's* kernel. ENABLED=yes plus
                # the unit brings it up on the installed system's first boot.
                chroot "$TARGET" ufw default deny incoming >> "$INSTALL_LOG" 2>&1
                chroot "$TARGET" ufw allow OpenSSH >> "$INSTALL_LOG" 2>&1
                sed -i 's/^ENABLED=.*/ENABLED=yes/' "$TARGET/etc/ufw/ufw.conf"
                chroot "$TARGET" systemctl enable ufw fail2ban >> "$INSTALL_LOG" 2>&1
            fi
        fi

        # Fix Steam AppArmor profile (Trixie default blocks pressure-vessel sandbox)
        if [ -f "$TARGET/etc/apparmor.d/steam" ]; then
            cat > "$TARGET/etc/apparmor.d/steam" << 'STEAMEOF'
# Steam and all its child processes (pressure-vessel, bwrap, games)
# need full system access including unprivileged user namespaces.

abi <abi/4.0>,
include <tunables/global>

profile steam /usr/{lib/steam/bin_steam.sh,games/steam} flags=(unconfined) {
  userns,

  include if exists <local/steam>
}
STEAMEOF
        fi

        # Fix broken AppArmor 4.0 "allows everything" profiles (Trixie bug)
        # These profiles claim to be unconfined but lack flags=(unconfined),
        # blocking basic shared library loading for flatpak, busybox, etc.
        for aa_profile in "$TARGET"/etc/apparmor.d/*; do
            [ -f "$aa_profile" ] || continue
            if grep -q "allows everything" "$aa_profile" 2>/dev/null; then
                if grep -q "flags=" "$aa_profile" && ! grep -q "unconfined" "$aa_profile"; then
                    # Has flags but not unconfined — append unconfined to existing flags
                    sed -i 's/flags=(\([^)]*\))/flags=(\1, unconfined)/' "$aa_profile"
                elif ! grep -q "flags=" "$aa_profile"; then
                    # No flags at all — add flags=(unconfined)
                    sed -i 's/profile \(.*\) {$/profile \1 flags=(unconfined) {/' "$aa_profile"
                fi
            fi
        done

        echo 97; echo "# Building boot files..."
        chroot "$TARGET" update-initramfs -u -k all >> "$INSTALL_LOG" 2>&1
        chroot "$TARGET" update-grub >> "$INSTALL_LOG" 2>&1

        echo 98; echo "# Final cleanup..."
        chroot_apt_clean

        # Ensure unique machine-id is generated on first boot (not copied from live session)
        truncate -s 0 "$TARGET/etc/machine-id"

        echo 100; echo "# Installation complete!"
    ) | progress "Installing Tebian..."
    local rc=${PIPESTATUS[0]}
    set -e
    if [ "$rc" -ne 0 ]; then
        grep -q INSTALL_FAILED "$INSTALL_LOG" || echo "INSTALL_FAILED: installer stage exited $rc" >> "$INSTALL_LOG"
        install_failed
    fi

    # Check if install succeeded (look for failure marker in log)
    if grep -q "INSTALL_FAILED" "$INSTALL_LOG" 2>/dev/null; then
        install_failed
    fi

    # Verify critical files exist on installed system
    if [ ! -f "$TARGET/etc/fstab" ] || ! ls "$TARGET"/boot/vmlinuz-* &>/dev/null ||
       ! ls "$TARGET"/boot/initrd.img-* &>/dev/null || [ ! -f "$TARGET/boot/grub/grub.cfg" ]; then
        echo "INSTALL_FAILED: base system incomplete (kernel, initramfs or grub.cfg missing)" >> "$INSTALL_LOG"
        install_failed
    fi

    # Keep the log on the installed system, like Debian's /var/log/installer,
    # and which ISO it came from (version + commit, written by build-iso.sh)
    install -m 600 "$INSTALL_LOG" "$TARGET/var/log/tebian-install.log"
    [ -f /etc/tebian-release ] && install -m 644 /etc/tebian-release "$TARGET/etc/tebian-release"
}

# ── Cleanup ──
cleanup() {
    # Unmount efivars first (bind mount inside /sys won't unmount with -R reliably)
    umount "$TARGET/sys/firmware/efi/efivars" 2>/dev/null || true
    umount -R "$TARGET" 2>/dev/null || true
    # By mapping, not $ENCRYPT: a failure mid-partitioning can leave the
    # volume open before ENCRYPT is set
    [ -e "/dev/mapper/$CRYPT_NAME" ] && cryptsetup close "$CRYPT_NAME" 2>/dev/null || true
}

# ── Main (step-based with back navigation) ──
main() {
    trap cleanup EXIT

    # Must be root
    if [ "$(id -u)" -ne 0 ]; then
        die "The installer must be run as root.\n\nRun: sudo tebian-installer"
    fi

    echo "=== Tebian Install $(date) ===" > "$INSTALL_LOG"
    chmod 600 "$INSTALL_LOG"

    local fwcfg=/sys/firmware/qemu_fw_cfg/by_name/opt/org.tebian/answers/raw
    if [ "${1:-}" = "--answers" ]; then
        load_answers "${2:?--answers needs a file}"
    else
        modprobe qemu_fw_cfg 2>/dev/null || true
        [ -r "$fwcfg" ] && load_answers "$fwcfg"
    fi

    detect_efi

    # Steps only collect answers; cancel on any step goes back to the
    # previous one. Nothing touches the disk until apply_disk_plan, after
    # confirm. Encryption is asked before partitioning because an
    # encrypted install needs a separate /boot partition.
    local step=0
    local steps=(welcome select_keyboard select_timezone setup_network select_disk setup_encryption select_partition_mode setup_user select_mode confirm)

    while [ $step -lt ${#steps[@]} ]; do
        if ${steps[$step]}; then
            step=$((step + 1))
        else
            # Cancel pressed — go back (but not before first step)
            if [ $step -gt 0 ]; then
                step=$((step - 1))
            else
                # Cancel on welcome = exit to shell
                echo ""
                echo "  Type 'sudo tebian-installer' to return to the installer."
                echo ""
                exit 0
            fi
        fi
    done

    # All steps passed — now write to disk
    apply_disk_plan
    install_base

    cleanup

    if $AUTO; then
        echo "INSTALL_OK" >> "$INSTALL_LOG"
        poweroff
    fi

    wt --title "  Installation Complete" --msgbox "\
Tebian has been installed successfully!

$(if [ "$MODE" = "desktop" ]; then
    echo "On first login, you'll be asked to choose"
    echo "Base (minimal tiling) or Desktop (familiar) mode."
elif [ "$MODE" = "server-secure" ]; then
    echo "SSH and firewall are enabled."
    echo "Connect via: ssh ${USERNAME}@<ip-address>"
else
    echo "SSH is enabled. Pure Debian otherwise."
    echo "Connect via: ssh ${USERNAME}@<ip-address>"
fi)

Remove the installation media and press OK to reboot." $WT_HEIGHT $WT_WIDTH

    reboot
}

main "$@"
