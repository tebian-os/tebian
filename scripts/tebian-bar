#!/bin/bash
# ==============================================================================
# TEBIAN BAR
# The Modern bar: Waybar, with hover-highlighted buttons whose menus drop down
# from the bar. Started by sway as `swaybar_command` (Settings > Desktop & UI >
# Bar Style writes that into config.user), so sway still owns the bar's
# lifecycle and restarts it on reload.
#
# Falls back to plain swaybar whenever Waybar or its config is missing — a
# bar must always come up. Users who want their own Waybar setup create
# ~/.config/waybar/config.jsonc (and style.css); those then win over Tebian's.
# ==============================================================================
set -u

TEBIAN_DIR="${TEBIAN_DIR:-$HOME/Tebian}"
SHIP="$TEBIAN_DIR/configs/waybar"
RUN="${XDG_RUNTIME_DIR:-/tmp}/tebian-bar"
mkdir -p "$RUN"

if ! command -v waybar >/dev/null || [ ! -f "$SHIP/config.jsonc" ]; then
    exec swaybar "$@"
fi

# Position comes from sway's own bar config, so Settings > Bar Position (and
# any `bar bar-0 position` line) applies to whichever bar is running
pos=$(swaymsg -r -t get_bar_config bar-0 2>/dev/null |
      sed -n 's/.*"position": *"\([a-z]*\)".*/\1/p' | head -1)
[ "$pos" = bottom ] || pos=top
# Inherited by every on-click command, so drop-down menus open on this edge
export TEBIAN_BAR_POSITION="$pos"

if [ -f "$HOME/.config/waybar/config.jsonc" ]; then
    config="$HOME/.config/waybar/config.jsonc"
else
    config="$RUN/config.jsonc"
    # 12-hour clock (Settings > Desktop & UI > Clock): the shipped formats
    # use %H:%M, swapped here like the position
    hours=24
    [ -f "$HOME/.config/tebian/clock-12h" ] && hours=12
    sed -e "s/\"position\": \"top\"/\"position\": \"$pos\"/" \
        -e "$([ "$hours" = 12 ] && echo 's/%H:%M/%I:%M %p/g' || echo ':')" \
        "$SHIP/config.jsonc" > "$config.tmp" &&
        mv -f "$config.tmp" "$config"
fi

# Colours come from the active theme's sway palette ($base, $text, $accent
# ...), so all themes style the bar with no per-theme bar files. Regenerated
# on every start; a theme switch reloads sway, which restarts the bar.
{
    echo "/* Generated by tebian-bar from ~/.config/sway/theme */"
    sed -nE 's/^set \$([a-z0-9]+)[[:space:]]+(#[0-9A-Fa-f]{6}).*/@define-color \1 \2;/p' \
        "$HOME/.config/sway/theme" 2>/dev/null
} > "$RUN/colors.css"

if [ -f "$HOME/.config/waybar/style.css" ]; then
    style="$HOME/.config/waybar/style.css"
else
    style="$RUN/style.css"
    cat "$RUN/colors.css" "$SHIP/style.css" > "$style.tmp" && mv -f "$style.tmp" "$style"
fi

# The drop-down panels daemon (tebian-panels, optional) lives and dies with
# the bar. Sway stops a bar by signalling the PID it started — this script —
# not its process group, so a plain background child would outlive every
# reload and pile up. Hence supervise both and take both down together.
panels_pid=""
if command -v quickshell >/dev/null && [ -x "$(command -v tebian-panels)" ]; then
    # Sway hands the bar a pre-connected socket (WAYLAND_SOCKET) that only
    # one client may use — it's Waybar's. The panels connect normally.
    env -u WAYLAND_SOCKET tebian-panels run >/dev/null 2>&1 &
    panels_pid=$!
fi

# sway passes `-b bar-0`; with "ipc": true Waybar then follows sway's bar
# mode, so Hide Bar / show-on-Super keep working
waybar -c "$config" -s "$style" "$@" &
bar_pid=$!

trap 'kill $bar_pid $panels_pid 2>/dev/null; exit 0' TERM INT HUP
wait "$bar_pid"
# Waybar exited on its own (crash, or killed directly): don't strand the panels
[ -n "$panels_pid" ] && kill "$panels_pid" 2>/dev/null
exit 0
