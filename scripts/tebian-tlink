#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
elif [ -f "$HOME/.local/bin/tebian-common" ]; then
    source "$HOME/.local/bin/tebian-common"
fi

get_term() {
    if command -v kitty &>/dev/null; then echo "kitty -e"
    elif command -v foot &>/dev/null; then echo "foot -e"
    elif command -v alacritty &>/dev/null; then echo "alacritty -e"
    elif command -v xterm &>/dev/null; then echo "xterm -e"
    else echo "kitty -e"
    fi
}
TERM_CMD=$(get_term)

CONFIG_DIR="$HOME/.config/tebian"
SERVERS_FILE="$CONFIG_DIR/servers.conf"
TEMPLATES_DIR="$CONFIG_DIR/templates"

mkdir -p "$CONFIG_DIR"
mkdir -p "$TEMPLATES_DIR"

# A loop, not each action calling the menu again when done: those calls
# nested, and an action that forgot to make one (Deploy App, a Back inside
# One-Click Apps) dropped out of T-Link altogether
tlink_menu() {
    if [ ! -f "$SERVERS_FILE" ]; then
        echo "# Tebian Servers Config" > "$SERVERS_FILE"
        echo "# Format: name=ip" >> "$SERVERS_FILE"
    fi

    while true; do
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)

    MENU="󰌍 Back
─────────────────────────────────
󰌄 SERVERS"

    if [ -z "$SERVERS" ]; then
        MENU+="
  No servers yet: pick to add one"
    else
        # All pinged at once: one after another, each unreachable server
        # held the menu back a second before it appeared
        local up i=0
        up=$(mktemp -d)
        for server in $SERVERS; do
            IP=$(grep "^$server=" "$SERVERS_FILE" | cut -d= -f2)
            { ping -c 1 -W 1 "$IP" &>/dev/null && touch "$up/$i"; } &
            i=$((i + 1))
        done
        wait
        i=0
        for server in $SERVERS; do
            if [ -e "$up/$i" ]; then STATUS="●"; else STATUS="○"; fi
            MENU+="
  $STATUS $server"
            i=$((i + 1))
        done
        rm -rf "$up"
    fi

    MENU+="
─────────────────────────────────
󰆓 Add Server
󰚰 Setup Fresh Server
─────────────────────────────────
󰆲 Deploy App
󰆲 Redeploy (Tested First)
󰆲 One-Click Apps
─────────────────────────────────
󰋜 Quick Actions
  Shell Into Server
  View All Containers
  View Resource Usage
  Update All Servers"

    CHOICE=$(echo -e "$MENU" | tfuzzel -d -p " 󰌄 T-Link | " --width 45 --lines 25)

    # Escape closes T-Link and the Settings it was opened from (non-zero
    # tells Settings so); Back returns to Settings' T-Link menu
    [ -n "$CHOICE" ] || exit 1
    if is_back "$CHOICE"; then
        exit 0
    fi

    # Server rows first and by shape: they hold the server's own name, and
    # one called "Redeploy" or "One-Click" ran that action instead
    if [[ "$CHOICE" =~ ^[[:space:]]*[●○][[:space:]] ]]; then
        server_detail "$CHOICE"
    elif [[ "$CHOICE" =~ "Add Server" ]]; then
        add_server
    elif [[ "$CHOICE" =~ "Setup Fresh" ]]; then
        setup_server
    elif [[ "$CHOICE" =~ "Deploy App" ]]; then
        deploy_menu
    elif [[ "$CHOICE" =~ "Redeploy" ]]; then
        zero_downtime_deploy
    elif [[ "$CHOICE" =~ "One-Click" ]]; then
        one_click_apps
    elif [[ "$CHOICE" =~ "Shell Into" ]]; then
        shell_server
    elif [[ "$CHOICE" =~ "View All Containers" ]]; then
        view_all_containers
    elif [[ "$CHOICE" =~ "Resource Usage" ]]; then
        resource_usage
    elif [[ "$CHOICE" =~ "Update All" ]]; then
        update_all_servers
    elif [[ "$CHOICE" =~ "No servers yet" ]]; then
        add_server
    fi
    # Anything else (the SERVERS and Quick Actions headings): show it again
    done
}

# The server names on one line: a newline-separated list pasted into the
# terminal scripts' "for server in ..." was a syntax error with two servers
tlink_server_words() {
    echo $SERVERS
}

# Typed or picked values below go into command lines run here and on the
# server: hold them to what they can legitimately be
tlink_valid_port() {
    [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ] && return 0
    notify-send "T-Link" "Not a port number: $1"
    return 1
}
tlink_valid_app() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && return 0
    notify-send "T-Link" "Can't use \"$1\" as an app name: letters, digits, . _ - only"
    return 1
}

add_server() {
    NAME=$(echo "" | tfuzzel -d -p " Server Name (e.g. web1): " --width 40)
    [ -z "$NAME" ] && return
    # Both end up unquoted in ssh command lines and in a name=ip file read
    # back with grep and word splitting: a space, = or quote broke every
    # menu after it, and could run a command
    if [[ ! "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        notify-send "T-Link" "Not added: a server name is letters, digits, . _ - (no spaces)"
        return
    fi
    if grep -q "^$NAME=" "$SERVERS_FILE"; then
        notify-send "T-Link" "Not added: there is already a server called $NAME"
        return
    fi

    IP=$(echo "" | tfuzzel -d -p " IP Address or Hostname: " --width 40)
    [ -z "$IP" ] && return
    if [[ ! "$IP" =~ ^[A-Za-z0-9][A-Za-z0-9.:-]*$ ]]; then
        notify-send "T-Link" "Not added: $IP is not an IP address or hostname"
        return
    fi

    echo "$NAME=$IP" >> "$SERVERS_FILE"
    notify-send "T-Link" "Server $NAME added"
}

setup_server() {
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)
    
    if [ -z "$SERVERS" ]; then
        notify-send "T-Link" "No servers configured"
        return
    fi

    CHOICE=$(echo -e "󰌍 Back\n$SERVERS" | tfuzzel -d -p " Setup Server | ")
    
    [ -z "$CHOICE" ] || is_back "$CHOICE" && return

    IP=$(grep "^$CHOICE=" "$SERVERS_FILE" | cut -d= -f2)
    
    DISTRO=$(echo -e "󰌍 Back\nDebian/Ubuntu\nAlpine" | tfuzzel -d -p " Distro | ")
    
    [ -z "$DISTRO" ] || is_back "$DISTRO" && return

    if [[ "$DISTRO" =~ "Alpine" ]]; then
        setup_alpine "$CHOICE" "$IP"
    else
        setup_debian "$CHOICE" "$IP"
    fi
}

setup_debian() {
    SERVER="$1"
    IP="$2"
    
    $TERM_CMD bash -c "
        echo '════════════════════════════════════════'
        echo '  T-LINK SERVER SETUP (Debian)'
        echo '  Server: $SERVER ($IP)'
        echo '════════════════════════════════════════'
        echo ''
        
        echo 'Testing SSH connection...'
        if ! ssh -o ConnectTimeout=5 -o BatchMode=yes root@$IP 'echo ok' 2>/dev/null; then
            echo ''
            echo 'Cannot connect. Make sure:'
            echo '  1. Server is reachable'
            echo '  2. Its host key is known: connect once with'
            echo '     ssh root@$IP and check the fingerprint it shows'
            echo '     against your provider'\''s console before saying yes'
            echo '  3. Your SSH key is authorized'
            echo '     Run: ssh-copy-id root@$IP'
            echo ''
            read -p 'Press Enter...'
            exit 1
        fi
        echo '✓ SSH connected'
        echo ''
        
        # Every step must work: a firewall that silently failed to come up
        # used to end in SERVER READY all the same
        fail() { echo \"✗ \$1 failed — server not ready\"; read -p 'Press Enter...'; exit 1; }

        echo '[1/6] Installing Docker...'
        ssh root@$IP 'apt update && apt install -y docker.io docker-compose' || fail Docker
        echo '✓ Docker installed'
        echo ''
        
        echo '[2/6] Setting up firewall (UFW)...'
        ssh root@$IP 'apt install -y ufw && ufw allow ssh && ufw allow http && ufw allow https && ufw --force enable' || fail Firewall
        echo '✓ UFW configured'
        echo ''
        
        echo '[3/6] Installing fail2ban...'
        ssh root@$IP 'apt install -y fail2ban && systemctl enable --now fail2ban' || fail fail2ban
        echo '✓ fail2ban running'
        echo ''
        
        echo '[4/6] Creating folder structure...'
        ssh root@$IP 'mkdir -p /opt/apps /opt/data /opt/config /opt/backups' || fail Folders
        echo '✓ Folders created'
        echo ''
        
        echo '[5/6] Enabling auto-updates...'
        ssh root@$IP 'apt install -y unattended-upgrades && dpkg-reconfigure -f noninteractive unattended-upgrades' || fail Auto-updates
        echo '✓ Auto-updates enabled'
        echo ''
        
        echo '[6/6] Installing helpful tools...'
        ssh root@$IP 'apt install -y htop iotop ncdu' || fail Tools
        echo '✓ Tools installed'
        echo ''
        
        echo '════════════════════════════════════════'
        echo '  ✓ SERVER READY'
        echo '════════════════════════════════════════'
        echo ''
        echo '$SERVER is ready for deployments!'
        echo ''
        read -p 'Press Enter...'
    "
}

setup_alpine() {
    SERVER="$1"
    IP="$2"
    
    $TERM_CMD bash -c "
        echo '════════════════════════════════════════'
        echo '  T-LINK SERVER SETUP (Alpine)'
        echo '  Server: $SERVER ($IP)'
        echo '════════════════════════════════════════'
        echo ''
        
        echo 'Testing SSH connection...'
        if ! ssh -o ConnectTimeout=5 -o BatchMode=yes root@$IP 'echo ok' 2>/dev/null; then
            echo ''
            echo 'Cannot connect. Make sure:'
            echo '  1. Server is reachable'
            echo '  2. Its host key is known: connect once with'
            echo '     ssh root@$IP and check the fingerprint it shows'
            echo '     against your provider'\''s console before saying yes'
            echo '  3. Your SSH key is authorized'
            echo '     Run: ssh-copy-id root@$IP'
            echo ''
            read -p 'Press Enter...'
            exit 1
        fi
        echo '✓ SSH connected'
        echo ''
        
        fail() { echo \"✗ \$1 failed — server not ready\"; read -p 'Press Enter...'; exit 1; }

        echo '[1/5] Installing Docker...'
        ssh root@$IP 'apk add docker docker-cli-compose && rc-update add docker boot && service docker start' || fail Docker
        echo '✓ Docker installed'
        echo ''
        
        echo '[2/5] Setting up firewall...'
        ssh root@$IP 'apk add iptables iptables-openrc && rc-update add iptables boot && service iptables start && iptables -P INPUT DROP && iptables -A INPUT -i lo -j ACCEPT && iptables -A INPUT -p tcp --dport 22 -j ACCEPT && iptables -A INPUT -p tcp --dport 80 -j ACCEPT && iptables -A INPUT -p tcp --dport 443 -j ACCEPT && iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT && /etc/init.d/iptables save' || fail Firewall
        echo '✓ Firewall configured'
        echo ''
        
        echo '[3/5] Creating folder structure...'
        ssh root@$IP 'mkdir -p /opt/apps /opt/data /opt/config /opt/backups' || fail Folders
        echo '✓ Folders created'
        echo ''
        
        echo '[4/5] Installing helpful tools...'
        ssh root@$IP 'apk add htop ncdu bash' || fail Tools
        echo '✓ Tools installed'
        echo ''
        
        echo '[5/5] Enabling auto-updates...'
        ssh root@$IP 'apk add apk-autoupdate && rc-update add apk-autoupdate boot' || fail Auto-updates
        echo '✓ Auto-updates enabled'
        echo ''
        
        echo '════════════════════════════════════════'
        echo '  ✓ SERVER READY'
        echo '════════════════════════════════════════'
        echo ''
        echo '$SERVER (Alpine) is ready for deployments!'
        echo ''
        read -p 'Press Enter...'
    "
}

server_detail() {
    SERVER_LINE="$1"
    # Strip the status icon, keep the full name (names may contain - or .)
    SERVER=$(echo "$SERVER_LINE" | sed 's/^[[:space:]]*[●○][[:space:]]*//; s/[[:space:]]*$//')
    IP=$(grep "^$SERVER=" "$SERVERS_FILE" | cut -d= -f2)

    while true; do
    # Get containers
    CONTAINERS=$(ssh root@$IP "docker ps --format '{{.Names}}'" 2>/dev/null)
    CONTAINER_COUNT=$(echo "$CONTAINERS" | wc -w)
    
    MENU="󰌍 Back
─────────────────────────────────
󰌄 $SERVER ($IP)
  $CONTAINER_COUNT containers running
─────────────────────────────────
󰋜 Shell In
󰋜 View Logs
󰋜 View Resource Usage
󰚰 Update System
─────────────────────────────────
󰆲 Deploy App Here
󰆲 Install One-Click App
󰆲 Setup SSL (Caddy)
─────────────────────────────────
󰘓 Restart Server
󰌌 Remove Server"

    CHOICE=$(echo -e "$MENU" | tfuzzel -d -p " $SERVER | " --width 45 --lines 20)
    
    [ -n "$CHOICE" ] || exit 1
    is_back "$CHOICE" && return

    # Whole labels: the heading row holds the server's name, and a server
    # called "Restart" rebooted when its own heading was picked
    if [[ "$CHOICE" == *"Shell In" ]]; then
        $TERM_CMD ssh root@$IP
    elif [[ "$CHOICE" == *"View Logs" ]]; then
        container_logs "$IP"
    elif [[ "$CHOICE" == *"View Resource Usage" ]]; then
        $TERM_CMD ssh root@$IP "htop"
    elif [[ "$CHOICE" == *"Update System" ]]; then
        $TERM_CMD ssh root@$IP "apt update && apt upgrade -y && read -p 'Done. Press Enter...'"
    elif [[ "$CHOICE" == *"Deploy App Here" ]]; then
        deploy_to_server "$IP" "$SERVER"
    elif [[ "$CHOICE" == *"Install One-Click App" ]]; then
        one_click_to_server "$IP" "$SERVER"
    elif [[ "$CHOICE" == *"Setup SSL (Caddy)" ]]; then
        setup_caddy "$IP" "$SERVER"
    elif [[ "$CHOICE" == *"Restart Server" ]]; then
        # Everything running on it goes down for a minute: ask first
        local sure
        sure=$(echo -e "No, leave it running\nYes, restart $SERVER now" | tfuzzel -d --match-mode=exact -p " Restart $SERVER? | " --width 45)
        [[ "$sure" == Yes* ]] || continue
        ssh root@$IP "reboot"
        notify-send "T-Link" "$SERVER rebooting"
        # Server is rebooting — don't recurse into a dead detail menu
        return
    elif [[ "$CHOICE" == *"Remove Server" ]]; then
        # Only forgets it here (the server itself is untouched), but its
        # address is gone with it, so ask
        local sure
        sure=$(echo -e "No, keep it\nYes, remove $SERVER from this list" | tfuzzel -d --match-mode=exact -p " Remove $SERVER? | " --width 45)
        [[ "$sure" == Yes* ]] || continue
        sed -i "/^$SERVER=/d" "$SERVERS_FILE"
        notify-send "T-Link" "$SERVER removed"
        # Server is gone — back to the main list
        return
    fi
    done
}

container_logs() {
    IP="$1"
    CONTAINERS=$(ssh root@$IP "docker ps --format '{{.Names}}'" 2>/dev/null)
    
    if [ -z "$CONTAINERS" ]; then
        notify-send "T-Link" "No containers running"
        return
    fi
    
    CONTAINER=$(echo -e "󰌍 Back\n$CONTAINERS" | tfuzzel -d -p " Container | ")
    
    [ -z "$CONTAINER" ] || is_back "$CONTAINER" && return
    
    $TERM_CMD ssh root@$IP "docker logs -f --tail 100 $CONTAINER"
}

deploy_menu() {
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)
    
    if [ -z "$SERVERS" ]; then
        notify-send "T-Link" "No servers configured"
        return
    fi
    
    SERVER=$(echo -e "󰌍 Back\n$SERVERS" | tfuzzel -d -p " Deploy to | ")
    
    [ -z "$SERVER" ] || is_back "$SERVER" && return
    
    IP=$(grep "^$SERVER=" "$SERVERS_FILE" | cut -d= -f2)
    deploy_to_server "$IP" "$SERVER"
}

deploy_to_server() {
    IP="$1"
    SERVER="$2"
    
    # Ask for project source
    SOURCE_TYPE=$(echo -e "󰌍 Back\nLocal Folder\nGit Repository" | tfuzzel -d -p " Source | ")
    
    [ -z "$SOURCE_TYPE" ] || is_back "$SOURCE_TYPE" && return
    
    if [[ "$SOURCE_TYPE" =~ "Local" ]]; then
        FOLDERS=$(find ~/Projects ~/projects ~/code ~/src -maxdepth 1 -type d 2>/dev/null | head -15)
        if [ -z "$FOLDERS" ]; then
            notify-send "T-Link" "No project folders found: put your project in ~/Projects, ~/code or ~/src"
            return
        fi
        FOLDER=$(echo -e "󰌍 Back\n$FOLDERS" | tfuzzel -d -p " Folder | " --width 50)
        [ -z "$FOLDER" ] || is_back "$FOLDER" && return
        
        APP_NAME=$(basename "$FOLDER")
        tlink_valid_app "$APP_NAME" || return
        
    elif [[ "$SOURCE_TYPE" =~ "Git" ]]; then
        REPO=$(echo "" | tfuzzel -d -p " Git URL: " --width 50)
        [ -z "$REPO" ] && return
        
        APP_NAME=$(basename "$REPO" | sed 's/.git$//')
        tlink_valid_app "$APP_NAME" || return
        FOLDER="/tmp/tlink-$APP_NAME"
        
        rm -rf "$FOLDER"
        git clone "$REPO" "$FOLDER" || { notify-send "T-Link" "Git clone failed"; return; }
    fi
    
    # Check for Dockerfile
    if [ ! -f "$FOLDER/Dockerfile" ]; then
        $TERM_CMD bash -c "
            echo 'No Dockerfile found in $FOLDER'
            echo ''
            echo 'Create a Dockerfile to deploy this project.'
            echo ''
            echo 'Example Dockerfile:'
            echo '  FROM node:20'
            echo '  WORKDIR /app'
            echo '  COPY . .'
            echo '  RUN npm install'
            echo '  CMD [\"npm\", \"start\"]'
            echo ''
            read -p 'Press Enter...'
        "
        return
    fi
    
    # Ask for port. Escape cancels: it used to deploy on 3000 anyway
    PORT=$(echo -e "3000\n8080\n8000\n5000" | tfuzzel -d -p " Port (pick or type) | ")
    [ -z "$PORT" ] && return
    tlink_valid_port "$PORT" || return
    
    $TERM_CMD bash -c "
        echo '════════════════════════════════════════'
        echo '  DEPLOYING $APP_NAME'
        echo '  Server: $SERVER ($IP)'
        echo '════════════════════════════════════════'
        echo ''
        
        echo '[1/4] Building Docker image...'
        cd '$FOLDER'
        docker build -t $APP_NAME:latest . || { echo 'Build failed!'; read -p 'Press Enter...'; exit 1; }
        echo '✓ Image built'
        echo ''
        
        echo '[2/4] Saving & uploading...'
        docker save $APP_NAME:latest | gzip > /tmp/$APP_NAME.tar.gz
        scp /tmp/$APP_NAME.tar.gz root@$IP:/tmp/
        echo '✓ Uploaded'
        echo ''
        
        echo '[3/4] Loading on server...'
        ssh root@$IP 'docker load < /tmp/$APP_NAME.tar.gz && rm /tmp/$APP_NAME.tar.gz'
        echo '✓ Loaded'
        echo ''
        
        echo '[4/4] Starting container...'
        ssh root@$IP 'docker stop $APP_NAME 2>/dev/null; docker rm $APP_NAME 2>/dev/null'
        # Published on the server's loopback only: Docker's own iptables
        # rules go around UFW, so -p $PORT:$PORT put every app on the
        # internet unencrypted, firewall or not. Caddy proxies to it.
        ssh root@$IP 'docker run -d --name $APP_NAME --restart unless-stopped -p 127.0.0.1:$PORT:$PORT $APP_NAME:latest' || { echo '✗ Start failed'; read -p 'Press Enter...'; exit 1; }
        echo '✓ Running'
        echo ''
        
        echo '════════════════════════════════════════'
        echo '  ✓ DEPLOYED'
        echo '════════════════════════════════════════'
        echo ''
        echo 'Running on the server at localhost:$PORT (not exposed).'
        echo 'Publish it with HTTPS: server > Setup SSL (Caddy), port $PORT.'
        echo 'Or look now through a tunnel: ssh -L $PORT:localhost:$PORT root@$IP'
        echo ''
        read -p 'Press Enter...'
    "
}

zero_downtime_deploy() {
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)
    
    if [ -z "$SERVERS" ]; then
        notify-send "T-Link" "No servers configured"
        return
    fi
    
    SERVER=$(echo -e "󰌍 Back\n$SERVERS" | tfuzzel -d -p " Deploy to | ")
    
    [ -z "$SERVER" ] || is_back "$SERVER" && return
    
    IP=$(grep "^$SERVER=" "$SERVERS_FILE" | cut -d= -f2)
    
    # Get running apps
    APPS=$(ssh root@$IP "docker ps --format '{{.Names}}'" 2>/dev/null)
    
    if [ -z "$APPS" ]; then
        notify-send "T-Link" "No apps running on $SERVER"
        return
    fi
    
    APP=$(echo -e "󰌍 Back\n$APPS" | tfuzzel -d -p " Update App | ")
    
    [ -z "$APP" ] || is_back "$APP" && return
    
    # Get source
    SOURCE_TYPE=$(echo -e "󰌍 Back\nLocal Folder\nGit Repository" | tfuzzel -d -p " Source | ")
    
    [ -z "$SOURCE_TYPE" ] || is_back "$SOURCE_TYPE" && return
    
    if [[ "$SOURCE_TYPE" =~ "Local" ]]; then
        FOLDERS=$(find ~/Projects ~/projects ~/code ~/src -maxdepth 1 -type d 2>/dev/null | head -15)
        if [ -z "$FOLDERS" ]; then
            notify-send "T-Link" "No project folders found: put your project in ~/Projects, ~/code or ~/src"
            return
        fi
        FOLDER=$(echo -e "󰌍 Back\n$FOLDERS" | tfuzzel -d -p " Folder | " --width 50)
        [ -z "$FOLDER" ] || is_back "$FOLDER" && return
    elif [[ "$SOURCE_TYPE" =~ "Git" ]]; then
        REPO=$(echo "" | tfuzzel -d -p " Git URL: " --width 50)
        [ -z "$REPO" ] && return
        FOLDER="/tmp/tlink-$APP"
        rm -rf "$FOLDER"
        git clone "$REPO" "$FOLDER" || { notify-send "T-Link" "Git clone failed"; return; }
    fi
    
    if [ ! -f "$FOLDER/Dockerfile" ]; then
        notify-send "T-Link" "No Dockerfile found"
        return
    fi
    
    $TERM_CMD bash -c "
        echo '════════════════════════════════════════'
        echo '  REDEPLOY (TESTED FIRST): $APP'
        echo '════════════════════════════════════════'
        echo ''
        
        # Get current host + container ports ('docker port' → '3000/tcp -> 0.0.0.0:3000')
        PORT_LINE=\$(ssh root@$IP \"docker port $APP 2>/dev/null\" | head -1)
        CURRENT_PORT=\$(echo \"\$PORT_LINE\" | sed 's/.*://')
        CONTAINER_PORT=\$(echo \"\$PORT_LINE\" | cut -d/ -f1)
        if [ -z \"\$CURRENT_PORT\" ]; then
            CURRENT_PORT=3000
        fi
        if [ -z \"\$CONTAINER_PORT\" ]; then
            CONTAINER_PORT=\$CURRENT_PORT
        fi
        NEW_PORT=\$((CURRENT_PORT == 3000 ? 3001 : 3000))
        
        echo \"Current port: \$CURRENT_PORT\"
        echo \"New port: \$NEW_PORT\"
        echo ''
        
        echo '[1/5] Building new image...'
        cd '$FOLDER'
        docker build -t $APP:latest . || { echo 'Build failed!'; read -p 'Press Enter...'; exit 1; }
        echo '✓ Built'
        echo ''
        
        echo '[2/5] Uploading...'
        docker save $APP:latest | gzip > /tmp/$APP.tar.gz
        scp /tmp/$APP.tar.gz root@$IP:/tmp/
        ssh root@$IP 'docker load < /tmp/$APP.tar.gz && rm /tmp/$APP.tar.gz'
        echo '✓ Uploaded'
        echo ''
        
        echo '[3/5] Starting new version...'
        ssh root@$IP \"docker run -d --name $APP-v2 --restart unless-stopped -p 127.0.0.1:\$NEW_PORT:\$CONTAINER_PORT $APP:latest\"
        echo '✓ New version running'
        echo ''
        
        echo '[4/5] Health check (3s)...'
        sleep 3
        if ssh root@$IP \"docker ps | grep -q $APP-v2\"; then
            echo '✓ New version healthy'
        else
            echo '✗ New version failed, keeping old'
            ssh root@$IP \"docker rm -f $APP-v2 2>/dev/null\"
            read -p 'Press Enter...'
            exit 1
        fi
        echo ''
        
        echo '[5/5] Cutting over to new version on port '\$CURRENT_PORT'...'
        # The v2 container validated the image on the staging port; the real
        # cutover re-runs it on the original port. Not zero-downtime: there
        # is a stop/start gap of a few seconds (a rename alone would leave
        # the app listening on the wrong port)
        ssh root@$IP \"docker rm -f $APP-v2 && docker stop $APP && docker rm $APP && docker run -d --name $APP --restart unless-stopped -p 127.0.0.1:\$CURRENT_PORT:\$CONTAINER_PORT $APP:latest\"
        echo '✓ Swapped'
        echo ''
        
        echo '════════════════════════════════════════'
        echo '  ✓ REDEPLOY COMPLETE'
        echo '════════════════════════════════════════'
        echo ''
        read -p 'Press Enter...'
    "
}

one_click_apps() {
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)
    
    if [ -z "$SERVERS" ]; then
        notify-send "T-Link" "No servers configured"
        return
    fi
    
    SERVER=$(echo -e "󰌍 Back\n$SERVERS" | tfuzzel -d -p " Install on | ")
    
    [ -z "$SERVER" ] || is_back "$SERVER" && return
    
    IP=$(grep "^$SERVER=" "$SERVERS_FILE" | cut -d= -f2)
    one_click_to_server "$IP" "$SERVER"
}

one_click_to_server() {
    IP="$1"
    SERVER="$2"
    
    # List available templates
    TEMPLATES=$(ls "$TEMPLATES_DIR"/*.json 2>/dev/null | xargs -I{} basename {} .json)
    
    if [ -z "$TEMPLATES" ]; then
        # None ship with Tebian: say how to add one rather than a dead end
        notify-send "T-Link" "No app templates yet. Add one JSON file per app to ~/.config/tebian/templates with \"image\", \"ports\", \"volumes\" and \"description\"."
        return
    fi
    
    MENU="󰌍 Back
─────────────────────────────────
Available Apps:"

    for t in $TEMPLATES; do
        DESC=$(cat "$TEMPLATES_DIR/$t.json" 2>/dev/null | grep -oP '"description":\s*"\K[^"]+' | head -1)
        MENU+="
  $t - $DESC"
    done
    
    CHOICE=$(echo -e "$MENU" | tfuzzel -d -p " Install | " --width 50 --lines 15)
    
    [ -z "$CHOICE" ] || is_back "$CHOICE" && return
    
    # Extract app name — split on the " - " separator, not bare '-',
    # so hyphenated templates like uptime-kuma survive
    APP=$(echo "$CHOICE" | sed 's/^[[:space:]]*//; s/ - .*$//; s/[[:space:]]*$//')
    TEMPLATE="$TEMPLATES_DIR/$APP.json"
    
    if [ ! -f "$TEMPLATE" ]; then
        notify-send "T-Link" "Template not found"
        return
    fi
    
    # Parse template
    IMAGE=$(cat "$TEMPLATE" | grep -oP '"image":\s*"\K[^"]+')
    PORTS=$(cat "$TEMPLATE" | grep -oP '"ports":\s*\[\K[^\]]+' | tr -d '"' | tr ',' ' ')
    VOLUMES=$(cat "$TEMPLATE" | grep -oP '"volumes":\s*\[\K[^\]]+' | tr -d '"' | tr ',' ' ')
    
    # Build docker run command
    PORT_ARGS=""
    # Loopback only, as for Deploy App (Docker bypasses the firewall)
    for p in $PORTS; do
        [[ "$p" == *:* ]] || p="$p:$p"
        PORT_ARGS="$PORT_ARGS -p 127.0.0.1:$p"
    done
    
    VOL_ARGS=""
    for v in $VOLUMES; do
        VOL_ARGS="$VOL_ARGS -v $v"
    done
    
    $TERM_CMD bash -c "
        echo '════════════════════════════════════════'
        echo '  INSTALLING $APP'
        echo '  Server: $SERVER ($IP)'
        echo '════════════════════════════════════════'
        echo ''
        
        echo 'Pulling image...'
        ssh root@$IP 'docker pull $IMAGE'
        echo ''
        
        echo 'Starting container...'
        ssh root@$IP 'docker stop $APP 2>/dev/null; docker rm $APP 2>/dev/null'
        ssh root@$IP 'docker run -d --name $APP --restart unless-stopped $PORT_ARGS $VOL_ARGS $IMAGE'
        echo ''
        
        if ssh root@$IP 'docker ps | grep -q $APP'; then
            echo '════════════════════════════════════════'
            echo '  ✓ INSTALLED'
            echo '════════════════════════════════════════'
            echo ''
            echo '$APP is running!'
            echo ''
            echo 'Running on the server at localhost:${PORTS%%:*} (not exposed).'
            echo 'Publish it with HTTPS: server > Setup SSL (Caddy).'
        else
            echo '✗ Failed to start'
            echo 'Check logs: ssh root@$IP docker logs $APP'
        fi
        echo ''
        read -p 'Press Enter...'
    "
}

setup_caddy() {
    IP="$1"
    SERVER="$2"
    
    DOMAIN=$(echo "" | tfuzzel -d -p " Domain (e.g., app.example.com): " --width 40)
    [ -z "$DOMAIN" ] && return
    # Goes into the Caddyfile and a remote command line as typed
    if [[ ! "$DOMAIN" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]; then
        notify-send "T-Link" "Not a domain name: $DOMAIN"
        return
    fi

    BACKEND_PORT=$(echo -e "3000\n8080\n8000" | tfuzzel -d -p " Backend Port (pick or type) | ")
    [ -z "$BACKEND_PORT" ] && return
    tlink_valid_port "$BACKEND_PORT" || return
    
    $TERM_CMD bash -c "
        echo '════════════════════════════════════════'
        echo '  SETTING UP CADDY (Auto SSL)'
        echo '════════════════════════════════════════'
        echo ''
        
        echo 'Installing Caddy...'
        ssh root@$IP 'docker pull caddy:2'
        echo ''
        
        echo 'Creating Caddyfile...'
        ssh root@$IP 'mkdir -p /opt/config/caddy'
        ssh root@$IP 'cat > /opt/config/caddy/Caddyfile << EOF
$DOMAIN {
    reverse_proxy localhost:$BACKEND_PORT
}
EOF'
        echo ''
        
        echo 'Starting Caddy...'
        ssh root@$IP 'docker stop caddy 2>/dev/null; docker rm caddy 2>/dev/null'
        # Host network: in its own network namespace, localhost inside Caddy is
        # Caddy itself and every request got a 502. It listens on 80/443
        # directly, which the firewall allows.
        ssh root@$IP 'docker run -d --name caddy --restart unless-stopped \
            --network host \
            -v /opt/config/caddy:/etc/caddy \
            -v /opt/data/caddy:/data \
            caddy:2'
        echo ''
        
        if ssh root@$IP 'docker ps | grep -q caddy'; then
            echo '════════════════════════════════════════'
            echo '  ✓ CADDY RUNNING'
            echo '════════════════════════════════════════'
            echo ''
            echo 'Your app is now accessible at:'
            echo '  https://$DOMAIN'
            echo ''
            echo 'SSL certificate will be auto-provisioned.'
            echo ''
            echo 'Make sure DNS points to $IP'
        else
            echo '✗ Failed to start Caddy'
        fi
        echo ''
        read -p 'Press Enter...'
    "
}

shell_server() {
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)
    
    if [ -z "$SERVERS" ]; then
        notify-send "T-Link" "No servers configured"
        return
    fi
    
    CHOICE=$(echo -e "󰌍 Back\n$SERVERS" | tfuzzel -d -p " Shell | ")
    
    [ -z "$CHOICE" ] || is_back "$CHOICE" && return
    
    IP=$(grep "^$CHOICE=" "$SERVERS_FILE" | cut -d= -f2)
    $TERM_CMD ssh root@$IP
}

view_all_containers() {
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)
    
    if [ -z "$SERVERS" ]; then
        notify-send "T-Link" "No servers configured"
        return
    fi
    
    $TERM_CMD bash -c "
        echo '════════════════════════════════════════'
        echo '  CONTAINER STATUS - ALL SERVERS'
        echo '════════════════════════════════════════'
        echo ''
        
        for server in $(tlink_server_words); do
            IP=\$(grep \"^\$server=\" '$SERVERS_FILE' | cut -d= -f2)
            echo \"── \$server (\$IP) ──\"
            ssh root@\$IP 'docker ps --format \"table {{.Names}}\t{{.Status}}\t{{.Ports}}\"' 2>/dev/null || echo '  (unreachable)'
            echo ''
        done
        
        read -p 'Press Enter...'
    "
}

resource_usage() {
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)
    
    if [ -z "$SERVERS" ]; then
        notify-send "T-Link" "No servers configured"
        return
    fi
    
    SERVER=$(echo -e "󰌍 Back\nAll Servers\n$SERVERS" | tfuzzel -d -p " Resources | ")
    
    [ -z "$SERVER" ] || is_back "$SERVER" && return
    
    if [[ "$SERVER" =~ "All" ]]; then
        $TERM_CMD bash -c "
            echo '════════════════════════════════════════'
            echo '  RESOURCE USAGE - ALL SERVERS'
            echo '════════════════════════════════════════'
            echo ''
            
            for server in $(tlink_server_words); do
                IP=\$(grep \"^\$server=\" '$SERVERS_FILE' | cut -d= -f2)
                echo \"── \$server (\$IP) ──\"
                ssh root@\$IP 'echo \"CPU: \$(top -bn1 | grep \"Cpu(s)\" | awk \"{print \\\$2}\")%\"
                               echo \"RAM: \$(free -m | awk \"/Mem:/ {printf \\\"%s/%s MB (%.1f%%)\\\", \\\$3, \\\$2, \\\$3*100/\\\$2}\")\"
                               echo \"Disk: \$(df -h / | awk \"NR==2 {printf \\\"%s/%s (%s)\\\", \\\$3, \\\$2, \\\$5}\")\"
                               docker ps -q | wc -l | xargs -I{} echo \"Containers: {}\"' 2>/dev/null || echo '  (unreachable)'
                echo ''
            done
            
            read -p 'Press Enter...'
        "
    else
        IP=$(grep "^$SERVER=" "$SERVERS_FILE" | cut -d= -f2)
        $TERM_CMD ssh root@$IP "htop"
    fi
}

update_all_servers() {
    SERVERS=$(grep -v "^#" "$SERVERS_FILE" | grep "=" | cut -d= -f1)
    
    if [ -z "$SERVERS" ]; then
        notify-send "T-Link" "No servers configured"
        return
    fi
    
    $TERM_CMD bash -c "
        echo '════════════════════════════════════════'
        echo '  UPDATING ALL SERVERS'
        echo '════════════════════════════════════════'
        echo ''
        
        failed=0
        for server in $(tlink_server_words); do
            IP=\$(grep \"^\$server=\" '$SERVERS_FILE' | cut -d= -f2)
            echo \"Updating \$server (\$IP)...\"
            ssh root@\$IP 'apt update && apt upgrade -y' 2>/dev/null && echo \"✓ \$server updated\" || { echo \"✗ \$server failed\"; failed=1; }
            echo ''
        done
        
        echo '════════════════════════════════════════'
        if [ \$failed = 0 ]; then
            echo '  ✓ ALL SERVERS UPDATED'
        else
            echo '  ✗ SOME SERVERS FAILED (see above)'
        fi
        echo '════════════════════════════════════════'
        read -p 'Press Enter...'
    "
}

