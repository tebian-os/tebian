#!/bin/sh
# Tebian session wrapper for greetd
# Sets up proper environment before launching sway

# Clear the VT to prevent text flash between greeter and sway
printf '\033[2J\033[H\033[?25l' 2>/dev/null

# Set PATH directly (avoid sourcing .bashrc which flashes colored text)
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Wayland session environment
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=sway
export XDG_CURRENT_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# User environment from ~/.config/environment.d (the systemd location, where
# Settings writes e.g. the NVIDIA variables). systemd only hands these to
# user services, not to sway, so export them here. Plain KEY=VALUE lines
# only; values are taken literally, no expansion.
#
# The NVIDIA file (Settings > Performance) points GBM, GLX and VA-API at the
# nvidia driver. Taken only when that driver actually loaded and drives the
# display: if Secure Boot refused the module, or on a hybrid laptop whose
# screen hangs off the integrated GPU, those variables break the GPU in use.
nvidia_env=no
if [ -d /sys/module/nvidia_drm ]; then
    nvidia_env=yes
    for drv in /sys/class/drm/card[0-9]*/device/driver; do
        case "$(basename "$(readlink "$drv" 2>/dev/null)")" in
            i915|xe|amdgpu|radeon|nouveau) nvidia_env=no ;;
        esac
    done
fi
for envfile in "$HOME"/.config/environment.d/*.conf; do
    [ -f "$envfile" ] || continue
    [ "${envfile##*/}" = tebian-nvidia.conf ] && [ "$nvidia_env" = no ] && continue
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        key=${line%%=*}
        value=${line#*=}
        case "$key" in
            ''|[0-9]*|*[!A-Za-z0-9_]*) continue ;;
        esac
        [ "$key" = "$line" ] && continue
        # Strip one pair of surrounding quotes
        case "$value" in
            \"*\") value=${value#\"}; value=${value%\"} ;;
            \'*\') value=${value#\'}; value=${value%\'} ;;
        esac
        export "$key=$value"
    done < "$envfile"
done
unset envfile line key value nvidia_env drv

# Displays switched off in Settings used to be saved as "output X disable",
# which brought the black screen back at every login once that was the
# only screen left (a laptop panel turned off while docked, then undocked).
# Settings no longer saves them; clear the ones older versions wrote.
if [ -f "$HOME/.config/sway/outputs" ] && grep -q ' disable$' "$HOME/.config/sway/outputs"; then
    sed -i '/ disable$/d' "$HOME/.config/sway/outputs"
fi

# Fix up Settings-managed lines in config.user written by older versions
# before sway parses it (see tebian_user_migrate in tebian-common)
if [ -f "$HOME/.local/bin/tebian-common" ] && command -v bash >/dev/null; then
    bash -c '. "$HOME/.local/bin/tebian-common" && tebian_user_migrate' >/dev/null 2>&1
fi

# Sway refuses to start on the proprietary NVIDIA driver unless told it's
# unsupported — without this, installing the driver leaves a black screen
[ -d /sys/module/nvidia ] && set -- --unsupported-gpu "$@"

# Ensure D-Bus session bus
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null; then
    exec dbus-run-session sway "$@"
else
    exec sway "$@"
fi
