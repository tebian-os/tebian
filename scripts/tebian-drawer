#!/bin/bash
# ==============================================================================
# TEBIAN APP DRAWER (Mod+A)
# Browse all installed apps. Pin/unpin apps to the main menu.
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
elif [ -f "$HOME/.local/bin/tebian-common" ]; then
    source "$HOME/.local/bin/tebian-common"
fi

PIN_FILE="$HOME/.config/tebian/pinned-apps.conf"

mkdir -p "$HOME/.config/tebian"
[ -f "$PIN_FILE" ] || touch "$PIN_FILE"

# Every launchable app, sorted by name; labels carry the ID where two apps
# share a name. Split by hand, not with `IFS=$'\t' read`: that merges the
# tabs around an empty icon.
declare -A LABEL ICON
APP_IDS=()
while IFS= read -r line; do
    id="${line%%$'\t'*}"; rest="${line#*$'\t'}"
    LABEL[$id]="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    ICON[$id]="${rest%%$'\t'*}"
    APP_IDS+=("$id")
done < <(tebian_apps_labeled)

# Pins are keyed by ID, so two apps with the same name are pinned apart
is_pinned() {
    grep -qxF "$1" "$PIN_FILE" 2>/dev/null
}

# A fuzzel pick by position (--index), so the action never depends on the
# label: an app named "Back" or "Edit Menu" is still just that app. Prints
# the index, or nothing for Escape and for typed text that matched nothing.
pick_index() {
    local n="$1" pick; shift
    pick=$(tfuzzel -d --index "$@")
    [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -lt "$n" ] && echo "$pick"
}

# Edit Pins mode — every app with its pin state; picking one toggles it
edit_pins() {
    local pick id line
    local -A pinned
    while true; do
        # Read once per round, not a grep per app
        pinned=()
        while IFS= read -r line || [ -n "$line" ]; do
            [ -n "$line" ] && pinned["$line"]=1
        done < "$PIN_FILE"
        pick=$(
            {
                echo "󰌍 Back"
                for id in "${APP_IDS[@]}"; do
                    if [ -n "${pinned[$id]+x}" ]; then
                        printf '[pinned] %s\n' "${LABEL[$id]}"
                    else
                        printf '[     ] %s\n' "${LABEL[$id]}"
                    fi
                done
            } | pick_index $(( ${#APP_IDS[@]} + 1 )) -p " 📌 Edit Menu | " --width 40
        )

        # Escape closes; only Back returns to the drawer
        [ -n "$pick" ] || exit 0
        [ "$pick" -eq 0 ] && exec tebian-drawer

        id="${APP_IDS[pick - 1]}"
        if is_pinned "$id"; then
            grep -vxF "$id" "$PIN_FILE" > "$PIN_FILE.tmp"
            mv "$PIN_FILE.tmp" "$PIN_FILE"
            notify-send "Menu" "Unpinned: ${LABEL[$id]}" 2>/dev/null
        else
            # An unterminated last line would otherwise merge with ours
            [ -z "$(tail -c1 "$PIN_FILE")" ] || echo >> "$PIN_FILE"
            echo "$id" >> "$PIN_FILE"
            notify-send "Menu" "Pinned: ${LABEL[$id]}" 2>/dev/null
        fi
        # Loop continues — re-shows edit menu with updated pin status
    done
}

# Main drawer: Edit Menu, the apps, Back. Printed straight into the pipe:
# the icon separator is a NUL, which bash variables drop (see tfuzzel).
PICK=$(
    {
        echo "󰏫 Edit Menu"
        for id in "${APP_IDS[@]}"; do
            if [ -n "${ICON[$id]}" ]; then
                printf '%s\0icon\x1f%s\n' "${LABEL[$id]}" "${ICON[$id]}"
            else
                printf '%s\n' "${LABEL[$id]}"
            fi
        done
        echo "󰌍 Back"
    } | pick_index $(( ${#APP_IDS[@]} + 2 )) -p " 📂 Apps | " --width 40
)

# Escape closes the drawer; only the Back entry returns to Mod+D
[ -n "$PICK" ] || exit 0

if [ "$PICK" -eq 0 ]; then
    edit_pins
elif [ "$PICK" -gt "${#APP_IDS[@]}" ]; then
    tebian-menu &
else
    id="${APP_IDS[PICK - 1]}"
    tebian_app_launch "$id" ||
        notify-send "Apps" "Could not start ${LABEL[$id]}" 2>/dev/null
fi
exit 0
