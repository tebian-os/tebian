#!/bin/bash

echo "🚀 Starting Full System Update..."

# Track which update lanes failed so the final summary tells the truth
# instead of always printing "✅ All complete!" even on partial failure.
FAILED=()

# 1. Debian System Packages
echo -e "\n📦 Updating Debian packages..."
sudo apt update && sudo apt upgrade -y || FAILED+=("apt")

# 2. Rust / Cargo
if command -v rustup &> /dev/null; then
    echo -e "\n🦀 Updating Rust and Cargo..."
    rustup update || FAILED+=("rustup")
fi

# 3. Bun
if command -v bun &> /dev/null; then
    echo -e "\n⚡ Updating Bun..."
    bun upgrade || FAILED+=("bun")
fi

# 4. Flatpak (if installed)
if command -v flatpak &> /dev/null; then
    echo -e "\n🍱 Updating Flatpaks..."
    flatpak update -y || FAILED+=("flatpak")
fi

echo ""
if [ ${#FAILED[@]} -eq 0 ]; then
    echo "✅ All updates complete!"
else
    echo "⚠️  Updates complete with errors in: ${FAILED[*]}"
    echo "    Scroll up for details."
fi

read -p "📦 Press Enter to close..."
