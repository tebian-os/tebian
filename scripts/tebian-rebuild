#!/bin/bash
# ==============================================================================
# TEBIAN REBUILD
# Applies the declared state. Idempotent.
#   ~/Tebian/tebian.conf            defaults (or a fleet's manifest, in git)
#   ~/.config/tebian/machine.conf   this machine's choices, recorded by
#                                   Settings (theme, security profile, Tor,
#                                   DNS privacy) — wins over tebian.conf
# Re-applying them restores what the user chose, never Tebian's defaults.
# Usage: tebian-rebuild
# ==============================================================================

set -euo pipefail

TEBIAN_DIR="${TEBIAN_DIR:-$HOME/Tebian}"
CONF="$TEBIAN_DIR/tebian.conf"
MACHINE_CONF="$HOME/.config/tebian/machine.conf"
STATE_DIR="$HOME/.local/share/tebian"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[rebuild]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[rebuild]${NC} $1"; }
log_error() { echo -e "${RED}[rebuild]${NC} $1" >&2; }

if [ ! -f "$CONF" ] && [ ! -f "$MACHINE_CONF" ]; then
    log_error "Manifest not found: $CONF"
    echo "Restore the default with: tebian-update (or copy tebian.conf from the Tebian source)"
    exit 1
fi

# Defaults for the lists, so a manifest that leaves one out still works
EXTRA_PACKAGES=() ENABLE_SERVICES=() DISABLE_SERVICES=()
# shellcheck disable=SC1090
[ -f "$CONF" ] && source "$CONF"
# shellcheck disable=SC1090
[ -f "$MACHINE_CONF" ] && source "$MACHINE_CONF"

# Files about to be replaced that differ from what replaces them are kept
# here first — a rebuild is one click away in Settings
BACKUP_DIR="$STATE_DIR/backups/rebuild-$(date +%Y%m%d-%H%M%S)"
keep_copy() {  # <file about to be replaced> <its replacement>
    [ -f "$1" ] && ! cmp -s "$1" "$2" || return 0
    mkdir -p "$BACKUP_DIR"
    cp -p "$1" "$BACKUP_DIR/$(basename "$(dirname "$1")")-$(basename "$1")"
}

echo ""
echo "  ┌─────────────────────┐"
echo "  │  TEBIAN  REBUILD    │"
echo "  └─────────────────────┘"
echo ""

# --- 1. Extra packages ---
if [ ${#EXTRA_PACKAGES[@]} -gt 0 ]; then
    log_info "Installing extra packages: ${EXTRA_PACKAGES[*]}"
    sudo apt update -qq
    sudo apt install -y "${EXTRA_PACKAGES[@]}"
fi

# --- 2. Sync configs from ~/Tebian/configs/ ---
CONFIG_DIR="$HOME/.config"
LOCAL_BIN="$HOME/.local/bin"

if [ -d "$TEBIAN_DIR/configs/sway" ]; then
    mkdir -p "$CONFIG_DIR/sway" "$STATE_DIR"
    # Same rule as tebian-update: Tebian's file is replaced only while it is
    # what Tebian last installed (recorded checksum); an edited one is kept
    # and the default saved next to it
    SWAY_NEW="$TEBIAN_DIR/configs/sway/config"
    SWAY_CUR="$CONFIG_DIR/sway/config"
    SWAY_REC="$STATE_DIR/sway-config.sha256"
    if [ ! -f "$SWAY_CUR" ] || cmp -s "$SWAY_NEW" "$SWAY_CUR" ||
       [ "$(cat "$SWAY_REC" 2>/dev/null)" = "$(sha256sum "$SWAY_CUR" | awk '{ print $1 }')" ]; then
        cp "$SWAY_NEW" "$SWAY_CUR"
        sha256sum "$SWAY_CUR" | awk '{ print $1 }' > "$SWAY_REC"
        rm -f "$SWAY_CUR.tebian-new"
    else
        cp "$SWAY_NEW" "$SWAY_CUR.tebian-new"
        log_warn "Your ~/.config/sway/config has local changes, so it was kept."
        log_warn "The default is in ~/.config/sway/config.tebian-new (personal settings belong in config.user)."
    fi
    # Preserve config.user (never overwrite user customizations)
    if [ ! -f "$CONFIG_DIR/sway/config.user" ]; then
        if [ -f "$TEBIAN_DIR/configs/sway/config.user" ]; then
            cp "$TEBIAN_DIR/configs/sway/config.user" "$CONFIG_DIR/sway/config.user"
        else
            touch "$CONFIG_DIR/sway/config.user"
        fi
    fi
    # Remove stale hardcoded laptop outputs from both default and user overrides.
    sed -i '/^[[:space:]]*output[[:space:]]\+eDP[[:alnum:]_.:-]*\([[:space:]].*\)\?$/d' "$CONFIG_DIR/sway/config" 2>/dev/null || true
    sed -i '/^[[:space:]]*output[[:space:]]\+eDP[[:alnum:]_.:-]*\([[:space:]].*\)\?$/d' "$CONFIG_DIR/sway/config.user" 2>/dev/null || true
    log_info "Sway config synced"
fi

# --- 3. Apply theme ---
THEME="${TEBIAN_THEME:-glass}"
THEME_DIR="$TEBIAN_DIR/configs/themes/$THEME"
if [ -d "$THEME_DIR" ]; then
    if [ -f "$THEME_DIR/sway-theme" ]; then
        cp "$THEME_DIR/sway-theme" "$CONFIG_DIR/sway/theme"
    fi
    # Theme files carry colors and a default font. The font may have been
    # changed in Settings since, so carry those lines over instead of
    # resetting them with the theme.
    if [ -f "$THEME_DIR/kitty.conf" ]; then
        mkdir -p "$CONFIG_DIR/kitty"
        kitty_font=$(grep -E '^(font_family|font_size)[[:space:]]' "$CONFIG_DIR/kitty/kitty.conf" 2>/dev/null || true)
        keep_copy "$CONFIG_DIR/kitty/kitty.conf" "$THEME_DIR/kitty.conf"
        cp "$THEME_DIR/kitty.conf" "$CONFIG_DIR/kitty/kitty.conf"
        if [ -n "$kitty_font" ]; then
            sed -i -E '/^(font_family|font_size)[[:space:]]/d' "$CONFIG_DIR/kitty/kitty.conf"
            printf '%s\n' "$kitty_font" >> "$CONFIG_DIR/kitty/kitty.conf"
        fi
    fi
    if [ -f "$THEME_DIR/fuzzel.ini" ]; then
        mkdir -p "$CONFIG_DIR/fuzzel"
        fuzzel_font=$(grep -E '^font=' "$CONFIG_DIR/fuzzel/fuzzel.ini" 2>/dev/null | head -1 || true)
        keep_copy "$CONFIG_DIR/fuzzel/fuzzel.ini" "$THEME_DIR/fuzzel.ini"
        cp "$THEME_DIR/fuzzel.ini" "$CONFIG_DIR/fuzzel/fuzzel.ini"
        if [ -n "$fuzzel_font" ]; then
            # font= belongs to [main]; replace in place when the theme has one
            if grep -q '^font=' "$CONFIG_DIR/fuzzel/fuzzel.ini"; then
                sed -i "s|^font=.*|${fuzzel_font//|/\\|}|" "$CONFIG_DIR/fuzzel/fuzzel.ini"
            else
                sed -i "0,/^\[main\]/s||[main]\n${fuzzel_font//|/\\|}|" "$CONFIG_DIR/fuzzel/fuzzel.ini"
            fi
        fi
    fi
    if [ -f "$THEME_DIR/mako" ]; then
        mkdir -p "$CONFIG_DIR/mako"
        keep_copy "$CONFIG_DIR/mako/config" "$THEME_DIR/mako"
        cp "$THEME_DIR/mako" "$CONFIG_DIR/mako/config"
    fi
    log_info "Theme applied: $THEME"
else
    log_warn "Theme directory not found: $THEME_DIR"
fi

# --- 4. Sync scripts ---
# Temp file + rename, never cp over the target: this runs inside
# `tebian-update --rebuild`, and rewriting a running script in place makes
# bash execute garbage when it reads the next line.
replace_file() {
    local tmp
    tmp=$(mktemp "$2.XXXXXX")
    cp -p "$1" "$tmp"
    mv -f "$tmp" "$2"
}
if [ -d "$TEBIAN_DIR/scripts" ]; then
    mkdir -p "$LOCAL_BIN"
    for script in "$TEBIAN_DIR/scripts/"*; do
        [ -d "$script" ] && continue
        name=$(basename "$script")
        case "$name" in
            desktop.sh|build-iso.sh|uninstall.sh|tebian-installer|test-vm.sh) continue ;;
            *) replace_file "$script" "$LOCAL_BIN/$name"; chmod +x "$LOCAL_BIN/$name" ;;
        esac
    done

    # Copy modular settings directory
    if [ -d "$TEBIAN_DIR/scripts/tebian-settings.d" ]; then
        mkdir -p "$LOCAL_BIN/tebian-settings.d"
        for module in "$TEBIAN_DIR/scripts/tebian-settings.d/"*.sh; do
            replace_file "$module" "$LOCAL_BIN/tebian-settings.d/${module##*/}"
        done
    fi
    log_info "Scripts synced to $LOCAL_BIN"
fi

# --- 5. Security profile ---
SECURITY="${SECURITY_PROFILE:-standard}"
SECURITY_SCRIPT="$TEBIAN_DIR/modules/core/security.sh"
# Re-applied only when it changed. Settings records the profile it deduces
# from individual toggles (e.g. "hardened" once kernel hardening is on), and
# blindly re-running the full profile would add parts the user never chose,
# such as key-only SSH.
SECURITY_APPLIED="$STATE_DIR/security-applied"
if [ -f "$SECURITY_SCRIPT" ] && [ "$(cat "$SECURITY_APPLIED" 2>/dev/null)" = "$SECURITY" ]; then
    log_info "Security profile unchanged ($SECURITY) — not re-applied"
elif [ -f "$SECURITY_SCRIPT" ]; then
    log_info "Applying security profile: $SECURITY"
    bash "$SECURITY_SCRIPT" "$SECURITY" &&
        { mkdir -p "${SECURITY_APPLIED%/*}"; echo "$SECURITY" > "$SECURITY_APPLIED"; }
else
    log_warn "Security module not found: $SECURITY_SCRIPT"
fi

# --- 6. Tor toggle ---
if [ -f "$SECURITY_SCRIPT" ]; then
    if [[ "${ENABLE_TOR:-no}" == "yes" ]]; then
        systemctl is-active --quiet tor 2>/dev/null || bash "$SECURITY_SCRIPT" tor-on
    elif [[ "$SECURITY" == "paranoid" ]]; then
        # Paranoid routes all traffic through Tor whatever ENABLE_TOR says;
        # stopping it here would cut the machine off the network
        :
    else
        # Only disable if tor is currently active
        if systemctl is-active --quiet tor 2>/dev/null; then
            bash "$SECURITY_SCRIPT" tor-off
        fi
    fi
fi

# --- 7. DNS Privacy toggle ---
if [ -f "$SECURITY_SCRIPT" ]; then
    if [[ "${ENABLE_DNS_PRIVACY:-no}" == "yes" ]]; then
        # Already on with this provider: leave it (dns-on restarts the
        # resolver and NetworkManager)
        dns_now=$(grep -o 'cloudflare\|quad9' /etc/systemd/resolved.conf.d/99-tebian-dns.conf 2>/dev/null | head -1 || true)
        if [ "$dns_now" != "${DNS_PROVIDER:-quad9}" ]; then
            bash "$SECURITY_SCRIPT" dns-on "${DNS_PROVIDER:-quad9}" ||
                log_warn "DNS privacy could not be turned on (see above)"
        fi
    else
        # Only disable if config exists
        if [ -f /etc/systemd/resolved.conf.d/99-tebian-dns.conf ]; then
            bash "$SECURITY_SCRIPT" dns-off
        fi
    fi
fi

# --- 8. Manage services ---
for svc in "${ENABLE_SERVICES[@]:-}"; do
    [ -z "$svc" ] && continue
    sudo systemctl enable --now "$svc" 2>/dev/null && log_info "Enabled service: $svc" || log_warn "Could not enable: $svc"
done

for svc in "${DISABLE_SERVICES[@]:-}"; do
    [ -z "$svc" ] && continue
    sudo systemctl disable --now "$svc" 2>/dev/null && log_info "Disabled service: $svc" || log_warn "Could not disable: $svc"
done

# --- 9. Reload sway if running ---
if pgrep -x sway &>/dev/null; then
    swaymsg reload 2>/dev/null && log_info "Sway reloaded" || true
fi

echo ""
[ -d "$BACKUP_DIR" ] && log_info "Replaced theme files saved in $BACKUP_DIR"
log_info "Rebuild complete!"
