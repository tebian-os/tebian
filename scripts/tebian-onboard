#!/bin/bash
# Tebian First Boot Onboarding
# Runs once on first login, asks user their preferred experience

# Security: restrictive umask for created files
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
elif [ -f "$HOME/.local/bin/tebian-common" ]; then
    source "$HOME/.local/bin/tebian-common"
fi

get_term() {
    if command -v kitty &>/dev/null; then echo "kitty -e"
    elif command -v foot &>/dev/null; then echo "foot -e"
    elif command -v alacritty &>/dev/null; then echo "alacritty -e"
    elif command -v xterm &>/dev/null; then echo "xterm -e"
    else echo "kitty -e"
    fi
}
TERM_CMD=$(get_term)

# Add contrib/non-free/non-free-firmware to Debian's own apt sources, in
# both formats: one-line .list files and the deb822 .sources files that
# fresh trixie installs use (debian.sources). Components are compared as
# whole words — "non-free-firmware" must not count as "non-free" — and
# third-party repositories are left alone. Returns 0 if anything changed.
# Exported so the setup terminal (a separate bash -c) can call it.
enable_debian_components() {
    local want="contrib non-free non-free-firmware" f tmp changed=1
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do
        [ -f "$f" ] || continue
        tmp=$(mktemp)
        awk -v want="$want" '
            /^deb(-src)?[ \t]/ && /debian\.org/ {
                delete have
                for (i = 1; i <= NF; i++) have[$i] = 1
                n = split(want, w, " ")
                for (j = 1; j <= n; j++) if (!(w[j] in have)) $0 = $0 " " w[j]
            }
            { print }' "$f" > "$tmp"
        if ! cmp -s "$f" "$tmp"; then sudo cp "$tmp" "$f"; changed=0; fi
        rm -f "$tmp"
    done
    for f in /etc/apt/sources.list.d/*.sources; do
        [ -f "$f" ] || continue
        tmp=$(mktemp)
        # Stanzas are blank-line separated; only those whose URIs are
        # Debian mirrors get their Components line extended
        awk -v want="$want" '
            function flush(   i, k, m, j, c, deb, l, parts, w, have) {
                deb = 0
                for (i = 1; i <= n; i++) if (buf[i] ~ /^URIs:/ && buf[i] ~ /debian\.org/) deb = 1
                for (i = 1; i <= n; i++) {
                    l = buf[i]
                    if (deb && l ~ /^Components:/) {
                        m = split(l, parts, /[ \t]+/)
                        for (k = 2; k <= m; k++) have[parts[k]] = 1
                        c = split(want, w, " ")
                        for (j = 1; j <= c; j++) if (!(w[j] in have)) l = l " " w[j]
                    }
                    print l
                }
                n = 0
            }
            /^[ \t]*$/ { flush(); print; next }
            { buf[++n] = $0 }
            END { flush() }' "$f" > "$tmp"
        if ! cmp -s "$f" "$tmp"; then sudo cp "$tmp" "$f"; changed=0; fi
        rm -f "$tmp"
    done
    return $changed
}
export -f enable_debian_components

ONBOARD_FILE="$HOME/.config/tebian-onboarded"
LOG_FILE="$HOME/.local/share/tebian-onboard.log"

log() {
    echo "[$(date)] $1" >> "$LOG_FILE"
}

if [ -f "$ONBOARD_FILE" ]; then
    log "Already onboarded, exiting"
    exit 0
fi

PROGRESS_FILE="$HOME/.config/tebian/.onboard_in_progress"

mkdir -p "$HOME/.local/share"
mkdir -p "$HOME/.config/environment.d"
mkdir -p "$HOME/.config/tebian"
chmod 700 "$HOME/.config/tebian"

# Resume detection: if previous run crashed mid-install
if [ -f "$PROGRESS_FILE" ]; then
    PREV_CHOICE=$(cat "$PROGRESS_FILE" 2>/dev/null)
    log "Resuming interrupted onboarding (was: $PREV_CHOICE)"
    CHOICE="$PREV_CHOICE"
else
    log "Starting onboarding"
    CHOICE=$(echo -e "Base (Minimal)\nDesktop (Familiar)" | tfuzzel -d -p "  Welcome to Tebian | " --lines=2)
fi

if [[ "$CHOICE" =~ "Desktop" ]]; then
    log "User chose Desktop mode"
    echo "Desktop" > "$PROGRESS_FILE"

    notify-send "Tebian" "Setting up Desktop mode..." 2>/dev/null || true

    # Clear any stale success sentinel from a previous aborted attempt
    mkdir -p "$HOME/.config/tebian"
    rm -f "$HOME/.config/tebian/.desktop_setup_ok"

    $TERM_CMD bash -c '
        # Source shared functions
        source "$HOME/.local/bin/tebian-common" 2>/dev/null

        echo "========================================="
        echo "  Tebian Desktop Setup"
        echo "========================================="
        echo ""
        echo "Your password is needed to install packages."
        echo ""

        # Prompt for password up front and cache it
        sudo -v || { echo "Authentication failed. Exiting."; read -p "Press Enter..."; exit 1; }
        echo ""

        # Check network connectivity
        if ! ping -c1 -W3 1.1.1.1 &>/dev/null; then
            echo "⚠️  No network connection detected."
            echo "   Connect to WiFi first (Super+D > WiFi)."
            read -p "Press Enter to exit..."
            exit 1
        fi

        # Show current system config (already set by installer)
        CURRENT_TZ=$(timedatectl show --property=Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null || echo "UTC")
        CURRENT_HOST=$(hostname)
        CURRENT_LAYOUT=$(localectl status 2>/dev/null | grep "X11 Layout" | awk "{print \$3}")
        [ -z "$CURRENT_LAYOUT" ] && CURRENT_LAYOUT="us"
        echo "  Timezone: $CURRENT_TZ"
        echo "  Hostname: $CURRENT_HOST"
        echo "  Keyboard: $CURRENT_LAYOUT"
        echo "  (Change these anytime in Settings > More > System Info)"
        echo ""

        # === DETECT HARDWARE ===
        echo "Detecting hardware..."
        echo ""
        detect_hardware
        
        echo ""
        echo "========================================="
        echo "  Installing Packages"
        echo "========================================="
        echo ""

        # === DESKTOP EXTRAS ===
        # Base already includes: sway, swaybg, swayidle, gtklock, fuzzel,
        # kitty, pipewire, NM, greetd, mako, grim, slurp, wl-clipboard,
        # brightnessctl, wob, xdg-desktop-portal-wlr, lxpolkit, curl
        echo "Installing desktop extras..."
        echo ""

        DESKTOP_PKGS=(
            cliphist
            xwayland wget
            libspa-0.2-bluetooth rfkill
            pavucontrol
            bluez blueman python3-dbus python3-gi
            gvfs gvfs-backends
            adwaita-qt
            thunar thunar-archive-plugin file-roller
            papirus-icon-theme
            btop
            zram-tools
            waybar upower
            qt5-gtk-platformtheme qt6-gtk-platformtheme
        )

        # x86-only extras
        ARCH=$(uname -m)
        if [[ "$ARCH" == "x86_64" ]]; then
            DESKTOP_PKGS+=(bluez-firmware)
        fi

        sudo apt update
        # apt refuses the whole list if any one name is unknown — which is
        # how a single package missing from trixie (qt5-style-plugins)
        # silently skipped every desktop extra. Install what exists and
        # say which ones do not.
        AVAILABLE=() MISSING=()
        for pkg in "${DESKTOP_PKGS[@]}"; do
            if apt-cache policy "$pkg" 2>/dev/null | grep -q "Candidate: [^(]"; then
                AVAILABLE+=("$pkg")
            else
                MISSING+=("$pkg")
            fi
        done
        [ ${#MISSING[@]} -gt 0 ] && echo "  ⚠ Not available on this system, skipped: ${MISSING[*]}"
        sudo apt install -y "${AVAILABLE[@]}" || {
            echo "  ⚠ Some packages failed to install. Continuing..."
        }
        echo "  ✓ Desktop extras installed"
        # Login started no pairing agent: BlueZ was not installed yet
        tebian_bt_agent_start 2>/dev/null || true

        # Window snapping lives in the compositor: Debian sway, rebuilt with
        # the Tebian patch (about a minute; the build tools go again after)
        if ! tebian-build-sway --check 2>/dev/null; then
            echo "Adding window snapping to Sway..."
            tebian-build-sway --install --clean --output "$HOME/.cache/tebian" ||
                echo "  ⚠ Window snapping was not built. Settings > UI > Window Snapping tries again."
        fi

        # === HARDWARE-SPECIFIC PACKAGES ===
        echo ""
        echo "Installing hardware-specific packages..."
        echo ""

        # Nvidia drivers
        if [ "$GPU_TYPE" = "NVIDIA" ]; then
            # nvidia-driver lives in non-free (not non-free-firmware, which a
            # stock trixie install already has)
            echo "  Checking repositories for contrib/non-free..."
            if enable_debian_components; then
                echo "  Enabled contrib and non-free"
                sudo apt update
            fi
            
            echo "  Installing NVIDIA drivers..."
            sudo apt install -y nvidia-driver firmware-misc-nonfree 2>/dev/null || {
                echo "  Note: Driver install failed. Check logs."
            }
            
            # Set Nvidia Wayland environment
            mkdir -p "$HOME/.config/environment.d"
            echo "WLR_NO_HARDWARE_CURSORS=1" > "$HOME/.config/environment.d/tebian-nvidia.conf"
            echo "LIBVA_DRIVER_NAME=nvidia" >> "$HOME/.config/environment.d/tebian-nvidia.conf"
            echo "  NVIDIA environment configured"
        fi
        
        # AMD GPU firmware
        if [ "$GPU_TYPE" = "AMD" ]; then
            echo "  Installing AMD firmware..."
            sudo apt install -y firmware-amd-graphics firmware-linux-nonfree 2>&1 || echo "  ⚠ Optional package failed: $?"
        fi
        
        # Intel GPU firmware
        if [ "$GPU_TYPE" = "Intel" ]; then
            echo "  Installing Intel firmware..."
            sudo apt install -y firmware-misc-nonfree 2>&1 || echo "  ⚠ Optional package failed: $?"
        fi
        
        # CPU microcode
        if [ "$CPU_TYPE" = "Intel" ]; then
            echo "  Installing Intel microcode..."
            sudo apt install -y intel-microcode 2>&1 || echo "  ⚠ Optional package failed: $?"
        elif [ "$CPU_TYPE" = "AMD" ]; then
            echo "  Installing AMD microcode..."
            sudo apt install -y amd64-microcode 2>&1 || echo "  ⚠ Optional package failed: $?"
        fi
        
        # Laptop power management
        if [ "$IS_LAPTOP" = true ]; then
            echo "  Installing laptop power management (TLP)..."
            sudo apt install -y tlp powertop 2>&1 || echo "  ⚠ Optional package failed: $?"
            sudo systemctl enable tlp 2>/dev/null || true
            echo "  TLP enabled for battery optimization"
        fi
        
        # === CONFIGURE DESKTOP EXPERIENCE ===
        echo ""
        echo "========================================="
        echo "  Configuring Desktop"
        echo "========================================="
        echo ""
        
        # Create mako config (only if none exists — tebian-theme will overwrite with themed version)
        mkdir -p "$HOME/.config/mako"
        [ -f "$HOME/.config/mako/config" ] || echo "default-timeout=5000" > "$HOME/.config/mako/config"
        echo "  Notifications configured"

        # WOB (volume/brightness overlay)
        TEBIAN_DIR="${TEBIAN_DIR:-$HOME/Tebian}"
        mkdir -p "$HOME/.config/wob"
        if [ -f "$TEBIAN_DIR/configs/wob/wob.ini" ]; then
            cp "$TEBIAN_DIR/configs/wob/wob.ini" "$HOME/.config/wob/wob.ini"
            echo "  WOB overlay configured"
        fi

        # XDG Desktop Portal
        mkdir -p "$HOME/.config/xdg-desktop-portal"
        if [ -f "$TEBIAN_DIR/configs/xdg-desktop-portal/sway-portals.conf" ]; then
            cp "$TEBIAN_DIR/configs/xdg-desktop-portal/sway-portals.conf" "$HOME/.config/xdg-desktop-portal/"
            echo "  XDG portal configured"
        fi

        # ZRAM swap
        if command -v zramctl &>/dev/null; then
            echo -e "ALGO=zstd\nPERCENT=60" | sudo tee /etc/default/zramswap > /dev/null 2>&1 || true
            sudo systemctl restart zramswap 2>/dev/null || true
            echo "  ZRAM swap configured"
        fi

        # Setup gtklock styling
        tebian-lockscreen-setup
        echo "  Screen lock configured"

        # Configure greetd to use nwg-hello
        if [ -f /etc/greetd/config.toml ] && ! grep -q "nwg-hello" /etc/greetd/config.toml; then
            # The shipped config, not an inline copy: it carries the NVIDIA
            # --unsupported-gpu handling, and a single source cannot drift
            sudo install -m 644 "${TEBIAN_DIR:-$HOME/Tebian}/configs/greetd/config.toml" /etc/greetd/config.toml
            echo "  Login greeter configured"
        fi

        # Enable floating mode by default (familiar experience)
        setup_floating_mode
        idempotent_append "default_border normal 2 # tebian-titlebars-on" "$HOME/.config/sway/config.user"
        idempotent_append "default_floating_border normal 2 # tebian-titlebars-on" "$HOME/.config/sway/config.user"
        idempotent_append "# tebian-floating-mode" "$HOME/.config/sway/config.user"
        idempotent_append "focus_follows_mouse yes" "$HOME/.config/sway/config.user"
        echo "  Floating mode with title bars enabled"

        # Modern bar (Waybar: hover buttons, drop-down menus). Base mode
        # keeps the lean Classic bar; either can be switched in Settings >
        # Desktop & UI > Bar Style.
        if command -v waybar >/dev/null && [ -x "$HOME/.local/bin/tebian-bar" ]; then
            tebian_block_set bar-style "bar bar-0 swaybar_command $HOME/.local/bin/tebian-bar"
            echo "  Modern bar enabled"
            # Rich panels for the bar (trixie-backports only; optional —
            # the bar falls back to simple menus without it)
            if ! command -v quickshell >/dev/null; then
                grep -rqs "trixie-backports" /etc/apt/sources.list /etc/apt/sources.list.d/ ||
                    echo "deb http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware" |
                    sudo tee /etc/apt/sources.list.d/tebian-backports.list >/dev/null
                sudo apt update -qq && sudo apt install -y -t trixie-backports quickshell ||
                    echo "  (Quickshell unavailable — bar uses simple menus)"
            fi
        fi
        
        # Apply default theme (Nord) so kitty/fuzzel/mako have sane configs
        if command -v tebian-theme &>/dev/null; then
            echo "  Applying default theme..."
            tebian-theme nord
            echo "  Default theme (Nord) applied"
        else
            # Fallback: copy base kitty.conf from repo
            mkdir -p "$HOME/.config/kitty"
            if [ -f "${TEBIAN_DIR:-$HOME/Tebian}/configs/kitty/kitty.conf" ]; then
                cp "${TEBIAN_DIR:-$HOME/Tebian}/configs/kitty/kitty.conf" "$HOME/.config/kitty/kitty.conf"
                echo "  Kitty config copied"
            fi
        fi

        # SSH server: needless attack surface on a laptop, but it may also be
        # how this machine is reached (a Pi set up headless). Never turn it
        # off under a connected session, and otherwise ask rather than assume.
        if systemctl is-active --quiet ssh.service 2>/dev/null ||
           systemctl is-active --quiet ssh.socket 2>/dev/null; then
            if pgrep -f "sshd(-session)?: [^ ]+@" >/dev/null 2>&1; then
                echo "  SSH left on: someone is connected through it right now"
            else
                read -r -p "  Turn off the SSH server? It is only needed to reach this machine remotely. [y/N] " ssh_off
                if [[ "$ssh_off" =~ ^[Yy] ]]; then
                    sudo systemctl disable --now ssh.service ssh.socket 2>/dev/null
                    echo "  SSH disabled (re-enable in Settings > Security)"
                else
                    echo "  SSH left on"
                fi
            fi
        fi

        # QT theme integration (use GTK theme for consistency)
        mkdir -p "$HOME/.config/environment.d"
        idempotent_append "QT_QPA_PLATFORMTHEME=gtk3" "$HOME/.config/environment.d/tebian-qt.conf"
        echo "  QT theme integration configured"

        # HiDPI scaling (idempotent)
        if [ "$IS_HIDPI" = true ]; then
            idempotent_append "# HiDPI scaling" "$HOME/.config/sway/config.user"
            idempotent_append "output * scale 2" "$HOME/.config/sway/config.user"
            idempotent_append "export GDK_SCALE=2" "$HOME/.profile"
            echo "  HiDPI scaling enabled (2x)"
        fi
        
        echo ""
        echo "========================================="
        echo "  Desktop Mode Ready!"
        echo "========================================="
        echo ""
        echo "Installed:"
        echo "  - Desktop essentials"
        if [ "$GPU_TYPE" = "NVIDIA" ]; then
            echo "  - NVIDIA drivers"
        fi
        if [ "$CPU_TYPE" = "Intel" ] || [ "$CPU_TYPE" = "AMD" ]; then
            echo "  - $CPU_TYPE microcode"
        fi
        if [ "$IS_LAPTOP" = true ]; then
            echo "  - Laptop power management"
        fi
        if [ "$IS_HIDPI" = true ]; then
            echo "  - HiDPI scaling"
        fi
        echo ""
        # Success sentinel — reached only if setup ran to completion. The outer
        # script gates onboarding-complete on this, so an aborted run (auth
        # failure, no network, closed window) asks again next boot.
        mkdir -p "$HOME/.config/tebian"
        touch "$HOME/.config/tebian/.desktop_setup_ok"

        echo "Press Enter to finish..."
        read
    '

    # Make bar always visible
    swaymsg 'bar mode dock' 2>/dev/null || true

    # Only mark onboarding done if the setup actually completed
    if [ -f "$HOME/.config/tebian/.desktop_setup_ok" ]; then
        echo "desktop" > "$ONBOARD_FILE"
        rm -f "$PROGRESS_FILE"
        log "Desktop setup complete"
    else
        log "Desktop setup did not complete — will resume next boot"
        notify-send "Tebian" "Desktop setup was interrupted — it'll resume on next login." 2>/dev/null || true
    fi
    
elif [[ "$CHOICE" =~ "Base" ]]; then
    log "User chose Base mode"
    echo "base" > "$ONBOARD_FILE"
    rm -f "$PROGRESS_FILE"
    notify-send "Tebian" "Base mode selected. Install what you need via fuzzel." 2>/dev/null || true
    
elif [ -z "$CHOICE" ]; then
    # Track dismissals - after 3, stop asking
    DISMISS_FILE="$HOME/.config/tebian/.onboard_dismissed"
    DISMISS_COUNT=0
    [ -f "$DISMISS_FILE" ] && DISMISS_COUNT=$(cat "$DISMISS_FILE" 2>/dev/null)
    DISMISS_COUNT=$((DISMISS_COUNT + 1))
    echo "$DISMISS_COUNT" > "$DISMISS_FILE"
    if [ "$DISMISS_COUNT" -ge 3 ]; then
        log "User dismissed 3 times, marking as base mode"
        echo "base" > "$ONBOARD_FILE"
    else
        log "User dismissed ($DISMISS_COUNT/3), will ask again next boot"
    fi
    exit 0
fi

log "Onboarding complete"
