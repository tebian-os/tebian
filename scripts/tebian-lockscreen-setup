#!/bin/bash
# Sets up gtklock config and styling for Tebian
# Called by onboarding, essentials install, and screen lock install

mkdir -p "$HOME/.config/gtklock"

# Colours from the theme in use (the header line tebian-theme copies into
# ~/.config/sway/theme names it, e.g. "# Rose Pine Theme"), so running this
# again doesn't reset the lock screen to one fixed palette. Glass, the
# default theme, when it can't be found. The accent is picked as
# tebian-theme picks it, so a later theme switch lands on the same result.
TEXT=#cdd6f4 ACCENT=#89b4fa RED=#f38ba8 YELLOW=#f9e2af
theme=$(sed -n '1s/^# \(.*\) Theme.*/\1/p' "$HOME/.config/sway/theme" 2>/dev/null |
    tr '[:upper:] ' '[:lower:]-')
theme_conf="${TEBIAN_DIR:-$HOME/Tebian}/configs/themes/${theme:-glass}/theme.conf"
if [ -f "$theme_conf" ]; then
    pick() { grep -m1 -E "^($1)=#[0-9A-Fa-f]{6}\$" "$theme_conf" | cut -d= -f2; }
    TEXT=$(pick TEXT || true); TEXT=${TEXT:-#cdd6f4}
    ACCENT=$(pick 'FROST|PURPLE|CYAN|BLUE' || true); ACCENT=${ACCENT:-$TEXT}
    RED=$(pick RED || true); RED=${RED:-#f38ba8}
    YELLOW=$(pick YELLOW || true); YELLOW=${YELLOW:-#f9e2af}
fi
# The input border is the accent, see-through: CSS wants it as r, g, b
ACCENT_RGB=$(printf '%d, %d, %d' "0x${ACCENT:1:2}" "0x${ACCENT:3:2}" "0x${ACCENT:5:2}")

# The userinfo module (avatar + name under the clock) ships as a separate
# package and gtklock's modules= wants the .so PATH, not the package name.
# Locate it, installing the package if it isn't present.
USERINFO_MODULE=$(find /usr/lib -name 'userinfo-module.so' -path '*gtklock*' 2>/dev/null | head -1)
if [ -z "$USERINFO_MODULE" ]; then
    sudo apt install -y gtklock-userinfo-module 2>/dev/null
    USERINFO_MODULE=$(find /usr/lib -name 'userinfo-module.so' -path '*gtklock*' 2>/dev/null | head -1)
fi

# Config
cat > "$HOME/.config/gtklock/config.ini" << EOF
[main]
gtk-theme=Adwaita-dark
style=$HOME/.config/gtklock/style.css
${USERINFO_MODULE:+modules=$USERINFO_MODULE}
time-format=%H:%M
date-format=%A, %B %d

[userinfo]
under-clock=true
image-size=128
round-image=true
vertical-layout=true
font-size=24
text-color=$TEXT
EOF

# CSS Style
cat > "$HOME/.config/gtklock/style.css" << EOF
window {
    background-image: url("$HOME/.local/share/backgrounds/tebian/default.jpg");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
}

#clock-label {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 120px;
    font-weight: bold;
    color: $TEXT;
    margin-bottom: 20px;
}

#date-label {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 32px;
    font-weight: bold;
    color: $TEXT;
    margin-bottom: 40px;
}

/* Hide the "Password:" label */
#input-label {
    font-size: 0px;
    min-height: 0px;
    min-width: 0px;
    margin: 0px;
    padding: 0px;
    opacity: 0;
}

/* Transparent rounded password input field */
#input-field {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba($ACCENT_RGB, 0.3);
    border-radius: 24px;
    padding: 12px 20px;
    color: $TEXT;
    caret-color: $ACCENT;
    font-family: "JetBrainsMono Nerd Font";
    font-size: 18px;
    box-shadow: none;
}

#input-field:focus {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba($ACCENT_RGB, 0.6);
    box-shadow: none;
}

/* Body grid container */
#body-grid {
    background-color: transparent;
}

#unlock-button {
    opacity: 0;
    min-height: 0px;
    min-width: 0px;
    padding: 0px;
    margin: 0px;
    border: none;
}

/* Error/warning messages */
#error-label {
    color: $RED;
    font-size: 14px;
}

#warning-label {
    color: $YELLOW;
    font-size: 14px;
}

/* User Info Module */
#user-image {
    border: 3px solid rgba(236, 239, 244, 0.6);
    margin-bottom: 10px;
}

#user-name {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 24px;
    font-weight: bold;
    color: $TEXT;
    margin-bottom: 20px;
}
EOF
