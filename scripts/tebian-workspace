#!/bin/bash
# Tebian Dynamic Workspace Manager

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
elif [ -f "$HOME/.local/bin/tebian-common" ]; then
    source "$HOME/.local/bin/tebian-common"
fi

# sway describes its workspaces as JSON; jq is how a shell script reads
# that reliably. The desktop install has it, a minimal one may not.
if ! command -v jq &>/dev/null; then
    pick=$(printf '%s\n' "Install jq" "Cancel" |
        tfuzzel -d -p " 󰎤 The workspace menu needs jq | " --lines 2 --width 45)
    [[ "$pick" == *Install* ]] || exit 0
    TERM_CMD="${TERM_CMD:-$(tebian_term_cmd)}" tebian_term_apt_install jq || {
        notify-send "Workspaces" "jq could not be installed" 2>/dev/null
        exit 1
    }
fi

# Name and focus of each workspace, sorted by number. Picked by position
# (--index): a workspace can be called anything, "New Workspace" included,
# and typed text that matches nothing is not a workspace to create by
# accident (New Workspace is there for that).
NAMES=() CURRENT=-1
while IFS=$'\t' read -r focused name; do
    [ -n "$name" ] || continue
    [ "$focused" = true ] && CURRENT=${#NAMES[@]}
    NAMES+=("$name")
done < <(swaymsg -t get_workspaces 2>/dev/null |
    jq -r '.[] | [(.focused | tostring), (.name | gsub("[\t\n]"; " "))] | @tsv' 2>/dev/null |
    sort -t$'\t' -k2,2n -k2,2)

print_entries() {
    local i
    echo "󰐊 New Workspace"
    for i in "${!NAMES[@]}"; do
        if [ "$i" = "$CURRENT" ]; then
            printf '󰎤 %s  ● current\n' "${NAMES[$i]}"
        else
            printf '󰎤 %s\n' "${NAMES[$i]}"
        fi
    done
}

PICK=$(print_entries | tfuzzel -d --index -p " 󰎤 Workspaces | ")
[[ "$PICK" =~ ^[0-9]+$ ]] && [ "$PICK" -le "${#NAMES[@]}" ] || exit 0

if [ "$PICK" -eq 0 ]; then
    WS_NAME=$(tfuzzel -d --prompt-only " 󰐊 New workspace name (e.g. 5:game): " < /dev/null)
    [ -n "$WS_NAME" ] || exit 0
    if swaymsg -- workspace "$WS_NAME" >/dev/null 2>&1; then
        notify-send "Workspaces" "On workspace $WS_NAME" 2>/dev/null
    else
        notify-send "Workspaces" "Could not open workspace $WS_NAME" 2>/dev/null
    fi
else
    swaymsg -- workspace "${NAMES[PICK - 1]}" >/dev/null
fi
