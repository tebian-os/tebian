#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"
# ==============================================================================
# TEBIAN WINDOW SWITCHER
#   tebian-windows          Super+Shift+Tab: every open window, on every
#                           workspace — type to find one, Enter to go to it
#   tebian-windows --next   Alt+Tab: the window used before this one
#   tebian-windows --prev   Alt+Shift+Tab: the same list, the other way
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
elif [ -f "$HOME/.local/bin/tebian-common" ]; then
    source "$HOME/.local/bin/tebian-common"
fi

say() {
    notify-send "Windows" "$1" 2>/dev/null || echo "$1" >&2
}

# --- Alt+Tab -------------------------------------------------------------------
# Windows in the order they were last used, so one press goes back to the
# previous window and pressing again while Alt is held walks further down
# the list. sway keeps that order itself (the "focus" lists in its tree).
#
# Walking needs the list as it was at the first press: every step focuses
# a window, which moves it to the front. sway cannot tell a script that Alt
# was let go, so the walk is told apart by time instead: a press within
# $WALK_MS of the last one continues it, a later press starts over from
# the previous window.
WALK_MS=900
cycle() {
    local step=$1 state="${XDG_RUNTIME_DIR:-/tmp}/tebian-alttab.$UID"
    local now last=0 i=0 n id tries focused
    local -a list=()

    if ! command -v jq >/dev/null 2>&1; then
        # No order to go by: sway's own next/previous window instead
        [ "$step" = 1 ] && swaymsg -q focus next || swaymsg -q focus prev
        return
    fi

    now=$(date +%s%3N)
    if [ -r "$state" ] && [ -O "$state" ]; then
        { read -r last; read -r i; read -ra list; } < "$state"
        [[ "$last" =~ ^[0-9]+$ && "$i" =~ ^[0-9]+$ ]] && [ $((now - last)) -lt "$WALK_MS" ] || list=()
    fi

    if [ "${#list[@]}" -eq 0 ]; then
        # First line: the focused window (0 on an empty workspace); second:
        # every window, most recently used first. Hidden scratchpad windows
        # (the "__i3" output) are not part of the walk.
        # shellcheck disable=SC2016
        { read -r focused; read -ra list; } < <(swaymsg -t get_tree 2>/dev/null | jq -r '
            def mru:
                if .pid != null then [.id]
                else ((.nodes // []) + (.floating_nodes // [])) as $kids
                    | [ (.focus // [])[] as $f | $kids[] | select(.id == $f) | mru ] | add // []
                end;
            del(.nodes[] | select(.name == "__i3"))
            | ([recurse(.nodes[]?, .floating_nodes[]?) | select(.focused and .pid != null) | .id][0] // 0),
              (mru | join(" "))' 2>/dev/null)
        # Standing on the first of the list, the walk starts from it; with
        # nothing focused the first press should land on it
        i=0
        [ "${list[0]:-}" = "$focused" ] || i=-1
        [ "$i" = -1 ] && [ "$step" = -1 ] && i=0
    fi

    n=${#list[@]}
    if [ "$n" -eq 0 ] || { [ "$n" -eq 1 ] && [ "$i" = 0 ]; }; then
        rm -f "$state"
        return
    fi

    # A window closed since the list was made cannot be focused: skip it
    for (( tries = 0; tries < n; tries++ )); do
        i=$(( (i + step + n) % n ))
        id=${list[$i]}
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        show "$id" && break
    done
    printf '%s\n%s\n%s\n' "$(date +%s%3N)" "$i" "${list[*]}" > "$state"
}

# show ID — focus a window and make sure it is the one on screen
show() {
    swaymsg -q "[con_id=$1] focus" 2>/dev/null || return 1
    # A full-screen window keeps the screen and the focus of its workspace.
    # Alt+Tab away from a full-screen video has to work, so it steps down.
    if [ "$(swaymsg -t get_tree | jq -r 'first(recurse(.nodes[]?, .floating_nodes[]?) | select(.focused) | .id) // 0')" != "$1" ]; then
        swaymsg -q "fullscreen disable; [con_id=$1] focus" 2>/dev/null
    fi
    return 0
}

case "${1:-}" in
    --next) cycle 1;  exit 0 ;;
    --prev) cycle -1; exit 0 ;;
esac

# sway describes its windows as JSON; jq is how a shell script reads that
# reliably. The desktop install has it, a minimal one may not.
if ! command -v jq >/dev/null 2>&1; then
    pick=$(printf '%s\n' "Install jq" "Cancel" |
        tfuzzel -d -p " 󰖲 The window switcher needs jq | " --lines 2 --width 45)
    [[ "$pick" == *Install* ]] || exit 0
    TERM_CMD="${TERM_CMD:-$(tebian_term_cmd)}" tebian_term_apt_install jq || {
        say "jq could not be installed"
        exit 1
    }
fi

TREE=$(swaymsg -t get_tree 2>/dev/null) || { say "Can't reach sway to list windows."; exit 1; }

# One line per window: con_id, workspace, app, title. Windows are the
# nodes with a pid (split containers have none); floating ones live in
# floating_nodes. \037 between fields, since an X11 window can have no
# app_id and `read` would merge two tabs around the gap. Scratchpad
# windows sit on sway's hidden "__i3_scratch" workspace.
# shellcheck disable=SC2016
WINDOWS=$(jq -r '
    [ recurse(.nodes[]?, .floating_nodes[]?)
      | select(.type == "workspace") | .name as $ws
      | recurse(.nodes[]?, .floating_nodes[]?)
      | select((.type == "con" or .type == "floating_con") and .pid != null)
      | [(.id | tostring), $ws,
         (.app_id // .window_properties.class // .window_properties.instance // ""),
         (.name // "")] ]
    # Hidden scratchpad windows after the visible ones (sort_by is stable)
    | sort_by(.[1] == "__i3_scratch") | .[]
    | map(gsub("[\t\n\r\u001f]"; " ")) | join("\u001f")
' <<< "$TREE" 2>/dev/null)

if [ -z "$WINDOWS" ]; then
    say "No open windows."
    exit 0
fi

IDS=() WS=() APP=() TITLE=()
while IFS=$'\037' read -r id ws app title; do
    [[ "$id" =~ ^[0-9]+$ ]] || continue
    IDS+=("$id"); WS+=("$ws"); APP+=("$app"); TITLE+=("$title")
done <<< "$WINDOWS"

# Label: app — title, then where it is. The app_id doubles as the icon
# name, which is right for most apps; fuzzel leaves the slot empty when
# no icon has that name. Printed straight into the pipe: the icon
# separator is a NUL, which bash variables drop (see tfuzzel).
print_entries() {
    local i label where
    for i in "${!IDS[@]}"; do
        label="${APP[$i]:-window}"
        [ -n "${TITLE[$i]}" ] && [ "${TITLE[$i]}" != "${APP[$i]}" ] && label+=" — ${TITLE[$i]}"
        where="workspace ${WS[$i]}"
        [ "${WS[$i]}" = "__i3_scratch" ] && where="scratchpad"
        if [ -n "${APP[$i]}" ]; then
            printf '%s   (%s)\0icon\x1f%s\n' "$label" "$where" "${APP[$i]}"
        else
            printf '%s   (%s)\n' "$label" "$where"
        fi
    done
}

# By position (--index): titles are arbitrary text, two windows can share
# one, and only the con_id says which window was meant
# Sized to the list: at the themes' fixed 15 lines, two windows left a tall
# empty box that fuzzel filled with a huge copy of the selected icon
LINES_N=${#IDS[@]}
[ "$LINES_N" -gt 15 ] && LINES_N=15
PICK=$(print_entries | tfuzzel -d --index -p " 󰖲 Windows | " --width 60 --lines "$LINES_N")
[[ "$PICK" =~ ^[0-9]+$ ]] && [ "$PICK" -lt "${#IDS[@]}" ] || exit 0

if [ "${WS[$PICK]}" = "__i3_scratch" ]; then
    # A hidden scratchpad window has to be shown; focus alone does nothing
    swaymsg "[con_id=${IDS[$PICK]}] scratchpad show" >/dev/null
else
    swaymsg "[con_id=${IDS[$PICK]}] focus" >/dev/null
fi
