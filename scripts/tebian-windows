#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"
# ==============================================================================
# TEBIAN WINDOW SWITCHER (Super+Shift+Tab)
# Every open window, on every workspace: type to find one, Enter to go to it.
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/tebian-common" ]; then
    source "$SCRIPT_DIR/tebian-common"
elif [ -f "$HOME/.local/bin/tebian-common" ]; then
    source "$HOME/.local/bin/tebian-common"
fi

say() {
    notify-send "Windows" "$1" 2>/dev/null || echo "$1" >&2
}

# sway describes its windows as JSON; jq is how a shell script reads that
# reliably. The desktop install has it, a minimal one may not.
if ! command -v jq >/dev/null 2>&1; then
    pick=$(printf '%s\n' "Install jq" "Cancel" |
        tfuzzel -d -p " 󰖲 The window switcher needs jq | " --lines 2 --width 45)
    [[ "$pick" == *Install* ]] || exit 0
    TERM_CMD="${TERM_CMD:-$(tebian_term_cmd)}" tebian_term_apt_install jq || {
        say "jq could not be installed"
        exit 1
    }
fi

TREE=$(swaymsg -t get_tree 2>/dev/null) || { say "Can't reach sway to list windows."; exit 1; }

# One line per window: con_id, workspace, app, title. Windows are the
# nodes with a pid (split containers have none); floating ones live in
# floating_nodes. \037 between fields, since an X11 window can have no
# app_id and `read` would merge two tabs around the gap. Scratchpad
# windows sit on sway's hidden "__i3_scratch" workspace.
# shellcheck disable=SC2016
WINDOWS=$(jq -r '
    [ recurse(.nodes[]?, .floating_nodes[]?)
      | select(.type == "workspace") | .name as $ws
      | recurse(.nodes[]?, .floating_nodes[]?)
      | select((.type == "con" or .type == "floating_con") and .pid != null)
      | [(.id | tostring), $ws,
         (.app_id // .window_properties.class // .window_properties.instance // ""),
         (.name // "")] ]
    # Hidden scratchpad windows after the visible ones (sort_by is stable)
    | sort_by(.[1] == "__i3_scratch") | .[]
    | map(gsub("[\t\n\r\u001f]"; " ")) | join("\u001f")
' <<< "$TREE" 2>/dev/null)

if [ -z "$WINDOWS" ]; then
    say "No open windows."
    exit 0
fi

IDS=() WS=() APP=() TITLE=()
while IFS=$'\037' read -r id ws app title; do
    [[ "$id" =~ ^[0-9]+$ ]] || continue
    IDS+=("$id"); WS+=("$ws"); APP+=("$app"); TITLE+=("$title")
done <<< "$WINDOWS"

# Label: app — title, then where it is. The app_id doubles as the icon
# name, which is right for most apps; fuzzel leaves the slot empty when
# no icon has that name. Printed straight into the pipe: the icon
# separator is a NUL, which bash variables drop (see tfuzzel).
print_entries() {
    local i label where
    for i in "${!IDS[@]}"; do
        label="${APP[$i]:-window}"
        [ -n "${TITLE[$i]}" ] && [ "${TITLE[$i]}" != "${APP[$i]}" ] && label+=" — ${TITLE[$i]}"
        where="workspace ${WS[$i]}"
        [ "${WS[$i]}" = "__i3_scratch" ] && where="scratchpad"
        if [ -n "${APP[$i]}" ]; then
            printf '%s   (%s)\0icon\x1f%s\n' "$label" "$where" "${APP[$i]}"
        else
            printf '%s   (%s)\n' "$label" "$where"
        fi
    done
}

# By position (--index): titles are arbitrary text, two windows can share
# one, and only the con_id says which window was meant
# Sized to the list: at the themes' fixed 15 lines, two windows left a tall
# empty box that fuzzel filled with a huge copy of the selected icon
LINES_N=${#IDS[@]}
[ "$LINES_N" -gt 15 ] && LINES_N=15
PICK=$(print_entries | tfuzzel -d --index -p " 󰖲 Windows | " --width 60 --lines "$LINES_N")
[[ "$PICK" =~ ^[0-9]+$ ]] && [ "$PICK" -lt "${#IDS[@]}" ] || exit 0

if [ "${WS[$PICK]}" = "__i3_scratch" ]; then
    # A hidden scratchpad window has to be shown; focus alone does nothing
    swaymsg "[con_id=${IDS[$PICK]}] scratchpad show" >/dev/null
else
    swaymsg "[con_id=${IDS[$PICK]}] focus" >/dev/null
fi
