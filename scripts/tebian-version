#!/bin/bash
# ==============================================================================
# TEBIAN VERSION CHECK (V1.0)
# Prints the current Tebian version; --check compares the installed
# scripts with ~/Tebian (tebian-update is what syncs them)
# ==============================================================================

TEBIAN_DIR="${TEBIAN_DIR:-$HOME/Tebian}"
VERSION_FILE="$TEBIAN_DIR/VERSION"

get_version() {
    if [ -f "$VERSION_FILE" ]; then
        cat "$VERSION_FILE"
    else
        echo "unknown"
    fi
}

check_scripts() {
    local outdated=0
    local local_scripts=("tebian-menu" "tebian-settings" "tebian-theme" "tebian-onboard" "status.sh" "update-all")
    
    echo "Checking for script updates..."
    
    for script in "${local_scripts[@]}"; do
        local_file="$HOME/.local/bin/$script"
        source_file="$TEBIAN_DIR/scripts/$script"
        
        if [ -f "$source_file" ] && [ -f "$local_file" ]; then
            if ! diff -q "$source_file" "$local_file" > /dev/null 2>&1; then
                echo "  ⚠️  $script is outdated"
                outdated=1
            fi
        fi
    done
    
    if [ $outdated -eq 1 ]; then
        echo ""
        # Not a plain copy: that would put installer-only scripts on PATH and
        # overwrite scripts while they run
        echo "Run: tebian-update"
        return 1
    else
        echo "  ✅ All scripts up to date"
        return 0
    fi
}

case "${1:-}" in
    --check|-c)
        check_scripts
        ;;
    --json)
        echo "{\"version\": \"$(get_version)\", \"path\": \"$TEBIAN_DIR\"}"
        ;;
    *)
        echo "Tebian $(get_version)"
        echo "Path: $TEBIAN_DIR"
        ;;
esac
