// Tebian Plymouth Boot Theme
// Dark background, the Tebian wordmark with a soft white glow that slowly
// breathes — the breathing is the sign that the machine is working

// Background
Window.SetBackgroundTopColor(0.12, 0.12, 0.18);    // #1e1e2e
Window.SetBackgroundBottomColor(0.07, 0.07, 0.11);  // #11111b

// Screen dimensions
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

// Title: the wordmark from tebian.org as two pictures of the same size
// (build/splash-art.py draws them) — the letters, and under them a white
// halo. The pictures are wider than the letters, to leave the halo room:
// title_part is the letters' share of the width (1200 of 1480 px).
// The letters take 2/5 of the screen's width, within sane limits.
title_part = 1200 / 1480;
title_width = screen_width * 0.4;
if (title_width > 760) title_width = 760;
if (title_width < 280) title_width = 280;
title_full = Image("title.png");
art_width = Math.Int(title_width / title_part);
art_height = Math.Int(art_width * title_full.GetHeight() / title_full.GetWidth());
title_image = title_full.Scale(art_width, art_height);
glow_image = Image("glow.png").Scale(art_width, art_height);
// The letters' middle sits a little above the screen's, as the text did
art_x = screen_width / 2 - art_width / 2;
art_y = screen_height / 2 - 30 - art_height / 2;

glow_sprite = Sprite(glow_image);
glow_sprite.SetPosition(art_x, art_y, 1);
title_sprite = Sprite(title_image);
title_sprite.SetPosition(art_x, art_y, 2);

// Animation counter (the halo is the only thing that moves)
counter = 0;

fun refresh_callback() {
    counter++;
    // The halo breathes: one slow rise and fall about every four seconds
    // (this runs 50 times a second), never fully out
    glow_sprite.SetOpacity(0.72 + 0.28 * Math.Sin(counter / 32));
}

Plymouth.SetRefreshFunction(refresh_callback);

// Password prompt (LUKS unlock). The sprites must live at the top level:
// Plymouth script frees a function's local variables when it returns, so
// a Sprite() created inside the callback vanished at once and the prompt
// was never visible — encrypted installs showed only the spinner.
prompt_sprite = Sprite();
bullet_sprite = Sprite();
prompt_sprite.SetZ(10);
bullet_sprite.SetZ(10);

fun display_password_callback(prompt, bullets) {
    prompt_image = Image.Text(prompt, 0.80, 0.84, 0.96, 1, "Sans 16");  // #cdd6f4
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX(screen_width / 2 - prompt_image.GetWidth() / 2);
    prompt_sprite.SetY(screen_height / 2 + 70);
    prompt_sprite.SetOpacity(1);

    // A placeholder bar before the first keypress, so it reads as a field
    if (bullets == 0)
        bullet_str = "_";
    else {
        bullet_str = "";
        for (i = 0; i < bullets && i < 32; i++)
            bullet_str += "● ";
    }
    bullet_image = Image.Text(bullet_str, 0.54, 0.71, 0.98, 1, "Sans 18");  // #89b4fa
    bullet_sprite.SetImage(bullet_image);
    bullet_sprite.SetX(screen_width / 2 - bullet_image.GetWidth() / 2);
    bullet_sprite.SetY(screen_height / 2 + 105);
    bullet_sprite.SetOpacity(1);
}

// Back to the plain splash once the passphrase is accepted
fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    bullet_sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// Hide messages/details
fun message_callback(text) {
    // Suppress boot messages for clean look
}

Plymouth.SetMessageFunction(message_callback);
